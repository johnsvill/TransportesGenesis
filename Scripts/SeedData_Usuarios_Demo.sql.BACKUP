GO

-- =============================================
-- VERIFICACIÓN FINAL
-- =============================================

PRINT ''
PRINT '========================================='
PRINT '📋 RESUMEN DE USUARIOS DE DEMOSTRACIÓN'
PRINT '========================================='
PRINT ''

SELECT 
	u.Email AS 'Usuario',
	r.Name AS 'Rol',
	CASE WHEN u.EmailConfirmed = 1 THEN '✅ Confirmado' ELSE '❌ No confirmado' END AS 'Estado Email',
	CASE WHEN u.LockoutEnabled = 1 THEN '🔓 Activo' ELSE '🔒 Bloqueado' END AS 'Estado Cuenta'
FROM AspNetUsers u
INNER JOIN AspNetUserRoles ur ON u.Id = ur.UserId
INNER JOIN AspNetRoles r ON ur.RoleId = r.Id
WHERE u.Email IN (
	'admin@genesis.com',
	'piloto@genesis.com', 
	'monitor@genesis.com',
	'padre@genesis.com'
)
ORDER BY 
	CASE r.Name
		WHEN 'Administrador' THEN 1
		WHEN 'Piloto' THEN 2
		WHEN 'Monitor' THEN 3
		WHEN 'PadreDeFamilia' THEN 4
	END

PRINT ''
PRINT '========================================='
PRINT '🔑 CREDENCIALES PARA LOGIN'
PRINT '========================================='
PRINT ''
PRINT '👤 ADMINISTRADOR:'
PRINT '   Email: admin@genesis.com'
PRINT '   Contraseña: Admin123!'
PRINT ''
PRINT '🚗 PILOTO:'
PRINT '   Email: piloto@genesis.com'
PRINT '   Contraseña: Piloto123!'
PRINT ''
PRINT '👨‍🏫 MONITOR:'
PRINT '   Email: monitor@genesis.com'
PRINT '   Contraseña: Monitor123!'
PRINT ''
PRINT '👨‍👩‍👧 PADRE DE FAMILIA:'
PRINT '   Email: padre@genesis.com'
PRINT '   Contraseña: Padre123!'
PRINT ''
PRINT '========================================='
PRINT '✅ Script ejecutado exitosamente'
PRINT '========================================='
