-- =============================================
-- Script: Crear Usuarios de Demostración
-- Propósito: Usuarios para demo del martes
-- Fecha: Enero 2025
-- =============================================

USE [TransportesGenesis]
GO

-- =============================================
-- IMPORTANTE: Ejecutar este script en orden
-- =============================================

-- Variables para IDs
DECLARE @AdminRoleId NVARCHAR(450)
DECLARE @PilotoRoleId NVARCHAR(450)
DECLARE @MonitorRoleId NVARCHAR(450)
DECLARE @PadreRoleId NVARCHAR(450)

-- Obtener IDs de roles
SELECT @AdminRoleId = Id FROM AspNetRoles WHERE Name = 'Administrador'
SELECT @PilotoRoleId = Id FROM AspNetRoles WHERE Name = 'Piloto'
SELECT @MonitorRoleId = Id FROM AspNetRoles WHERE Name = 'Monitor'
SELECT @PadreRoleId = Id FROM AspNetRoles WHERE Name = 'PadreDeFamilia'

-- =============================================
-- 1. USUARIO ADMINISTRADOR
-- Usuario: admin@genesis.com
-- Contraseña: Admin123!
-- =============================================

IF NOT EXISTS (SELECT 1 FROM AspNetUsers WHERE Email = 'admin@genesis.com')
BEGIN
	INSERT INTO AspNetUsers (
		Id, UserName, NormalizedUserName, Email, NormalizedEmail, 
		EmailConfirmed, PasswordHash, SecurityStamp, ConcurrencyStamp,
		PhoneNumberConfirmed, TwoFactorEnabled, LockoutEnabled, AccessFailedCount
	)
	VALUES (
		NEWID(),
		'admin@genesis.com',
		'ADMIN@GENESIS.COM',
		'admin@genesis.com',
		'ADMIN@GENESIS.COM',
		1,
		'AQAAAAIAAYagAAAAEH8VQ6E7xZ5qK+3xLJxJDzF4qZxJy7f5kK8pL3mN9oQ1rS2tU3vW4xY5z6A7b8C9d0E=', -- Hash de Admin123!
		NEWID(),
		NEWID(),
		0,
		0,
		1,
		0
	)

	DECLARE @AdminUserId NVARCHAR(450) = (SELECT Id FROM AspNetUsers WHERE Email = 'admin@genesis.com')

	-- Asignar rol
	INSERT INTO AspNetUserRoles (UserId, RoleId)
	VALUES (@AdminUserId, @AdminRoleId)

	PRINT '✅ Usuario Administrador creado: admin@genesis.com'
END
ELSE
BEGIN
	PRINT '⚠️ Usuario admin@genesis.com ya existe'
END

