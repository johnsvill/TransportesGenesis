		1,
		0
	)

	DECLARE @PadreUserId NVARCHAR(450) = (SELECT Id FROM AspNetUsers WHERE Email = 'padre@genesis.com')

	-- Asignar rol
	INSERT INTO AspNetUserRoles (UserId, RoleId)
	VALUES (@PadreUserId, @PadreRoleId)

