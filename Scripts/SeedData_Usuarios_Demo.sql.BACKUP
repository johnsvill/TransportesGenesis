		1,
		'AQAAAAIAAYagAAAAEW6xX7yY8zZ9aA0bB1cC2dD3eE4fF5gG6hH7iI8jJ9kK0lL1mM2nN3oO4pP5qQ6r=', -- Hash de Padre123!
		NEWID(),
		NEWID(),
		0,
