@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="container mt-4">
    <h2 class="text-primary">¿Olvidaste tu contraseña?</h2>
    <form method="post">
        <div class="form-group">
            <label asp-for="Input.Email">Correo electrónico</label>
            <input asp-for="Input.Email" class="form-control" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-warning">Enviar instrucciones</button>
    </form>
</div>
