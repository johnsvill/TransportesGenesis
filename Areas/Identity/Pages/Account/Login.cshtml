@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="container mt-4">
    <h2 class="text-primary">Iniciar sesión</h2>
    <form method="post">
        <div class="form-group">
            <label asp-for="Input.Email">Correo electrónico</label>
            <input asp-for="Input.Email" class="form-control" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Input.Password">Contraseña</label>
            <input asp-for="Input.Password" class="form-control" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        <div class="form-check">
            <input asp-for="Input.RememberMe" class="form-check-input" />
            <label asp-for="Input.RememberMe" class="form-check-label">Recordarme</label>
        </div>
        <button type="submit" class="btn btn-warning">Iniciar sesión</button>
    </form>
    <p class="mt-3">
        <a asp-page="./ForgotPassword">¿Olvidaste tu contraseña?</a>
    </p>
</div>
