        // Animar bus en la simulación con movimiento suave
        function animarBusSimulacion() {
            let indicePunto = 0;
            const velocidad = 800; // milisegundos entre puntos (más rápido para más fluidez)

            function moverSiguientePunto() {
                if (!simulacionPilotoActiva || indicePunto >= rutaSimulacionPiloto.length) {
                    finalizarSimulacion();
                    return;
                }

                const puntoActual = rutaSimulacionPiloto[indicePunto];

                // Mover bus al punto actual con transición suave
                marcadorBusSimulacion.setLatLng(puntoActual.coordenadas);

                // Centrar mapa en el bus con transición suave
                mapa.panTo(puntoActual.coordenadas, {
                    animate: true,
                    duration: 0.5
                });

                // Actualizar estado de movimiento
                const progreso = Math.floor((indicePunto / rutaSimulacionPiloto.length) * 100);
                document.getElementById('estadoSimulacionPiloto').innerHTML = 
                    `🚌 Bus en movimiento - Progreso: ${progreso}%`;

                // Verificar si es una parada
                if (puntoActual.esParada) {
                    reproducirSonidoParada();
                    mostrarAlertaParada(puntoActual);

                    // [FASE 0.4] Notificar al servidor y padres vía SignalR
                    if (puntoActual.idParada) {
                        completarParadaEnServidor(puntoActual.idParada);
                    }

                    document.getElementById('estadoSimulacionPiloto').innerHTML =
                        `🚏 Llegando a: ${puntoActual.nombreParada}`;

                    // Mostrar popup del bus
                    marcadorBusSimulacion.setPopupContent(`
                        <div style="min-width: 200px;">
                            <h6 class="mb-2"><strong>🚌 ${datosSimulacionPiloto.bus}</strong></h6>
                            <div class="mb-1"><strong>Parada:</strong> ${puntoActual.nombreParada}</div>
                            <div class="mb-1"><strong>Progreso:</strong> ${puntoActual.orden}/${datosSimulacionPiloto.paradas.length}</div>
                            <div class="mb-1"><span class="badge bg-warning">Detenido en parada</span></div>
                        </div>
                    `).openPopup();

                    // Tiempo extra en paradas (3 segundos)
                    setTimeout(() => {
                        indicePunto++;
                        setTimeout(moverSiguientePunto, velocidad + 2000); // +2 segundos en paradas
                    }, 1000);
                } else {
                    // Punto intermedio - movimiento normal
                    indicePunto++;
                    setTimeout(moverSiguientePunto, velocidad);
                }
            }

            moverSiguientePunto();
        }

        // Reproducir sonido de inicio
        function reproducirSonidoInicio() {
            reproducirSonido([440, 554, 659], [0.2, 0.2, 0.4]); // Acorde C-E-E mayor
        }

        // Reproducir sonido de alerta en parada
        function reproducirSonidoParada() {
            // Sonido de alerta más llamativo para el piloto
            reproducirSonido([880, 880, 1100], [0.3, 0.1, 0.4]); // Sonido de alerta agudo
        }

        // Función base para reproducir sonidos
        function reproducirSonido(frecuencias, duraciones) {
            if (!audioContext) return;

            let tiempoInicio = audioContext.currentTime;

            frecuencias.forEach((freq, index) => {
                const oscilador = audioContext.createOscillator();
                const ganancia = audioContext.createGain();

                oscilador.connect(ganancia);
                ganancia.connect(audioContext.destination);

                oscilador.frequency.setValueAtTime(freq, tiempoInicio);
                oscilador.type = 'sine';

                ganancia.gain.setValueAtTime(0, tiempoInicio);
                ganancia.gain.linearRampToValueAtTime(0.3, tiempoInicio + 0.01);
                ganancia.gain.exponentialRampToValueAtTime(0.001, tiempoInicio + duraciones[index]);

                oscilador.start(tiempoInicio);
                oscilador.stop(tiempoInicio + duraciones[index]);

                tiempoInicio += duraciones[index] + 0.1;
            });
        }

        // Mostrar alerta visual de parada
        function mostrarAlertaParada(punto) {
            const indicator = document.getElementById('audioIndicator');
            const mensaje = document.getElementById('mensajeAudio');

            mensaje.innerHTML = `<strong>${punto.nombreParada}</strong><br>
