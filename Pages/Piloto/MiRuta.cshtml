        // Función principal para simular la ruta del piloto
        function simularRutaPiloto() {
            if (simulacionPilotoActiva) {
                detenerSimulacionPiloto();
                return;
            }

            const btn = document.getElementById('btnSimularRutaPiloto');
            const estado = document.getElementById('estadoSimulacionPiloto');
            const tiempo = document.getElementById('tiempoSimulacion');

            // Cambiar estado del botón
            btn.innerHTML = '<i class="bi bi-stop-circle-fill me-2"></i>Detener Simulación';
