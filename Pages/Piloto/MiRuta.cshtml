        // Detener simulación del piloto
        function detenerSimulacionPiloto() {
            simulacionPilotoActiva = false;

            const btn = document.getElementById('btnSimularRutaPiloto');
            const estado = document.getElementById('estadoSimulacionPiloto');
            const tiempo = document.getElementById('tiempoSimulacion');

            // Restaurar botón
            btn.innerHTML = '<i class="bi bi-play-circle-fill me-2"></i>Simular Ruta';
            btn.className = 'btn btn-primary btn-lg w-100';
            estado.textContent = 'Reproduce la animación del bus con sonidos de alerta al llegar a cada parada';
            tiempo.textContent = 'Duración estimada: 5-8 minutos';

            // Remover bus de simulación
            if (marcadorBusSimulacion) {
                mapa.removeLayer(marcadorBusSimulacion);
                marcadorBusSimulacion = null;
            }

            // Remover línea de ruta
            if (rutaPolyline) {
                mapa.removeLayer(rutaPolyline);
                rutaPolyline = null;
            }

            // Limpiar marcadores de simulación
            marcadores.forEach(marker => {
                if (mapa.hasLayer(marker)) {
                    mapa.removeLayer(marker);
                }
            });
            marcadores = [];

            // Ocultar indicador de audio
            document.getElementById('audioIndicator').classList.remove('show');

            // Restaurar vista original
            if (rutaData && rutaData.paradas) {
                mostrarRutaEnMapa();
            } else {
                if (marcadorUsuario) {
                    mapa.setView(marcadorUsuario.getLatLng(), 15);
                } else {
                    mapa.setView([14.6349, -90.5069], 12);
                }
            }
        }
    </script>
    <!-- SignalR: cargado desde _Layout.cshtml (lib/signalr/signalr.min.js + js/signalr-client.js) -->
    <script>
        // Conectar cliente SignalR en vista piloto para recibir notificaciones y reportar ubicaciones
        document.addEventListener('DOMContentLoaded', async () => {
            try {
                window.pilotoNot = new NotificacionesCliente();
                await window.pilotoNot.conectar();

                // Unirse al grupo del bus si IdBus disponible
                const idBus = @(Model.IdBus.HasValue ? Model.IdBus.Value.ToString() : "null");
                if (idBus !== null) {
                    await window.pilotoNot.unirseAGrupo(`Bus_${idBus}`);
                }

                // Escuchar alertas
                window.pilotoNot.onAlerta((data) => {
                    console.log('Piloto recibió alerta:', data);
                    const cont = document.createElement('div');
                    cont.className = 'alert alert-info position-fixed';
                    cont.style.cssText = 'top: 20px; right: 20px; z-index: 1050; min-width: 260px;';
                    cont.innerHTML = `<strong>🔔</strong> ${data.mensaje || data.Mensaje || 'Alerta'} <button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
                    document.body.appendChild(cont);
                    setTimeout(()=>{ if (cont.parentNode) cont.remove(); }, 6000);
                });

                // [EN VIVO] Canal principal: POST /api/ubicaciones (+ cola offline si falla la red)
                function actualizarBadgeColaOffline(n) {
                    const badge = document.getElementById('badgeColaOffline');
                    const texto = document.getElementById('textoColaOffline');
                    if (!badge || !texto) return;
                    if (window.UbicacionOfflineQueue?.isFlushing?.()) {
                        badge.classList.remove('d-none');
                        badge.className = 'badge bg-info text-dark';
                        texto.innerHTML = 'Sincronizando…';
                        return;
                    }
                    if (n > 0 || !navigator.onLine) {
                        badge.classList.remove('d-none');
                        badge.className = 'badge bg-warning text-dark';
                        texto.innerHTML = !navigator.onLine
                            ? `Sin conexión – cola (${n})`
                            : `Puntos en cola (${n})`;
                    } else {
                        badge.classList.add('d-none');
                    }
                }

                if (window.UbicacionOfflineQueue) {
                    window.UbicacionOfflineQueue.onChange(actualizarBadgeColaOffline);
                    actualizarBadgeColaOffline(window.UbicacionOfflineQueue.size());
                    window.addEventListener('online', () => {
                        actualizarBadgeColaOffline(window.UbicacionOfflineQueue.size());
                        window.UbicacionOfflineQueue.flush();
                    });
                    window.addEventListener('offline', () => actualizarBadgeColaOffline(window.UbicacionOfflineQueue.size()));
                }

                setInterval(() => {
                    try {
                        if (typeof simulacionPilotoActiva !== 'undefined' && simulacionPilotoActiva && typeof marcadorBusSimulacion !== 'undefined' && marcadorBusSimulacion) {
                            const latlng = marcadorBusSimulacion.getLatLng();
                            if (idBus !== null) {
                                const point = { idBus: parseInt(idBus), latitud: latlng.lat, longitud: latlng.lng, velocidad: 10.0, direccion: 0 };
                                if (window.UbicacionOfflineQueue) {
                                    window.UbicacionOfflineQueue.enviarUbicacion(point, {
                                        onHubFallback: (p) => {
                                            try {
                                                if (window.pilotoNot?.reportarUbicacionBus)
                                                    window.pilotoNot.reportarUbicacionBus(p.idBus, p.latitud, p.longitud);
                                            } catch (e) { console.warn('[Piloto] Fallback hub falló:', e); }
                                        }
                                    });
                                } else {
                                    fetch('/api/ubicaciones', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify(point)
                                    }).then(r => {
                                        if (!r.ok) throw new Error('API ' + r.status);
                                    }).catch(() => {
                                        try {
                                            if (window.pilotoNot?.reportarUbicacionBus)
                                                window.pilotoNot.reportarUbicacionBus(parseInt(idBus), latlng.lat, latlng.lng);
                                        } catch (e) { console.warn('[Piloto] Fallback hub falló:', e); }
                                    });
                                }
                            }
                        }
                    } catch (e) { console.warn('Error reporter ubicación:', e); }
                }, 2000);

            } catch (e) {
                console.warn('SignalR piloto no disponible', e);
            }
        });
    </script>
