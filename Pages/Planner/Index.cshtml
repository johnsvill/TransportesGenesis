                            <div class="progress-bar bg-success" style="width: 100%">100% Completado</div>
                        </div>
                        <small class="text-muted mt-2 d-block">
                            <i class="bi bi-check-circle-fill text-success"></i> ✅ Sprint completado exitosamente
                        </small>
                    </div>
                </div>
            </div>
        </div>
