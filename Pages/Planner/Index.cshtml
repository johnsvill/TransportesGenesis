                        <h2 class="text-success">6</h2>
                        <p class="text-muted">Sprints Completados</p>
                    </div>
                    <div class="col-md-3 text-center">
                        <h2 class="text-warning">1</h2>
                        <p class="text-muted">Sprints En Progreso</p>
                    </div>
                    <div class="col-md-3 text-center">
                        <h2 class="text-secondary">1</h2>
                        <p class="text-muted">Sprints Pendientes</p>
                    </div>
                    <div class="col-md-3 text-center">
