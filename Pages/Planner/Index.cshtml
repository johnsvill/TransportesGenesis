            </div>
            <div class="col-md-4 text-end">
                <h3><i class="bi bi-calendar-check"></i> Sprint Actual: 6</h3>
                <p class="mb-0">Semana del 18 al 24 de Mayo, 2026</p>
            </div>
        </div>
    </div>

