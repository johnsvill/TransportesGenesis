@page
@model TransportesGenesis.Pages.Admin.GestionarAsignacionesModel
@{
    ViewData["Title"] = "Gestionar Asignaciones";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">
            <i class="bi bi-sliders"></i> Gestionar Asignaciones Personal-Bus
        </h2>
        <div>
            <a href="/Admin/ReporteAsignaciones" class="btn btn-info me-2">
                <i class="bi bi-file-earmark-text"></i> Ver Reporte
            </a>
            <a href="/Admin/Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert alert-@Model.TipoMensaje alert-dismissible fade show" role="alert">
            @Model.Mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- DEBUG INFO (remover en producción) -->
    <div class="alert alert-info">
        <strong>📊 DEBUG INFO:</strong><br/>
        Pilotos sin asignar: <strong>@Model.Pilotos.Count</strong> |
        Monitores sin asignar: <strong>@Model.Monitores.Count</strong> |
        Buses sin asignar: <strong>@Model.BusesDisponibles.Count</strong> |
        Asignaciones activas: <strong>@Model.AsignacionesActivas.Count</strong>
    </div>

    <!-- Formulario para crear nueva asignación -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-plus-circle"></i> Nueva Asignación
            </h5>
        </div>
        <div class="card-body">
            <form method="post">
                @Html.AntiForgeryToken()
                <div class="row">
                    <div class="col-md-5">
                        <label for="IdUsuario" class="form-label">Seleccionar Personal:</label>
                        <select class="form-select" name="IdUsuario" id="IdUsuario" required>
                            <option value="">-- Seleccione --</option>
                            @if (Model.Pilotos.Any())
                            {
                                <optgroup label="Pilotos">
                                    @foreach (var piloto in Model.Pilotos)
                                    {
                                        <option value="@piloto.Id">
                                            👨‍✈️ @piloto.UserName (@piloto.Email)
                                        </option>
                                    }
                                </optgroup>
                            }
                            @if (Model.Monitores.Any())
                            {
                                <optgroup label="Monitores">
                                    @foreach (var monitor in Model.Monitores)
                                    {
                                        <option value="@monitor.Id">
                                            👨‍🏫 @monitor.UserName (@monitor.Email)
                                        </option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>

                    <div class="col-md-5">
                        <label for="IdBus" class="form-label">Seleccionar Bus:</label>
                        <select class="form-select" name="IdBus" id="IdBus" required>
                            <option value="0">-- Seleccione --</option>
                            @foreach (var bus in Model.BusesDisponibles)
                            {
                                <option value="@bus.IdBus">
                                    🚌 @bus.Placa - @bus.Modelo (Capacidad: @bus.Capacidad)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-check-circle"></i> Asignar
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Listado de asignaciones activas -->
    <div class="card">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">
                <i class="bi bi-list-check"></i> Asignaciones Activas (@Model.AsignacionesActivas.Count)
            </h5>
        </div>
        <div class="card-body">
            @if (!Model.AsignacionesActivas.Any())
            {
                <div class="alert alert-info" role="alert">
                    <i class="bi bi-info-circle"></i> No hay asignaciones activas en este momento.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Usuario</th>
                                <th>Bus</th>
                                <th>Fecha Asignación</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var asignacion in Model.AsignacionesActivas)
                            {
                                var usuario = Model.TodosLosUsuarios.FirstOrDefault(u => u.Id == asignacion.IdUsuarioPiloto);

                                <tr>
                                    <td>@asignacion.IdAsignacion</td>
                                    <td>
                                        <strong>@(usuario?.UserName ?? "Usuario desconocido")</strong><br />
                                        <small class="text-muted">@(usuario?.Email ?? "")</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-bus-front"></i> @asignacion.Bus?.Placa
                                        </span>
                                    </td>
                                    <td>@asignacion.FechaAsignacion.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <form method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="action" value="finalizar" />
                                            <input type="hidden" name="idAsignacion" value="@asignacion.IdAsignacion" />
                                            <button type="submit" class="btn btn-sm btn-danger" 
                                                    onclick="return confirm('¿Está seguro de finalizar esta asignación?')">
                                                <i class="bi bi-x-circle"></i> Finalizar
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Información adicional -->
    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-primary">@Model.Pilotos.Count</h3>
                    <p class="text-muted">Pilotos Sin Asignar</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-info">@Model.Monitores.Count</h3>
                    <p class="text-muted">Monitores Sin Asignar</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-warning">@Model.BusesDisponibles.Count</h3>
                    <p class="text-muted">Buses Sin Asignar</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-cerrar alertas después de 5 segundos
        setTimeout(function() {
            var alert = document.querySelector('.alert');
            if (alert) {
                var bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            }
        }, 5000);
    </script>
}
