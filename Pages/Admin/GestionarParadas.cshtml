@page
@model TransportesGenesis.Pages.Admin.GestionarParadasModel
@{
    ViewData["Title"] = "Gestionar Paradas";
}

<div class="container-fluid">
    <h2 class="text-primary mb-4">📍 Gestionar Paradas</h2>
    <p class="text-muted">Seleccione un bus y una ruta, luego haga clic en "Agregar Parada" y en el mapa para colocar una nueva parada.</p>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert alert-@(Model.TipoMensaje) alert-dismissible fade show" role="alert">
            @Model.Mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filtros de Bus y Ruta -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row align-items-end g-3">
                <div class="col-md-4">
                    <label for="filtro-bus" class="form-label">Bus</label>
                    <select id="filtro-bus" class="form-select">
                        <option value="">-- Seleccione un bus --</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label for="filtro-ruta" class="form-label">Ruta activa</label>
                    <select id="filtro-ruta" class="form-select" disabled>
                        <option value="">-- Seleccione una ruta --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <span id="badge-ruta-seleccionada" class="badge bg-secondary fs-6 w-100 py-2">
                        Sin ruta seleccionada
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Mapa Interactivo -->
    <div id="mapa-paradas" style="height: 500px; border: 2px solid #dee2e6; border-radius: 8px;" class="mb-3"></div>

    <!-- Panel de Control -->
    <div class="paradas-controls mb-4">
        <button id="btn-agregar-parada" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Agregar Parada
        </button>
        <button id="btn-refrescar" class="btn btn-secondary">
            <i class="bi bi-arrow-clockwise"></i> Refrescar
        </button>
    </div>

    <!-- Lista de Paradas -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">📋 Paradas Registradas</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="tabla-paradas">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Dirección</th>
                            <th>Latitud</th>
                            <th>Longitud</th>
                            <th>Orden</th>
                            <th>Ruta</th>
                            <th>Alumno</th>
                            <th>Activo</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="paradas-table-body">
                        <tr>
                            <td colspan="9" class="text-center">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Cargando...</span>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Crear/Editar Parada -->
<div class="modal fade" id="modal-editar-parada" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title">Crear Parada</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="form-parada">
                    <input type="hidden" id="parada-id" />
                    <div class="mb-3">
                        <label for="parada-bus" class="form-label">Bus *</label>
                        <select class="form-select" id="parada-bus">
                            <option value="">-- Seleccione un bus --</option>
                        </select>
                        <small class="text-muted">Solo buses con cupo disponible (sin exceder capacidad).</small>
                    </div>
                    <div class="mb-3">
                        <label for="parada-ruta-modal" class="form-label">Ruta activa *</label>
                        <select class="form-select" id="parada-ruta-modal" disabled>
                            <option value="">-- Seleccione una ruta --</option>
                        </select>
                        <input type="hidden" id="parada-ruta-id" />
                    </div>
                    <div class="mb-3">
                        <label for="parada-alumno" class="form-label">Alumno</label>
                        <select class="form-select" id="parada-alumno">
                            <option value="">Parada del colegio (sin alumno)</option>
                        </select>
                        <small class="text-muted">Solo alumnos sin bus ni parada asignados.</small>
                    </div>
                    <div class="mb-3">
                        <label for="parada-nombre" class="form-label" id="label-parada-direccion">Dirección de la Parada *</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="parada-nombre" placeholder="Ej: 5ta Avenida 12-34 Zona 10, Guatemala" />
                            <button class="btn btn-outline-primary" type="button" id="btn-geocodificar" 
                                    onclick="geocodificarDireccion()" 
                                    title="Buscar dirección en el mapa">
                                <i class="bi bi-search"></i> Buscar en Mapa
                            </button>
                        </div>
                        <small class="text-muted">
                            <i class="bi bi-info-circle"></i> Escribe una dirección y haz clic en "Buscar en Mapa" para obtener las coordenadas automáticamente.
                        </small>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="parada-lat" class="form-label">Latitud</label>
                            <input type="number" class="form-control" id="parada-lat" step="0.000001" readonly />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="parada-lng" class="form-label">Longitud</label>
                            <input type="number" class="form-control" id="parada-lng" step="0.000001" readonly />
                        </div>
                    </div>
                    <div class="alert alert-info mb-3" id="geocoding-info" style="display: none;">
                        <i class="bi bi-geo-alt-fill"></i> <span id="geocoding-info-text"></span>
                    </div>
                    <div class="mb-3">
                        <label for="parada-orden" class="form-label">Orden</label>
                        <input type="number" class="form-control" id="parada-orden" min="1" placeholder="1, 2, 3..." />
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="parada-activo" checked />
                        <label class="form-check-label" for="parada-activo">
                            Parada Activa
                        </label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btn-guardar-parada">
                    <i class="bi bi-save"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        #btn-agregar-parada.active {
            background-color: #0d6efd;
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.5);
        }

        .leaflet-container {
            cursor: default;
        }

        .leaflet-container.crosshair {
            cursor: crosshair !important;
        }

        .popup-actions {
            margin-top: 10px;
        }

        .popup-actions button {
            margin-right: 5px;
        }
    </style>
}

@section Scripts {
    <script type="application/json" id="config-paradas-data">@Html.Raw(Model.ConfigJson)</script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/gestionarParadas.js?v=6"></script>
}
