@page
@model TransportesGenesis.Pages.Admin.ReporteAsignacionesModel
@{
    ViewData["Title"] = "Reporte de Asignaciones";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">
            <i class="bi bi-people-fill"></i> Reporte de Asignaciones Personal-Bus
        </h2>
        <div>
            <a href="/Admin/GestionarAsignaciones" class="btn btn-success me-2">
                <i class="bi bi-plus-circle"></i> Nueva Asignación
            </a>
            <a href="/Admin/Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
        </div>
    </div>

    @if (!Model.Asignaciones.Any())
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle"></i> No hay asignaciones registradas en el sistema.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-list-ul"></i> Total de Asignaciones: @Model.Asignaciones.Count
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Usuario</th>
                                <th>Email</th>
                                <th>Rol</th>
                                <th>Bus Asignado</th>
                                <th>Fecha Asignación</th>
                                <th>Fecha Fin</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var asignacion in Model.Asignaciones)
                            {
                                <tr class="@(asignacion.EsActual ? "table-success" : "")">
                                    <td>@asignacion.IdAsignacion</td>
                                    <td>
                                        <strong>@asignacion.NombreUsuario</strong>
                                    </td>
                                    <td>
                                        <small class="text-muted">@asignacion.EmailUsuario</small>
                                    </td>
                                    <td>
                                        @if (asignacion.Rol.Contains("Piloto"))
                                        {
                                            <span class="badge bg-primary">
                                                <i class="bi bi-person-badge"></i> Piloto
                                            </span>
                                        }
                                        else if (asignacion.Rol.Contains("Monitor"))
                                        {
                                            <span class="badge bg-info">
                                                <i class="bi bi-clipboard-check"></i> Monitor
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@asignacion.Rol</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-bus-front"></i> Bus #@asignacion.IdBus - @asignacion.PlacaBus
                                        </span>
                                    </td>
                                    <td>@asignacion.FechaAsignacion.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (asignacion.FechaFinAsignacion.HasValue)
                                        {
                                            @asignacion.FechaFinAsignacion.Value.ToString("dd/MM/yyyy HH:mm")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin fecha</span>
                                        }
                                    </td>
                                    <td>
                                        @if (asignacion.EsActual)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle-fill"></i> Activa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle-fill"></i> Finalizada
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Estadísticas -->
        <div class="row mt-4">
            <div class="col-md-4">
                <div class="card text-center">
                    <div class="card-body">
                        <h3 class="text-primary">@Model.Asignaciones.Count</h3>
                        <p class="text-muted">Total Asignaciones</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center">
                    <div class="card-body">
                        <h3 class="text-success">@Model.Asignaciones.Count(a => a.EsActual)</h3>
                        <p class="text-muted">Asignaciones Activas</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center">
                    <div class="card-body">
                        <h3 class="text-danger">@Model.Asignaciones.Count(a => !a.EsActual)</h3>
                        <p class="text-muted">Asignaciones Finalizadas</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
