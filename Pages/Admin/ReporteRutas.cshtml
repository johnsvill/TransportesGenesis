@page
@model TransportesGenesis.Pages.Admin.ReporteRutasModel
@{
    ViewData["Title"] = "Reporte de Rutas";
}

<style>
    /* Responsive styles for mobile */
    @@media (max-width: 768px) {
        .d-flex {
            flex-direction: column !important;
            gap: 10px;
        }

        .table-responsive {
            font-size: 0.85rem;
        }

        .table thead {
            display: none;
        }

        .table tbody tr {
            display: block;
            border: 1px solid #dee2e6;
            margin-bottom: 15px;
            border-radius: 8px;
            background: white;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .table tbody td {
            display: block;
            text-align: right;
            border: none;
            padding: 10px 15px;
            position: relative;
            padding-left: 50%;
        }

        .table tbody td:before {
            content: attr(data-label);
            position: absolute;
            left: 15px;
            width: 45%;
            padding-right: 10px;
            white-space: nowrap;
            text-align: left;
            font-weight: bold;
            color: #495057;
        }

        .btn-group {
            flex-direction: column;
            width: 100%;
        }

        .btn-group .btn {
            width: 100%;
            margin-bottom: 5px;
        }
    }
</style>

<div class="container mt-4">
    @if (TempData["Mensaje"] != null)
    {
        var tipoMensaje = TempData["TipoMensaje"]?.ToString() ?? "info";
        var alertClass = tipoMensaje == "success" ? "alert-success" : tipoMensaje == "error" ? "alert-danger" : "alert-info";
        <div class="alert @alertClass alert-dismissible fade show" role="alert">
            <i class="bi @(tipoMensaje == "success" ? "bi-check-circle-fill" : tipoMensaje == "error" ? "bi-x-circle-fill" : "bi-info-circle-fill")"></i>
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">
            <i class="bi bi-map"></i> Reporte de Rutas
        </h2>
        <div>
            <a href="?handler=ExportarExcel" class="btn btn-success me-2">
                <i class="bi bi-file-earmark-excel-fill"></i> Exportar a Excel
            </a>
            <a href="/Admin/Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Volver al Panel
            </a>
        </div>
    </div>

    @if (!Model.Rutas.Any())
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle"></i> No hay rutas registradas en el sistema.
        </div>

        <div class="text-center mt-4">
            <form method="post" asp-page-handler="GenerarDatosEjemplo">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-plus-circle"></i> Generar Rutas de Ejemplo
                </button>
            </form>
            <p class="text-muted mt-2">
                <small>Esto creará algunas rutas de ejemplo para visualizar el reporte</small>
            </p>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-list-ul"></i> Total de Rutas: @Model.Rutas.Count
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Bus</th>
                                <th>Tipo</th>
                                <th>Hora Inicio</th>
                                <th>Paradas</th>
                                <th>Estado</th>
                                <th>Activo</th>
                                <th>Fecha Registro</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ruta in Model.Rutas)
                            {
                                <tr>
                                    <td data-label="ID">@ruta.IdRuta</td>
                                    <td data-label="Nombre">
                                        <strong>@ruta.Nombre</strong>
                                        @if (!string.IsNullOrEmpty(ruta.Descripcion))
                                        {
                                            <br />
                                            <small class="text-muted">@ruta.Descripcion</small>
                                        }
                                    </td>
                                    <td data-label="Bus">
                                        @if (ruta.Bus != null)
                                        {
                                            <span class="badge bg-info">
                                                <i class="bi bi-bus-front"></i> @ruta.Bus.Placa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin bus</span>
                                        }
                                    </td>
                                    <td data-label="Tipo">
                                        @if (ruta.TipoRuta == "Mañana")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-sunrise"></i> Mañana
                                            </span>
                                        }
                                        else if (ruta.TipoRuta == "Tarde")
                                        {
                                            <span class="badge bg-primary">
                                                <i class="bi bi-sunset"></i> Tarde
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@ruta.TipoRuta</span>
                                        }
                                    </td>
                                    <td data-label="Hora Inicio">@ruta.HoraInicio.ToString(@"hh\:mm")</td>
                                    <td data-label="Paradas">
                                        <span class="badge bg-success">
                                            @ruta.ParadasLink.Count paradas
                                        </span>
                                    </td>
                                    <td>
                                        @if (ruta.EsActiva)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle"></i> Activa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle"></i> Inactiva
                                            </span>
                                        }
                                    </td>
                                    <td data-label="Activo">
                                        @if (ruta.Activo == 1)
                                        {
                                            <i class="bi bi-check-circle-fill text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-x-circle-fill text-danger"></i>
                                        }
                                    </td>
                                    <td data-label="Fecha Registro">@ruta.FechaRegistro.ToString("dd/MM/yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Estadísticas -->
        <div class="row mt-4">
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h3 class="text-primary">@Model.Rutas.Count</h3>
                        <p class="text-muted">Total Rutas</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h3 class="text-success">@Model.Rutas.Count(r => r.EsActiva)</h3>
                        <p class="text-muted">Rutas Activas</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h3 class="text-warning">@Model.Rutas.Count(r => r.TipoRuta == "Mañana")</h3>
                        <p class="text-muted">Rutas Mañana</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h3 class="text-info">@Model.Rutas.Count(r => r.TipoRuta == "Tarde")</h3>
                        <p class="text-muted">Rutas Tarde</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
