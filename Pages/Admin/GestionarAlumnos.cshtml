@page
@model TransportesGenesis.Pages.Admin.GestionarAlumnosModel
@{
    ViewData["Title"] = "Gestionar Alumnos";
}

<div class="container-fluid mt-4 px-2 px-md-3">
    <!-- Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-2">
        <h2 class="text-primary mb-0">
            <i class="bi bi-people-fill"></i> 
            <span class="d-none d-md-inline">Gestión de Alumnos</span>
            <span class="d-inline d-md-none">Alumnos</span>
        </h2>
        <a href="/Admin/Index" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> 
            <span class="d-none d-sm-inline">Volver al Dashboard</span>
            <span class="d-inline d-sm-none">Volver</span>
        </a>
    </div>

    <!-- Mensaje de feedback -->
    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert alert-@Model.TipoMensaje alert-dismissible fade show" role="alert">
            <strong>@Model.Mensaje</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Panel de Filtros -->
    <div class="card mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <i class="bi bi-funnel-fill"></i> Filtros
            </h5>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3">
                <!-- Filtro por Bus -->
                <div class="col-12 col-sm-6 col-md-3">
                    <label for="FiltroBus" class="form-label">Bus:</label>
                    <select class="form-select" id="FiltroBus" name="FiltroBus" asp-for="FiltroBus">
                        <option value="">Todos los buses</option>
                        @foreach (var bus in Model.BusesDisponibles)
                        {
                            <option value="@bus.IdBus">@bus.Placa - @bus.Modelo</option>
                        }
                    </select>
                </div>

                <!-- Filtro por Estado de Asignación -->
                <div class="col-12 col-sm-6 col-md-3">
                    <label for="FiltroEstado" class="form-label">Estado de Asignación:</label>
                    <select class="form-select" id="FiltroEstado" name="FiltroEstado" asp-for="FiltroEstado">
                        <option value="">Todos</option>
                        <option value="conbus">Con bus asignado</option>
                        <option value="sinbus">Sin bus asignado</option>
                    </select>
                </div>

                <!-- Filtro por Padre -->
                <div class="col-12 col-sm-6 col-md-3">
                    <label for="FiltroPadre" class="form-label">Padre:</label>
                    <select class="form-select" id="FiltroPadre" name="FiltroPadre" asp-for="FiltroPadre">
                        <option value="">Todos los padres</option>
                        @foreach (var padre in Model.PadresDisponibles)
                        {
                            <option value="@padre.IdPadre">@padre.Nombre @padre.Apellido</option>
                        }
                    </select>
                </div>

                <!-- Filtro por Estado de Ruta del Padre -->
                <div class="col-12 col-sm-6 col-md-3">
                    <label for="FiltroRutaPadre" class="form-label">Estado Ruta Padre:</label>
                    <select class="form-select" id="FiltroRutaPadre" name="FiltroRutaPadre" asp-for="FiltroRutaPadre">
                        <option value="">Todos</option>
                        <option value="configurada">Configurada</option>
                        <option value="noconfigur">No configurada</option>
                    </select>
                </div>

                <!-- Botones de acción -->
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Filtrar
                    </button>
                    <a href="/Admin/GestionarAlumnos" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Limpiar
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Estadísticas -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card text-white bg-primary h-100">
                <div class="card-body p-3">
                    <h6 class="card-title small mb-2">Total Alumnos</h6>
                    <h2 class="mb-0">@Model.Alumnos.Count</h2>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-white bg-success h-100">
                <div class="card-body p-3">
                    <h6 class="card-title small mb-2">Con Bus</h6>
                    <h2 class="mb-0">@Model.Alumnos.Count(a => a.IdBusAsignado.HasValue)</h2>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-white bg-warning h-100">
                <div class="card-body p-3">
                    <h6 class="card-title small mb-2">Sin Bus</h6>
                    <h2 class="mb-0">@Model.Alumnos.Count(a => !a.IdBusAsignado.HasValue)</h2>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-white bg-info h-100">
                <div class="card-body p-3">
                    <h6 class="card-title small mb-2">Con Coords.</h6>
                    <h2 class="mb-0">@Model.Alumnos.Count(a => a.TieneCoordenas)</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de Alumnos -->
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-table"></i> Listado de Alumnos
            </h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Alumnos.Any())
            {
                <!-- Vista de tabla para pantallas medianas y grandes -->
                <div class="table-responsive d-none d-md-block">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Nombre y Apellido</th>
                                <th>Padre</th>
                                <th>Bus Asignado</th>
                                <th>Coordenadas</th>
                                <th>Ruta Padre</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var alumno in Model.Alumnos)
                            {
                                <tr>
                                    <td><strong>#@alumno.IdAlumno</strong></td>
                                    <td>
                                        <strong>@alumno.Nombre @alumno.Apellido</strong>
                                    </td>
                                    <td>
                                        <i class="bi bi-person-fill"></i> @alumno.NombrePadre
                                    </td>
                                    <td>
                                        @if (alumno.IdBusAsignado.HasValue)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-bus-front-fill"></i> @alumno.BusAsignado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-dash-circle"></i> Sin asignar
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (alumno.TieneCoordenas)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-geo-alt-fill"></i> Configurado
                                            </span>
                                            <br />
                                            <small class="text-muted d-none d-lg-inline">
                                                @alumno.Latitud?.ToString("F4"), @alumno.Longitud?.ToString("F4")
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-exclamation-triangle-fill"></i> Sin config.
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (alumno.EstadoRutaPadre == "Configurada")
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle-fill"></i> Sí
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle-fill"></i> No
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <button type="button"
                                                    class="btn btn-sm btn-primary"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalAsignarBus"
                                                    onclick="prepararAsignacion(@alumno.IdAlumno, '@alumno.Nombre @alumno.Apellido', @(alumno.IdBusAsignado?.ToString() ?? "null"))"
                                                    title="Asignar bus">
                                                <i class="bi bi-bus-front"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-warning"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalEditarDireccion"
                                                    onclick="prepararEdicion(@alumno.IdAlumno, '@alumno.Nombre @alumno.Apellido', '@(alumno.Direccion?.Replace("'", "\\'") ?? "")', @(alumno.Latitud?.ToString("G29").Replace(",", ".") ?? "0"), @(alumno.Longitud?.ToString("G29").Replace(",", ".") ?? "0"))"
                                                    title="Editar dirección">
                                                <i class="bi bi-geo-alt"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Vista de cards para móviles -->
                <div class="d-md-none">
                    @foreach (var alumno in Model.Alumnos)
                    {
                        <div class="card mb-2 mx-2">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h6 class="card-title mb-1">
                                            <strong>@alumno.Nombre @alumno.Apellido</strong>
                                        </h6>
                                        <small class="text-muted">#@alumno.IdAlumno</small>
                                    </div>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button"
                                                class="btn btn-primary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalAsignarBus"
                                                onclick="prepararAsignacion(@alumno.IdAlumno, '@alumno.Nombre @alumno.Apellido', @(alumno.IdBusAsignado?.ToString() ?? "null"))">
                                            <i class="bi bi-bus-front"></i>
                                        </button>
                                        <button type="button"
                                                class="btn btn-warning"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalEditarDireccion"
                                                onclick="prepararEdicion(@alumno.IdAlumno, '@alumno.Nombre @alumno.Apellido', '@(alumno.Direccion?.Replace("'", "\\'") ?? "")', @(alumno.Latitud?.ToString("G29").Replace(",", ".") ?? "0"), @(alumno.Longitud?.ToString("G29").Replace(",", ".") ?? "0"))">
                                            <i class="bi bi-geo-alt"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="row g-2 small">
                                    <div class="col-12">
                                        <strong><i class="bi bi-person-fill"></i> Padre:</strong>
                                        <span class="text-muted">@alumno.NombrePadre</span>
                                    </div>
                                    <div class="col-12">
                                        <strong><i class="bi bi-bus-front-fill"></i> Bus:</strong>
                                        @if (alumno.IdBusAsignado.HasValue)
                                        {
                                            <span class="badge bg-success">@alumno.BusAsignado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Sin asignar</span>
                                        }
                                    </div>
                                    <div class="col-6">
                                        <strong><i class="bi bi-geo-alt-fill"></i> Coords:</strong>
                                        @if (alumno.TieneCoordenas)
                                        {
                                            <span class="badge bg-success">Sí</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">No</span>
                                        }
                                    </div>
                                    <div class="col-6">
                                        <strong><i class="bi bi-route"></i> Ruta Padre:</strong>
                                        @if (alumno.EstadoRutaPadre == "Configurada")
                                        {
                                            <span class="badge bg-success">Sí</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">No</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No se encontraron alumnos con los filtros aplicados.
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal: Asignar/Cambiar Bus -->
<div class="modal fade" id="modalAsignarBus" tabindex="-1" aria-labelledby="modalAsignarBusLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form method="post" asp-page-handler="AsignarBus">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="modalAsignarBusLabel">
                        <i class="bi bi-bus-front-fill"></i> Asignar Bus
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="IdAlumnoAsignar" id="IdAlumnoAsignar" />

                    <div class="mb-3">
                        <label class="form-label"><strong>Alumno:</strong></label>
                        <p class="form-control-plaintext" id="NombreAlumnoAsignar"></p>
                    </div>

                    <div class="mb-3">
                        <label for="IdBusAsignar" class="form-label">Seleccionar Bus:</label>
                        <select class="form-select" name="IdBusAsignar" id="IdBusAsignar" required>
                            <option value="">-- Sin asignar (quitar bus) --</option>
                            @foreach (var bus in Model.BusesDisponibles)
                            {
                                <option value="@bus.IdBus">
                                    🚌 @bus.Placa - @bus.Modelo (Cap: @bus.Capacidad)
                                </option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Editar Dirección y Coordenadas -->
<div class="modal fade" id="modalEditarDireccion" tabindex="-1" aria-labelledby="modalEditarDireccionLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down">
        <div class="modal-content">
            <form method="post" asp-page-handler="EditarDireccion" id="formEditarDireccion">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title" id="modalEditarDireccionLabel">
                        <i class="bi bi-geo-alt-fill"></i> Editar Dirección y Coordenadas
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="IdAlumnoEditar" id="IdAlumnoEditar" />
                    <input type="hidden" name="LatitudEditar" id="LatitudEditar" />
                    <input type="hidden" name="LongitudEditar" id="LongitudEditar" />

                    <div class="mb-3">
                        <label class="form-label"><strong>Alumno:</strong></label>
                        <p class="form-control-plaintext" id="NombreAlumnoEditar"></p>
                    </div>

                    <div class="mb-3">
                        <label for="DireccionEditar" class="form-label">Dirección de Recogida *</label>
                        <div class="input-group">
                            <input type="text" 
                                   class="form-control" 
                                   name="DireccionEditar" 
                                   id="DireccionEditar" 
                                   placeholder="Ej: 5ta Avenida 12-34 Zona 10, Guatemala" 
                                   required />
                            <button type="button" class="btn btn-primary" id="btn-buscar-mapa-editar" onclick="buscarEnMapaEditar()">
                                <i class="bi bi-search"></i> Buscar en Mapa
                            </button>
                        </div>
                        <small class="text-muted">
                            <i class="bi bi-info-circle"></i> 
                            Escribe la dirección completa y haz clic en "Buscar en Mapa"
                        </small>
                    </div>

                    <!-- Información de Geocodificación -->
                    <div class="alert alert-info mb-3" id="geocoding-info-editar" style="display: none;">
                        <i class="bi bi-check-circle-fill"></i> 
                        <span id="geocoding-info-text-editar"></span>
                    </div>

                    <!-- Coordenadas Obtenidas (Visible después de geocodificar) -->
                    <div id="coordenadas-section-editar" style="display: none;" class="mb-3">
                        <div class="row">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-geo"></i> Latitud
                                </label>
                                <input type="text" 
                                       class="form-control bg-light" 
                                       id="latitud-display-editar" 
                                       readonly 
                                       placeholder="Se llenará automáticamente" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-geo-alt"></i> Longitud
                                </label>
                                <input type="text" 
                                       class="form-control bg-light" 
                                       id="longitud-display-editar" 
                                       readonly 
                                       placeholder="Se llenará automáticamente" />
                            </div>
                        </div>
                        <small class="text-muted">
                            <i class="bi bi-info-circle"></i> 
                            Estas coordenadas fueron obtenidas automáticamente de la dirección
                        </small>
                    </div>

                    <!-- Mapa de Previsualización -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <i class="bi bi-map-fill"></i> Vista Previa de la Ubicación
                        </label>
                        <div id="mapa-preview-editar" style="height: 300px; border: 2px solid #dee2e6; border-radius: 8px;"></div>
                        <small class="text-muted">
                            <i class="bi bi-info-circle"></i> 
                            Verifica que el marcador esté en la ubicación correcta
                        </small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-warning" id="btn-guardar-editar" disabled>
                        <i class="bi bi-check-circle"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Leaflet CSS y JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        let mapaEditar = null;
        let marcadorEditar = null;

        // Preparar modal de asignación de bus
        function prepararAsignacion(idAlumno, nombreAlumno, idBusActual) {
            document.getElementById('IdAlumnoAsignar').value = idAlumno;
            document.getElementById('NombreAlumnoAsignar').textContent = nombreAlumno;

            const selectBus = document.getElementById('IdBusAsignar');
            if (idBusActual !== null && idBusActual !== 'null') {
                selectBus.value = idBusActual;
            } else {
                selectBus.value = '';
            }
        }

        // Preparar modal de edición de dirección
        function prepararEdicion(idAlumno, nombreAlumno, direccion, latitud, longitud) {
            document.getElementById('IdAlumnoEditar').value = idAlumno;
            document.getElementById('NombreAlumnoEditar').textContent = nombreAlumno;
            document.getElementById('DireccionEditar').value = direccion || '';

            // Inicializar mapa cuando se abre el modal
            setTimeout(() => {
                if (!mapaEditar) {
                    mapaEditar = L.map('mapa-preview-editar').setView([14.6349, -90.5069], 12);
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        attribution: '© OpenStreetMap contributors'
                    }).addTo(mapaEditar);
                }

                // Si ya tiene coordenadas, mostrarlas en el mapa
                if (latitud && longitud && latitud !== 0 && longitud !== 0) {
                    document.getElementById('LatitudEditar').value = latitud;
                    document.getElementById('LongitudEditar').value = longitud;
                    document.getElementById('latitud-display-editar').value = latitud.toFixed(6);
                    document.getElementById('longitud-display-editar').value = longitud.toFixed(6);
                    document.getElementById('coordenadas-section-editar').style.display = 'block';
                    document.getElementById('btn-guardar-editar').disabled = false;

                    if (marcadorEditar) {
                        mapaEditar.removeLayer(marcadorEditar);
                    }

                    marcadorEditar = L.marker([latitud, longitud], {
                        icon: L.icon({
                            iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-green.png',
                            shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-shadow.png',
                            iconSize: [25, 41],
                            iconAnchor: [12, 41],
                            popupAnchor: [1, -34],
                            shadowSize: [41, 41]
                        })
                    }).addTo(mapaEditar);

                    marcadorEditar.bindPopup(`<b>${nombreAlumno}</b><br>${direccion || 'Ubicación actual'}`).openPopup();
                    mapaEditar.setView([latitud, longitud], 16);
                } else {
                    document.getElementById('coordenadas-section-editar').style.display = 'none';
                    document.getElementById('btn-guardar-editar').disabled = true;
                }

                mapaEditar.invalidateSize();
            }, 300);
        }

        // Función de geocodificación
        async function buscarEnMapaEditar() {
            const direccionInput = document.getElementById('DireccionEditar');
            const direccion = direccionInput.value.trim();

            if (!direccion) {
                alert('Por favor ingresa una dirección');
                return;
            }

            const btn = document.getElementById('btn-buscar-mapa-editar');
            const btnOriginalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Buscando...';

            try {
                const queryDireccion = direccion.toLowerCase().includes('guatemala') 
                    ? direccion 
                    : `${direccion}, Guatemala`;

                const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(queryDireccion)}&limit=3`;

                const response = await fetch(url, {
                    headers: {
                        'User-Agent': 'TransportesGenesis/1.0'
                    }
                });

                if (!response.ok) {
                    throw new Error(`Error HTTP: ${response.status}`);
                }

                const resultados = await response.json();

                if (resultados.length === 0) {
                    alert('❌ No se encontró la dirección.\n\nIntenta:\n- Agregar más detalles (Zona, Ciudad)\n- Usar referencias conocidas\n- Ejemplo: "6ta Avenida 9-50 Zona 9, Guatemala"');
                    document.getElementById('geocoding-info-editar').style.display = 'none';
                    return;
                }

                const ubicacion = resultados[0];
                const lat = parseFloat(ubicacion.lat);
                const lng = parseFloat(ubicacion.lon);

                // Actualizar campos hidden (para el servidor)
                document.getElementById('LatitudEditar').value = lat;
                document.getElementById('LongitudEditar').value = lng;

                // Actualizar campos visibles (para que el usuario vea)
                document.getElementById('latitud-display-editar').value = lat.toFixed(6);
                document.getElementById('longitud-display-editar').value = lng.toFixed(6);

                // Mostrar sección de coordenadas
                document.getElementById('coordenadas-section-editar').style.display = 'block';

                // Mostrar información
                document.getElementById('geocoding-info-editar').style.display = 'block';
                document.getElementById('geocoding-info-text-editar').textContent = 
                    `✅ Ubicación encontrada: ${ubicacion.display_name}`;

                // Agregar/mover marcador en el mapa
                if (marcadorEditar) {
                    mapaEditar.removeLayer(marcadorEditar);
                }

                marcadorEditar = L.marker([lat, lng], {
                    icon: L.icon({
                        iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-green.png',
                        shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-shadow.png',
                        iconSize: [25, 41],
                        iconAnchor: [12, 41],
                        popupAnchor: [1, -34],
                        shadowSize: [41, 41]
                    })
                }).addTo(mapaEditar);

                marcadorEditar.bindPopup(`<b>Ubicación</b><br>${direccion}`).openPopup();

                // Centrar mapa
                mapaEditar.setView([lat, lng], 16);

                // Habilitar botón de guardar
                document.getElementById('btn-guardar-editar').disabled = false;

                alert(`✅ Ubicación encontrada correctamente!\n\n${ubicacion.display_name}\n\nCoordenadas:\nLatitud: ${lat.toFixed(6)}\nLongitud: ${lng.toFixed(6)}\n\nVerifica en el mapa que sea la ubicación correcta, luego haz clic en "Guardar Cambios".`);

            } catch (error) {
                console.error('Error:', error);
                alert(`❌ Error al buscar la dirección:\n${error.message}\n\nPor favor intenta nuevamente o contacta al administrador.`);
                document.getElementById('geocoding-info-editar').style.display = 'none';
            } finally {
                btn.disabled = false;
                btn.innerHTML = btnOriginalText;
            }
        }

        // Validación del formulario de edición
        document.getElementById('formEditarDireccion')?.addEventListener('submit', function (e) {
            const lat = parseFloat(document.getElementById('LatitudEditar').value);
            const lng = parseFloat(document.getElementById('LongitudEditar').value);

            if (lat === 0 || lng === 0 || isNaN(lat) || isNaN(lng)) {
                e.preventDefault();
                alert('⚠️ Por favor usa el botón "Buscar en Mapa" para obtener las coordenadas de la dirección.');
                return false;
            }

            return true;
        });

        // Limpiar mapa cuando se cierra el modal
        document.getElementById('modalEditarDireccion')?.addEventListener('hidden.bs.modal', function () {
            document.getElementById('coordenadas-section-editar').style.display = 'none';
            document.getElementById('geocoding-info-editar').style.display = 'none';
            document.getElementById('btn-guardar-editar').disabled = true;

            if (marcadorEditar && mapaEditar) {
                mapaEditar.removeLayer(marcadorEditar);
                marcadorEditar = null;
            }
        });
    </script>
}
