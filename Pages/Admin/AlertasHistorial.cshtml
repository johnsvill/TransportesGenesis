@page
@model TransportesGenesis.Pages.Admin.AlertasHistorialModel
@{
    ViewData["Title"] = "Historial de Alertas";
}

<style>
    .alertas-header {
        background: linear-gradient(135deg, #dc3545 0%, #fd7e14 100%);
        color: white;
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.15);
    }

    .filters-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        margin-bottom: 25px;
    }

    .filters-card .card-header {
        background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
        color: white;
        border: none;
        border-radius: 15px 15px 0 0 !important;
    }

    .stats-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        margin-bottom: 25px;
    }

    .stats-card .card-header {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        border: none;
        border-radius: 15px 15px 0 0 !important;
    }

    .alertas-table-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .alertas-table-card .card-header {
        background: linear-gradient(135deg, #007bff 0%, #6610f2 100%);
        color: white;
        border: none;
        border-radius: 15px 15px 0 0 !important;
    }

    .alerta-row {
        transition: all 0.3s ease;
    }

    .alerta-row:hover {
        background-color: #f8f9fa;
        transform: translateX(3px);
    }

    .tipo-badge {
        font-size: 0.8rem;
        padding: 0.4rem 0.8rem;
        border-radius: 15px;
    }

    .estado-badge {
        font-size: 0.8rem;
        padding: 0.4rem 0.8rem;
        border-radius: 15px;
    }

    .btn-resolver {
        font-size: 0.75rem;
        padding: 0.25rem 0.5rem;
        border-radius: 10px;
    }

    .stats-item {
        text-align: center;
        padding: 15px;
        border-radius: 10px;
        margin: 5px;
        color: white;
        background: linear-gradient(135deg, #007bff 0%, #6610f2 100%);
    }

    .stats-item.active {
        background: linear-gradient(135deg, #dc3545 0%, #fd7e14 100%);
    }

    .stats-item.resolved {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
    }

    .stats-item.proximity {
        background: linear-gradient(135deg, #17a2b8 0%, #6f42c1 100%);
    }

    .stats-item.delay {
        background: linear-gradient(135deg, #ffc107 0%, #fd7e14 100%);
    }

    .empty-state {
        text-align: center;
        padding: 50px;
        color: #6c757d;
    }

    .table-responsive {
        border-radius: 10px;
    }

    .form-control, .form-select {
        border-radius: 8px;
        border: 1px solid #e9ecef;
    }

    .btn-filter {
        border-radius: 8px;
        padding: 0.5rem 1.5rem;
    }

    .sort-header {
        cursor: pointer;
        user-select: none;
        transition: background-color 0.2s;
    }

    .sort-header:hover {
        background-color: rgba(255,255,255,0.1);
    }

    .sort-icon {
        margin-left: 5px;
        font-size: 0.8rem;
    }

    .action-buttons {
        white-space: nowrap;
    }

    @@media (max-width: 768px) {
        .alertas-header {
            padding: 15px;
            text-align: center;
        }

        .alertas-header h1 {
            font-size: 1.5rem;
        }

        .stats-item {
            margin-bottom: 10px;
            padding: 10px;
        }

        .stats-item .fs-3 {
            font-size: 1.5rem !important;
        }

        .btn-resolver {
            font-size: 0.7rem;
            padding: 0.2rem 0.4rem;
        }

        /* Mejorar tabla en móvil */
        .table-responsive {
            font-size: 0.85rem;
        }

        .table thead {
            display: none; /* Ocultar headers en móvil */
        }

        .table tbody tr {
            display: block;
            border: 1px solid #dee2e6;
            margin-bottom: 10px;
            border-radius: 8px;
            background: white;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .table tbody td {
            display: block;
            text-align: right;
            border: none;
            padding: 8px 15px;
            position: relative;
            padding-left: 50%;
        }

        .table tbody td:before {
            content: attr(data-label);
            position: absolute;
            left: 15px;
            width: 45%;
            padding-right: 10px;
            white-space: nowrap;
            text-align: left;
            font-weight: bold;
            color: #495057;
        }

        .action-buttons {
            text-align: center !important;
            padding-left: 15px !important;
        }

        .action-buttons:before {
            display: none;
        }

        /* Filtros en móvil */
        .filters-card .row > [class*="col-"] {
            margin-bottom: 15px;
        }

        /* Header responsive */
        .alertas-header .col-md-4 {
            text-align: center !important;
            margin-top: 15px;
        }
    }

    @@media (max-width: 576px) {
        .container-fluid {
            padding-left: 10px;
            padding-right: 10px;
        }

        .stats-item {
            padding: 8px;
        }

        .card-body {
            padding: 15px;
        }

        .btn-filter {
            width: 100%;
            margin-bottom: 10px;
        }

        .table tbody td {
            padding: 6px 10px;
            padding-left: 45%;
        }

        .table tbody td:before {
            left: 10px;
            width: 40%;
        }
    }
</style>

<div class="container-fluid px-3 px-md-4">
    <!-- Header -->
    <div class="alertas-header animate__animated animate__fadeInDown">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="mb-2 fw-bold">
                    <i class="bi bi-exclamation-triangle-fill me-3"></i>
                    Historial de Alertas
                </h1>
                <p class="mb-0 opacity-75">
                    <i class="bi bi-clock-history me-2"></i>
                    Gestión y seguimiento de todas las alertas del sistema
                </p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <div class="btn-group" role="group">
                    <a href="?handler=ExportarExcel&FiltroTipo=@Model.FiltroTipo&FiltroEstado=@Model.FiltroEstado&FiltroBus=@Model.FiltroBus&FiltroFechaDesde=@Model.FiltroFechaDesde&FiltroFechaHasta=@Model.FiltroFechaHasta" class="btn btn-success btn-lg me-2">
                        <i class="bi bi-file-earmark-excel-fill me-2"></i>
                        <span class="d-none d-md-inline">Exportar </span>Excel
                    </a>
                    <form method="post" asp-page-handler="GenerarDatosEjemplo" class="d-inline me-2">
                        <button type="submit" class="btn btn-info btn-lg" 
                                onclick="return confirm('¿Generar datos de ejemplo para testing? Esto creará alertas ficticias.')">
                            <i class="bi bi-plus-circle me-2"></i>
                            <span class="d-none d-md-inline">Generar </span>Datos
                        </button>
                    </form>
                    <form method="post" asp-page-handler="LimpiarAlertasAntiguas" class="d-inline">
                        <button type="submit" class="btn btn-light btn-lg" 
                                onclick="return confirm('¿Estás seguro de eliminar alertas resueltas de más de 30 días?')">
                            <i class="bi bi-trash3 me-2"></i>
                            <span class="d-none d-md-inline">Limpiar </span>Antiguas
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Mensaje de estado -->
    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert alert-@(Model.TipoMensaje == "success" ? "success" : Model.TipoMensaje == "error" ? "danger" : "warning") alert-dismissible fade show" role="alert">
            <strong>
                @if (Model.TipoMensaje == "success") { <i class="bi bi-check-circle-fill me-2"></i> }
                @if (Model.TipoMensaje == "error") { <i class="bi bi-exclamation-circle-fill me-2"></i> }
                @if (Model.TipoMensaje == "warning") { <i class="bi bi-exclamation-triangle-fill me-2"></i> }
            </strong>
            @Model.Mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Estadísticas -->
    <div class="stats-card">
        <div class="card-header">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-graph-up me-2"></i>
                Estadísticas de Alertas
            </h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-6 col-md-2">
                    <div class="stats-item">
                        <div class="fs-3 fw-bold">@Model.TotalAlertas</div>
                        <div class="small">Total</div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="stats-item active">
                        <div class="fs-3 fw-bold">@Model.AlertasActivas</div>
                        <div class="small">Activas</div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="stats-item resolved">
                        <div class="fs-3 fw-bold">@Model.AlertasResueltas</div>
                        <div class="small">Resueltas</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stats-item proximity">
                        <div class="fs-3 fw-bold">@Model.AlertasProximidad</div>
                        <div class="small">Proximidad</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stats-item delay">
                        <div class="fs-3 fw-bold">@Model.AlertasRetraso</div>
                        <div class="small">Retrasos</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtros -->
    <div class="filters-card">
        <div class="card-header">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-funnel-fill me-2"></i>
                Filtros de Búsqueda
            </h5>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3">
                <!-- Tipo de Alerta -->
                <div class="col-md-3">
                    <label asp-for="FiltroTipo" class="form-label">Tipo de Alerta:</label>
                    <select asp-for="FiltroTipo" class="form-select">
                        <option value="">Todos los tipos</option>
                        <option value="proximidad">Proximidad</option>
                        <option value="retraso">Retraso</option>
                    </select>
                </div>

                <!-- Estado -->
                <div class="col-md-3">
                    <label asp-for="FiltroEstado" class="form-label">Estado:</label>
                    <select asp-for="FiltroEstado" class="form-select">
                        <option value="">Todos los estados</option>
                        <option value="activo">Activo</option>
                        <option value="resuelto">Resuelto</option>
                    </select>
                </div>

                <!-- Bus -->
                <div class="col-md-3">
                    <label asp-for="FiltroBus" class="form-label">Bus:</label>
                    <select asp-for="FiltroBus" class="form-select" asp-items="Model.BusesDisponibles">
                        <option value="">Todos los buses</option>
                    </select>
                </div>

                <!-- ID Alumno -->
                <div class="col-md-3">
                    <label asp-for="FiltroAlumno" class="form-label">ID Alumno:</label>
                    <input asp-for="FiltroAlumno" type="number" class="form-control" placeholder="Ej: 123">
                </div>

                <!-- Fecha Desde -->
                <div class="col-md-3">
                    <label asp-for="FiltroFechaDesde" class="form-label">Fecha Desde:</label>
                    <input asp-for="FiltroFechaDesde" type="date" class="form-control">
                </div>

                <!-- Fecha Hasta -->
                <div class="col-md-3">
                    <label asp-for="FiltroFechaHasta" class="form-label">Fecha Hasta:</label>
                    <input asp-for="FiltroFechaHasta" type="date" class="form-control">
                </div>

                <!-- Ordenar Por -->
                <div class="col-md-3">
                    <label asp-for="OrdenarPor" class="form-label">Ordenar Por:</label>
                    <select asp-for="OrdenarPor" class="form-select">
                        <option value="FechaHora">Fecha y Hora</option>
                        <option value="TipoAlerta">Tipo de Alerta</option>
                        <option value="Estado">Estado</option>
                        <option value="IdBus">Bus</option>
                        <option value="NombreAlumno">Alumno</option>
                    </select>
                </div>

                <!-- Orden -->
                <div class="col-md-3">
                    <label class="form-label">Orden:</label>
                    <div class="form-check">
                        <input asp-for="OrdenDescendente" class="form-check-input" type="checkbox">
                        <label asp-for="OrdenDescendente" class="form-check-label">
                            Descendente
                        </label>
                    </div>
                </div>

                <!-- Botones -->
                <div class="col-12">
                    <button type="submit" class="btn btn-primary btn-filter me-2">
                        <i class="bi bi-search me-2"></i>Buscar
                    </button>
                    <a asp-page="AlertasHistorial" class="btn btn-outline-secondary btn-filter">
                        <i class="bi bi-arrow-clockwise me-2"></i>Limpiar
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de Alertas -->
    <div class="alertas-table-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-table me-2"></i>
                Lista de Alertas (@Model.Alertas.Count() registros)
            </h5>
            <small class="opacity-75">
                Actualizado: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
            </small>
        </div>
        <div class="card-body p-0">
            @if (Model.Alertas.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th scope="col" class="sort-header" data-sort="Id">
                                    ID
                                    <i class="bi bi-arrow-down-up sort-icon"></i>
                                </th>
                                <th scope="col" class="sort-header" data-sort="TipoAlerta">
                                    Tipo
                                    <i class="bi bi-arrow-down-up sort-icon"></i>
                                </th>
                                <th scope="col" class="sort-header" data-sort="Mensaje">
                                    Mensaje
                                </th>
                                <th scope="col" class="sort-header" data-sort="FechaHora">
                                    Fecha y Hora
                                    <i class="bi bi-arrow-down-up sort-icon"></i>
                                </th>
                                <th scope="col" class="sort-header" data-sort="NombreBus">
                                    Bus
                                </th>
                                <th scope="col" class="sort-header" data-sort="NombreAlumno">
                                    Alumno
                                </th>
                                <th scope="col" class="sort-header" data-sort="Estado">
                                    Estado
                                    <i class="bi bi-arrow-down-up sort-icon"></i>
                                </th>
                                <th scope="col" class="text-center">
                                    Acciones
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var alerta in Model.Alertas)
                            {
                                <tr class="alerta-row">
                                    <td class="fw-bold" data-label="ID">#@alerta.Id</td>
                                    <td data-label="Tipo">
                                        @if (alerta.TipoAlerta == "proximidad")
                                        {
                                            <span class="tipo-badge badge bg-info">
                                                <i class="bi bi-geo-alt-fill me-1"></i>Proximidad
                                            </span>
                                        }
                                        else if (alerta.TipoAlerta == "retraso")
                                        {
                                            <span class="tipo-badge badge bg-warning">
                                                <i class="bi bi-clock-fill me-1"></i>Retraso
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="tipo-badge badge bg-secondary">@alerta.TipoAlerta</span>
                                        }
                                    </td>
                                    <td data-label="Mensaje">
                                        <div style="max-width: 250px;">
                                            @alerta.Mensaje
                                            @if (alerta.ParadasRestantes.HasValue)
                                            {
                                                <br><small class="text-muted">(@alerta.ParadasRestantes paradas restantes)</small>
                                            }
                                        </div>
                                    </td>
                                    <td data-label="Fecha y Hora">
                                        @alerta.FechaHora.ToString("dd/MM/yyyy")
                                        <br>
                                        <small class="text-muted">@alerta.FechaHora.ToString("HH:mm:ss")</small>
                                    </td>
                                    <td data-label="Bus">
                                        @if (!string.IsNullOrEmpty(alerta.NombreBus))
                                        {
                                            <strong>@alerta.NombreBus</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Bus #@alerta.IdBus</span>
                                        }
                                    </td>
                                    <td data-label="Alumno">
                                        @if (!string.IsNullOrEmpty(alerta.NombreAlumno))
                                        {
                                            @alerta.NombreAlumno
                                        }
                                        else if (alerta.IdAlumno.HasValue)
                                        {
                                            <span class="text-muted">Alumno #@alerta.IdAlumno</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td data-label="Estado">
                                        @if (alerta.Estado == "activo")
                                        {
                                            <span class="estado-badge badge bg-danger">
                                                <i class="bi bi-exclamation-circle-fill me-1"></i>Activo
                                            </span>
                                        }
                                        else if (alerta.Estado == "resuelto")
                                        {
                                            <span class="estado-badge badge bg-success">
                                                <i class="bi bi-check-circle-fill me-1"></i>Resuelto
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="estado-badge badge bg-secondary">@alerta.Estado</span>
                                        }
                                    </td>
                                    <td class="text-center action-buttons">
                                        @if (alerta.Estado == "activo")
                                        {
                                            <form method="post" asp-page-handler="MarcarResuelta" asp-route-idAlerta="@alerta.Id" class="d-inline">
                                                <button type="submit" class="btn btn-success btn-resolver" 
                                                        onclick="return confirm('¿Marcar esta alerta como resuelta?')"
                                                        title="Marcar como resuelta">
                                                    <i class="bi bi-check2-circle"></i>
                                                    <span class="d-none d-md-inline ms-1">Resolver</span>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                <i class="bi bi-check2-circle"></i> Ya resuelta
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-inbox" style="font-size: 4rem; color: #dee2e6;"></i>
                    <h4 class="mt-3">No se encontraron alertas</h4>
                    <p>No hay alertas que coincidan con los filtros seleccionados.</p>
                    <a asp-page="AlertasHistorial" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-clockwise me-2"></i>Ver todas las alertas
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-submit del formulario cuando cambian los filtros principales
            const selectores = ['#FiltroTipo', '#FiltroEstado', '#FiltroBus'];
            selectores.forEach(selector => {
                const elemento = document.querySelector(selector);
                if (elemento) {
                    elemento.addEventListener('change', function() {
                        this.form.submit();
                    });
                }
            });

            // Confirmar limpieza de alertas
            const btnLimpiar = document.querySelector('button[formaction*="LimpiarAlertasAntiguas"]');
            if (btnLimpiar) {
                btnLimpiar.addEventListener('click', function(e) {
                    if (!confirm('¿Estás seguro de eliminar todas las alertas resueltas de más de 30 días? Esta acción no se puede deshacer.')) {
                        e.preventDefault();
                        return false;
                    }
                });
            }

            // Tooltips para botones pequeños
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'));
            var tooltipList = tooltipTriggerList.map(function(tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Resaltar fila al hacer hover
            const filas = document.querySelectorAll('.alerta-row');
            filas.forEach(fila => {
                fila.addEventListener('mouseenter', function() {
                    this.style.backgroundColor = '#e3f2fd';
                });
                fila.addEventListener('mouseleave', function() {
                    this.style.backgroundColor = '';
                });
            });

            // Auto-refresh cada 5 minutos si hay alertas activas
            const alertasActivas = @Model.AlertasActivas;
            if (alertasActivas > 0) {
                setTimeout(function() {
                    if (confirm('¿Actualizar la página para ver nuevas alertas?')) {
                        window.location.reload();
                    }
                }, 300000); // 5 minutos
            }
        });
    </script>
}