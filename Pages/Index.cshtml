@page "/Dashboard"
@{
    ViewData["Title"] = "Dashboard Principal";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<style>
    .dashboard-hero {
        background: linear-gradient(135deg, #FFA500 0%, #FF8C00 100%);
        color: white;
        border-radius: 25px;
        padding: 40px;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(255,165,0,0.3);
    }

    .dashboard-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 300px;
        height: 300px;
        background: rgba(255,255,255,0.1);
        border-radius: 50%;
        animation: float 10s ease-in-out infinite;
    }

    .dashboard-hero::after {
        content: '';
        position: absolute;
        bottom: -30%;
        left: -10%;
        width: 200px;
        height: 200px;
        background: rgba(255,255,255,0.05);
        border-radius: 50%;
        animation: float 12s ease-in-out infinite reverse;
    }

    .stats-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
        overflow: hidden;
        height: 100%;
    }

    .stats-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 30px rgba(0,0,0,0.15);
    }

    .stats-card .card-body {
        padding: 30px;
        position: relative;
    }

    .stats-icon {
        width: 70px;
        height: 70px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: white;
        margin-bottom: 20px;
        position: relative;
        overflow: hidden;
    }

    .stats-icon::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: linear-gradient(45deg, transparent, rgba(255,255,255,0.1), transparent);
        animation: shimmer 3s infinite;
    }

    .stats-number {
        font-size: 2.5rem;
        font-weight: bold;
        margin-bottom: 10px;
        background: linear-gradient(135deg, #333 0%, #666 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .stats-buses { background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%); }
    .stats-rutas { background: linear-gradient(135deg, #228B22 0%, #32CD32 100%); }
    .stats-estudiantes { background: linear-gradient(135deg, #FF6B35 0%, #FF4500 100%); }
    .stats-alertas { background: linear-gradient(135deg, #DC143C 0%, #B22222 100%); }

    .quick-actions {
        background: white;
        border-radius: 20px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.1);
        padding: 30px;
        margin-bottom: 30px;
    }

    .action-btn {
        background: white;
        border: 2px solid #e9ecef;
        border-radius: 15px;
        padding: 20px;
        text-decoration: none;
        color: #333;
        transition: all 0.3s ease;
        display: block;
        margin-bottom: 15px;
        position: relative;
        overflow: hidden;
    }

    .action-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        color: #007bff;
        border-color: #007bff;
    }

    .action-btn i {
        font-size: 2rem;
        margin-bottom: 15px;
        display: block;
    }

    .recent-activity {
        background: white;
        border-radius: 20px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .activity-item {
        border-bottom: 1px solid #f8f9fa;
        padding: 20px;
        transition: all 0.3s ease;
        position: relative;
    }

    .activity-item:hover {
        background-color: #f8f9fa;
        padding-left: 30px;
    }

    .activity-item:last-child {
        border-bottom: none;
    }

    .activity-time {
        font-size: 0.8rem;
        color: #6c757d;
        background: #f8f9fa;
        padding: 4px 12px;
        border-radius: 20px;
        display: inline-block;
    }

    .weather-widget {
        background: linear-gradient(135deg, #1E90FF 0%, #87CEEB 100%);
        color: white;
        border-radius: 20px;
        padding: 25px;
        text-align: center;
        margin-bottom: 20px;
        box-shadow: 0 6px 20px rgba(30,144,255,0.3);
    }

    .weather-icon {
        font-size: 3rem;
        margin-bottom: 15px;
    }

    @@media (max-width: 768px) {
        .dashboard-hero {
            padding: 25px;
            margin-bottom: 20px;
        }

        .stats-card .card-body {
            padding: 20px;
        }

        .stats-icon {
            width: 50px;
            height: 50px;
            font-size: 1.5rem;
        }

        .stats-number {
            font-size: 2rem;
        }

        .quick-actions {
            padding: 20px;
        }

        .action-btn {
            padding: 15px;
        }

        .action-btn i {
            font-size: 1.5rem;
            margin-bottom: 10px;
        }
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-20px) rotate(180deg); }
    }

    @@keyframes shimmer {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(100%); }
    }

    .progress-ring {
        width: 80px;
        height: 80px;
        transform: rotate(-90deg);
    }

    .progress-ring-circle {
        stroke: currentColor;
        stroke-width: 8;
        fill: transparent;
        stroke-dasharray: 251.2;
        stroke-dashoffset: 0;
        transition: stroke-dashoffset 0.5s ease-in-out;
    }

    .notification-badge {
        position: absolute;
        top: -5px;
        right: -5px;
        background: #dc3545;
        color: white;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        font-weight: bold;
    }
</style>

<div class="container-fluid px-3 px-md-4">
    <!-- Hero Section -->
    <div class="dashboard-hero animate__animated animate__fadeInDown">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="mb-3 fw-bold">
                    ¡Bienvenido a Transportes Genesis!
                </h1>
                <p class="mb-3 fs-5 opacity-90">
                    Sistema integral de gestión de transporte escolar
                </p>
                <p class="mb-0 opacity-75">
                    <i class="bi bi-calendar-check me-2"></i>
                    <span id="fechaHoy"></span> • 
                    <i class="bi bi-clock me-2 ms-3"></i>
                    <span id="horaActual"></span>
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <div class="weather-widget animate__animated animate__fadeInRight" style="animation-delay: 0.3s;">
                    <div class="weather-icon">
                        <i class="bi bi-sun-fill"></i>
                    </div>
                    <div class="fs-2 fw-bold">24°C</div>
                    <div class="opacity-75">Guatemala City</div>
                    <small class="opacity-75">Ideal para rutas escolares</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Estadísticas Principales -->
    <div class="row g-4 mb-4">
        <div class="col-6 col-lg-3">
            <div class="stats-card animate__animated animate__fadeInUp" style="animation-delay: 0.1s;">
                <div class="card-body text-center">
                    <div class="stats-icon stats-buses mx-auto">
                        <i class="bi bi-bus-front-fill"></i>
                    </div>
                    <div class="stats-number">12</div>
                    <div class="text-muted fw-semibold">Buses Activos</div>
                    <div class="mt-2">
                        <small class="text-success">
                            <i class="bi bi-arrow-up"></i> 8% este mes
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="stats-card animate__animated animate__fadeInUp" style="animation-delay: 0.2s;">
                <div class="card-body text-center">
                    <div class="stats-icon stats-rutas mx-auto">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>
                    <div class="stats-number">25</div>
                    <div class="text-muted fw-semibold">Rutas Activas</div>
                    <div class="mt-2">
                        <small class="text-success">
                            <i class="bi bi-arrow-up"></i> 12% este mes
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="stats-card animate__animated animate__fadeInUp" style="animation-delay: 0.3s;">
                <div class="card-body text-center">
                    <div class="stats-icon stats-estudiantes mx-auto">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div class="stats-number">487</div>
                    <div class="text-muted fw-semibold">Estudiantes</div>
                    <div class="mt-2">
                        <small class="text-info">
                            <i class="bi bi-dash"></i> Estable
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="stats-card animate__animated animate__fadeInUp" style="animation-delay: 0.4s;">
                <div class="card-body text-center">
                    <div class="stats-icon stats-alertas mx-auto position-relative">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span class="notification-badge">3</span>
                    </div>
                    <div class="stats-number">3</div>
                    <div class="text-muted fw-semibold">Alertas</div>
                    <div class="mt-2">
                        <small class="text-warning">
                            <i class="bi bi-exclamation-circle"></i> Requiere atención
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Acciones Rápidas -->
        <div class="col-lg-4">
            <div class="quick-actions animate__animated animate__fadeInLeft" style="animation-delay: 0.5s;">
                <h5 class="mb-4 fw-bold text-center">
                    <i class="bi bi-lightning-charge-fill me-2 text-primary"></i>
                    Acciones Rápidas
                </h5>

                <a href="/Geolocalizacion/MapaEnTiempoReal" class="action-btn">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <i class="bi bi-geo-alt-fill text-primary"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">Ver Mapa en Tiempo Real</div>
                            <small class="text-muted">Ubicación actual de todos los buses</small>
                        </div>
                    </div>
                </a>

                <a href="/Piloto/MiRuta" class="action-btn">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <i class="bi bi-compass-fill text-success"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">Mi Ruta del Día</div>
                            <small class="text-muted">Ver ruta asignada para hoy</small>
                        </div>
                    </div>
                </a>

                <a href="/Padres/ConfirmarAsistencia" class="action-btn">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <i class="bi bi-calendar-check-fill text-warning"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">Confirmar Asistencia</div>
                            <small class="text-muted">Gestionar asistencia estudiantil</small>
                        </div>
                    </div>
                </a>

                <a href="/Admin/CalcularRutas" class="action-btn">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <i class="bi bi-calculator-fill text-info"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">Calcular Rutas</div>
                            <small class="text-muted">Optimizar rutas de transporte</small>
                        </div>
                    </div>
                </a>

                <a href="/Geolocalizacion/BusesIndex" class="action-btn">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <i class="bi bi-bus-front-fill text-purple"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">Gestionar Buses</div>
                            <small class="text-muted">Administrar flota de vehículos</small>
                        </div>
                    </div>
                </a>
            </div>
        </div>

        <!-- Actividad Reciente -->
        <div class="col-lg-8">
            <div class="recent-activity animate__animated animate__fadeInRight" style="animation-delay: 0.6s;">
                <div class="card-header bg-transparent border-0 p-4">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-clock-history me-2 text-primary"></i>
                        Actividad Reciente
                    </h5>
                </div>

                <div class="activity-item">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="d-flex">
                            <div class="me-3">
                                <div class="bg-success rounded-circle p-2">
                                    <i class="bi bi-bus-front-fill text-white"></i>
                                </div>
                            </div>
                            <div>
                                <div class="fw-semibold">Bus P-001CX completó ruta matutina</div>
                                <div class="text-muted">Ruta Centro-Norte finalizada exitosamente</div>
                            </div>
                        </div>
                        <span class="activity-time">Hace 5 min</span>
                    </div>
                </div>

                <div class="activity-item">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="d-flex">
                            <div class="me-3">
                                <div class="bg-warning rounded-circle p-2">
                                    <i class="bi bi-person-fill text-white"></i>
                                </div>
                            </div>
                            <div>
                                <div class="fw-semibold">15 estudiantes confirmaron asistencia</div>
                                <div class="text-muted">Para la ruta vespertina de hoy</div>
                            </div>
                        </div>
                        <span class="activity-time">Hace 12 min</span>
                    </div>
                </div>

                <div class="activity-item">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="d-flex">
                            <div class="me-3">
                                <div class="bg-info rounded-circle p-2">
                                    <i class="bi bi-geo-alt-fill text-white"></i>
                                </div>
                            </div>
                            <div>
                                <div class="fw-semibold">Nueva ruta optimizada calculada</div>
                                <div class="text-muted">Ruta Este-Sur reducirá tiempo en 8 minutos</div>
                            </div>
                        </div>
                        <span class="activity-time">Hace 25 min</span>
                    </div>
                </div>

                <div class="activity-item">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="d-flex">
                            <div class="me-3">
                                <div class="bg-danger rounded-circle p-2">
                                    <i class="bi bi-exclamation-triangle-fill text-white"></i>
                                </div>
                            </div>
                            <div>
                                <div class="fw-semibold">Alerta: Bus P-003CX detenido</div>
                                <div class="text-muted">Sin movimiento detectado por más de 10 minutos</div>
                            </div>
                        </div>
                        <span class="activity-time">Hace 32 min</span>
                    </div>
                </div>

                <div class="activity-item">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="d-flex">
                            <div class="me-3">
                                <div class="bg-primary rounded-circle p-2">
                                    <i class="bi bi-calendar-check-fill text-white"></i>
                                </div>
                            </div>
                            <div>
                                <div class="fw-semibold">8 padres actualizaron preferencias</div>
                                <div class="text-muted">Cambios en horarios de recogida para la próxima semana</div>
                            </div>
                        </div>
                        <span class="activity-time">Hace 1 h</span>
                    </div>
                </div>

                <div class="text-center p-4">
                    <a href="#" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-right me-2"></i>
                        Ver toda la actividad
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Actualizar fecha y hora
            actualizarFechaHora();
            setInterval(actualizarFechaHora, 1000);

            // Animaciones escalonadas
            setTimeout(() => {
                const cards = document.querySelectorAll('.stats-card');
                cards.forEach((card, index) => {
                    setTimeout(() => {
                        card.classList.add('animate__pulse');
                        setTimeout(() => {
                            card.classList.remove('animate__pulse');
                        }, 1000);
                    }, index * 200);
                });
            }, 2000);

            // Simulación de datos en tiempo real
            setTimeout(simularActualizacionDatos, 5000);
            setInterval(simularActualizacionDatos, 30000);
        });

        function actualizarFechaHora() {
            const ahora = new Date();

            // Fecha
            const opciones = { 
                weekday: 'long', 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric' 
            };
            document.getElementById('fechaHoy').textContent = 
                ahora.toLocaleDateString('es-ES', opciones);

            // Hora
            document.getElementById('horaActual').textContent = 
                ahora.toLocaleTimeString('es-ES', { hour12: false });
        }

        function simularActualizacionDatos() {
            // Simular pequeños cambios en las estadísticas
            const elementos = [
                { id: 'busesActivos', min: 10, max: 15 },
                { id: 'rutasActivas', min: 20, max: 30 },
                { id: 'estudiantes', min: 450, max: 500 }
            ];

            elementos.forEach(elemento => {
                const nuevoValor = Math.floor(Math.random() * (elemento.max - elemento.min + 1)) + elemento.min;
                const elementoDOM = document.querySelector('.stats-number');
                if (elementoDOM) {
                    // Efecto de conteo animado
                    animarContador(elementoDOM, nuevoValor);
                }
            });
        }

        function animarContador(elemento, valorFinal) {
            const valorInicial = parseInt(elemento.textContent);
            const duracion = 1000;
            const pasos = 30;
            const incremento = (valorFinal - valorInicial) / pasos;
            let valorActual = valorInicial;
            let paso = 0;

            const intervalo = setInterval(() => {
                if (paso >= pasos) {
                    elemento.textContent = valorFinal;
                    clearInterval(intervalo);
                    return;
                }

                valorActual += incremento;
                elemento.textContent = Math.round(valorActual);
                paso++;
            }, duracion / pasos);
        }

        // Efectos hover mejorados
        document.querySelectorAll('.action-btn').forEach(btn => {
            btn.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-3px) scale(1.02)';
            });

            btn.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0) scale(1)';
            });
        });

        // Notificaciones de bienvenida
        setTimeout(() => {
            if (typeof showToast === 'function') {
                showToast('¡Bienvenido a Transportes Genesis! 🚌', 'success');
            }
        }, 1500);
    </script>
}