@page
@model TransportesGenesis.Pages.Test.TestRutasAPIModel
@{
    ViewData["Title"] = "Test API - Rutas Dinámicas";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="bi bi-bug"></i> Test API - FASE 5: Rutas Dinámicas</h2>
                <span class="badge bg-warning text-dark">MODO DESARROLLO</span>
            </div>
        </div>
    </div>

    <!-- Panel de Control -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-calculator"></i> TEST 1: Calcular Ruta
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Bus ID:</label>
                        <input type="number" id="busId" class="form-control" value="4" min="1">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Fecha:</label>
                        <input type="date" id="fecha" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Turno:</label>
                        <select id="tipoRuta" class="form-select">
                            <option value="Mañana" selected>Mañana</option>
                            <option value="Tarde">Tarde</option>
                        </select>
                    </div>
                    <button onclick="calcularRuta()" class="btn btn-primary w-100">
                        <i class="bi bi-play-circle"></i> Calcular Ruta
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-info">
                <div class="card-header bg-info text-white">
                    <i class="bi bi-search"></i> TEST 2: Obtener Ruta Activa
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Bus ID:</label>
                        <input type="number" id="busIdActiva" class="form-control" value="4" min="1">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Turno:</label>
                        <select id="tipoRutaActiva" class="form-select">
                            <option value="Mañana" selected>Mañana</option>
                            <option value="Tarde">Tarde</option>
                        </select>
                    </div>
                    <button onclick="obtenerRutaActiva()" class="btn btn-info w-100 text-white">
                        <i class="bi bi-arrow-down-circle"></i> Obtener Ruta Activa
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-success">
                <div class="card-header bg-success text-white">
                    <i class="bi bi-check-circle"></i> TEST 3: Marcar Parada
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">ID Ruta:</label>
                        <input type="number" id="rutaId" class="form-control" placeholder="Ej: 1" min="1">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">ID Parada:</label>
                        <input type="number" id="paradaId" class="form-control" placeholder="Ej: 1" min="1">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Estado:</label>
                        <select id="completada" class="form-select">
                            <option value="true">Completada ✓</option>
                            <option value="false">Pendiente ⏳</option>
                        </select>
                    </div>
                    <button onclick="marcarParada()" class="btn btn-success w-100">
                        <i class="bi bi-check2"></i> Marcar Parada
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Consola de Logs -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-dark text-white d-flex justify-content-between">
                    <span><i class="bi bi-terminal"></i> Console Log</span>
                    <button onclick="limpiarConsola()" class="btn btn-sm btn-outline-light">
                        <i class="bi bi-trash"></i> Limpiar
                    </button>
                </div>
                <div class="card-body bg-dark text-light" style="font-family: 'Courier New', monospace; max-height: 300px; overflow-y: auto;">
                    <div id="console"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Resultado JSON -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-secondary text-white d-flex justify-content-between">
                    <span><i class="bi bi-file-code"></i> Respuesta JSON</span>
                    <button onclick="copiarJSON()" class="btn btn-sm btn-outline-light">
                        <i class="bi bi-clipboard"></i> Copiar
                    </button>
                </div>
                <div class="card-body">
                    <pre id="resultado" class="bg-light p-3" style="max-height: 500px; overflow: auto;"><code>Esperando petición...</code></pre>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let logCount = 0;

    function log(mensaje, tipo = 'info') {
        logCount++;
        const timestamp = new Date().toLocaleTimeString();
        const colores = {
            'info': 'text-info',
            'success': 'text-success',
            'error': 'text-danger',
            'warning': 'text-warning'
        };
        const iconos = {
            'info': 'bi-info-circle',
            'success': 'bi-check-circle',
            'error': 'bi-x-circle',
            'warning': 'bi-exclamation-triangle'
        };

        const html = `<div class="${colores[tipo] || 'text-light'}">
            <i class="bi ${iconos[tipo] || 'bi-circle'}"></i> 
            [${timestamp}] #${logCount} ${mensaje}
        </div>`;

        document.getElementById('console').innerHTML += html;
        document.getElementById('console').parentElement.scrollTop = document.getElementById('console').parentElement.scrollHeight;
    }

    function limpiarConsola() {
        document.getElementById('console').innerHTML = '';
        logCount = 0;
        log('Consola limpiada', 'info');
    }

    function mostrarResultado(data) {
        document.getElementById('resultado').innerHTML = '<code>' + JSON.stringify(data, null, 2) + '</code>';
    }

    function copiarJSON() {
        const texto = document.getElementById('resultado').innerText;
        navigator.clipboard.writeText(texto).then(() => {
            log('JSON copiado al portapapeles', 'success');
        });
    }

    // TEST 1: Calcular Ruta
    async function calcularRuta() {
        try {
            const busId = document.getElementById('busId').value;
            const fecha = document.getElementById('fecha').value;
            const tipoRuta = document.getElementById('tipoRuta').value;

            log(`🚀 Iniciando TEST 1: Calcular Ruta`, 'info');
            log(`   └─ Bus: ${busId}, Fecha: ${fecha}, Turno: ${tipoRuta}`, 'info');

            const body = {
                idBus: parseInt(busId),
                fecha: fecha + 'T00:00:00',
                tipoRuta: tipoRuta
            };

            log('📤 Enviando POST /api/rutas/calcular', 'warning');
            log('   └─ Body: ' + JSON.stringify(body), 'info');

            const response = await fetch('/api/rutas/calcular', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(body)
            });

            log(`📥 Respuesta recibida: ${response.status} ${response.statusText}`, response.ok ? 'success' : 'error');

            const data = await response.json();
            mostrarResultado(data);

            if (data.success) {
                log(`✅ Ruta calculada exitosamente!`, 'success');
                log(`   └─ ID Ruta: ${data.data?.idRuta || 'N/A'}`, 'success');
                log(`   └─ Paradas: ${data.data?.paradas?.length || 0}`, 'success');

                if (data.data?.paradas?.length > 0) {
                    log(`📍 Paradas generadas:`, 'info');
                    data.data.paradas.forEach((p, i) => {
                        log(`   ${i + 1}. ${p.nombreAlumno} - Orden: ${p.orden}`, 'info');
                    });
                }
            } else {
                log(`⚠️ ${data.message}`, 'warning');
            }
        } catch (error) {
            log(`❌ ERROR: ${error.message}`, 'error');
            mostrarResultado({ error: error.message });
        }
    }

    // TEST 2: Obtener Ruta Activa
    async function obtenerRutaActiva() {
        try {
            const busId = document.getElementById('busIdActiva').value;
            const tipoRuta = document.getElementById('tipoRutaActiva').value;

            log(`🔍 Iniciando TEST 2: Obtener Ruta Activa`, 'info');
            log(`   └─ Bus: ${busId}, Turno: ${tipoRuta}`, 'info');

            const url = `/api/rutas/bus/${busId}/activa?tipoRuta=${tipoRuta}`;
            log(`📤 Enviando GET ${url}`, 'warning');

            const response = await fetch(url);
            log(`📥 Respuesta recibida: ${response.status} ${response.statusText}`, response.ok ? 'success' : 'error');

            const data = await response.json();
            mostrarResultado(data);

            if (data.success && data.data?.idRuta) {
                log(`✅ Ruta activa encontrada!`, 'success');
                log(`   └─ ID Ruta: ${data.data.idRuta}`, 'success');
                log(`   └─ Nombre: ${data.data.nombre}`, 'success');
                log(`   └─ Paradas: ${data.data.paradas?.length || 0}`, 'success');
                log(`   └─ Activa: ${data.data.esActiva ? 'Sí ✓' : 'No ✗'}`, 'success');

                // Auto-llenar campos para TEST 3
                document.getElementById('rutaId').value = data.data.idRuta;
                if (data.data.paradas?.length > 0) {
                    document.getElementById('paradaId').value = data.data.paradas[0].idParada;
                    log(`💡 Campos de TEST 3 auto-llenados`, 'info');
                }
            } else {
                log(`⚠️ ${data.message || 'No hay ruta activa para este bus'}`, 'warning');
            }
        } catch (error) {
            log(`❌ ERROR: ${error.message}`, 'error');
            mostrarResultado({ error: error.message });
        }
    }

    // TEST 3: Marcar Parada Completada
    async function marcarParada() {
        try {
            const rutaId = document.getElementById('rutaId').value;
            const paradaId = document.getElementById('paradaId').value;
            const completada = document.getElementById('completada').value === 'true';

            if (!rutaId || !paradaId) {
                log('⚠️ Debes ingresar ID de Ruta e ID de Parada', 'warning');
                return;
            }

            log(`✏️ Iniciando TEST 3: Marcar Parada`, 'info');
            log(`   └─ Ruta: ${rutaId}, Parada: ${paradaId}, Completada: ${completada}`, 'info');

            const body = {
                idParada: parseInt(paradaId),
                completada: completada
            };

            const url = `/api/rutas/${rutaId}/parada/${paradaId}/completar`;
            log(`📤 Enviando PUT ${url}`, 'warning');
            log('   └─ Body: ' + JSON.stringify(body), 'info');

            const response = await fetch(url, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(body)
            });

            log(`📥 Respuesta recibida: ${response.status} ${response.statusText}`, response.ok ? 'success' : 'error');

            const data = await response.json();
            mostrarResultado(data);

            if (data.success) {
                log(`✅ ${data.message}`, 'success');
            } else {
                log(`⚠️ ${data.message}`, 'warning');
            }
        } catch (error) {
            log(`❌ ERROR: ${error.message}`, 'error');
            mostrarResultado({ error: error.message });
        }
    }

    // Log inicial
    document.addEventListener('DOMContentLoaded', function() {
        log('🎯 Página de Test API - Rutas cargada', 'success');
        log('📋 Instrucciones:', 'info');
        log('   1️⃣ TEST 1: Calcula una ruta nueva con el algoritmo', 'info');
        log('   2️⃣ TEST 2: Obtiene la ruta activa de un bus', 'info');
        log('   3️⃣ TEST 3: Marca una parada como completada', 'info');
        log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
    });
</script>
}
