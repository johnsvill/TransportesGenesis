                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Estado Tarde -->
        <div class="col-12 col-lg-4">
            <div class="info-card afternoon-card animate__animated animate__fadeInUp" style="animation-delay: 0.3s">
                <div class="card-header text-white">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-sunset-fill me-2"></i>
                        Ruta Vespertina (Regreso)
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-clock-fill text-info me-2"></i>
                            <small class="fw-semibold">Horario de confirmación</small>
                        </div>
                        <div class="bg-light rounded-3 p-3">
                            <div class="fw-bold text-center">
                                5:00 PM - 11:00 AM
                            </div>
                        </div>
                    </div>

                    <div id="estadoTarde" class="alert alert-info mb-0 border-0">
                        <div class="d-flex align-items-center">
