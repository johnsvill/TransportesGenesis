                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-clock-fill text-warning me-2"></i>
                            <small class="fw-semibold">Horario de confirmación</small>
                        </div>
                        <div class="bg-light rounded-3 p-3">
