                            <div>
                                <div class="fw-semibold">Nombre</div>
                                <div class="text-muted" id="nombreAlumno">Juan Pérez Rodríguez</div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-bus-front-fill text-primary me-3 fs-4"></i>
