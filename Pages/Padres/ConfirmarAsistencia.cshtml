@page
@model TransportesGenesis.Pages.Padres.ConfirmarAsistenciaModel
@{
    ViewData["Title"] = "Confirmar Asistencia Mensual";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <h2 class="mb-1">
                        <i class="bi bi-calendar-check"></i> Calendario de Asistencia
                    </h2>
                    <p class="text-muted mb-0">Gestione la asistencia de su hijo(a) al transporte escolar</p>
                </div>
                <a href="/Padres/Traslados" class="btn btn-outline-primary">
                    <i class="bi bi-list-check"></i> Ver Mis Traslados
                </a>
            </div>
            <hr />
        </div>
    </div>

    <!-- Información de horarios y alumno -->
    <div class="row mb-4">
        <!-- Alumno seleccionado -->
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0"><i class="bi bi-person-circle"></i> Alumno</h6>
                </div>
                <div class="card-body">
                    <select class="form-select mb-3" id="selectAlumno" onchange="cargarCalendario()">
                        <option value="1" selected>Alumno de Prueba 1</option>
                    </select>
                    <div id="infoAlumno">
                        <p class="mb-1"><strong>Nombre:</strong> <span id="nombreAlumno">Cargando...</span></p>
                        <p class="mb-1"><strong>Bus:</strong> <span id="busAsignado">Cargando...</span></p>
                        <div id="mensajeFinSemana" class="alert alert-info mt-2" style="display: none;">
                            <i class="bi bi-info-circle"></i> <span id="textoFinSemana"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Estado Mañana -->
        <div class="col-md-4">
            <div class="card h-100 border-warning">
                <div class="card-header bg-warning text-dark">
                    <h6 class="mb-0"><i class="bi bi-sunrise-fill"></i> Ruta Matutina (Ida)</h6>
                </div>
                <div class="card-body">
                    <p class="mb-2"><small><strong>Horario de confirmación:</strong></small></p>
                    <p class="mb-2"><i class="bi bi-clock"></i> <strong>2:00 PM</strong> a <strong>4:00 AM</strong></p>
                    <div id="estadoMañana" class="alert alert-info mb-0">
                        <div class="spinner-border spinner-border-sm"></div> Verificando...
                    </div>
                </div>
            </div>
        </div>

        <!-- Estado Tarde -->
        <div class="col-md-4">
            <div class="card h-100 border-info">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0"><i class="bi bi-sunset-fill"></i> Ruta Vespertina (Regreso)</h6>
                </div>
                <div class="card-body">
                    <p class="mb-2"><small><strong>Horario de confirmación:</strong></small></p>
                    <p class="mb-2"><i class="bi bi-clock"></i> <strong>5:00 PM</strong> a <strong>11:00 AM</strong></p>
                    <div id="estadoTarde" class="alert alert-warning mb-0">
                        <div class="spinner-border spinner-border-sm"></div> Verificando...
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Calendario Mensual -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-calendar3"></i> Calendario del Mes</h5>
                </div>
                <div class="card-body">
                    <!-- Leyenda -->
                    <div class="alert alert-light border mb-3">
                        <div class="row text-center">
                            <div class="col-md-3">
                                <span class="badge badge-lg" style="background-color: #28a745;">✓</span>
                                <small class="d-block">Confirmado ambas rutas</small>
                            </div>
                            <div class="col-md-3">
                                <span class="badge badge-lg" style="background-color: #17a2b8;">½</span>
                                <small class="d-block">Solo una ruta confirmada</small>
                            </div>
                            <div class="col-md-3">
                                <span class="badge badge-lg" style="background-color: #ffc107;">⏰</span>
                                <small class="d-block">Pendiente de confirmar</small>
                            </div>
                            <div class="col-md-3">
                                <span class="badge badge-lg" style="background-color: #dc3545;">✗</span>
                                <small class="d-block">No asistirá</small>
                            </div>
                        </div>
                    </div>

                    <!-- Tabla del calendario -->
                    <div class="table-responsive">
                        <table class="table table-bordered text-center calendario-table" id="calendarioTabla">
                            <thead class="table-light">
                                <tr id="diasSemana">
                                    <th>Dom</th>
                                    <th>Lun</th>
                                    <th>Mar</th>
                                    <th>Mié</th>
                                    <th>Jue</th>
                                    <th>Vie</th>
                                    <th>Sáb</th>
                                </tr>
                            </thead>
                            <tbody id="calendarioBody">
                                <!-- Se llena dinámicamente -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Botones de navegación -->
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <button class="btn btn-outline-secondary" onclick="mesAnterior()">
                            <i class="bi bi-chevron-left"></i> Mes Anterior
                        </button>
                        <h5 id="mesActual" class="mb-0"></h5>
                        <button class="btn btn-outline-secondary" onclick="mesSiguiente()">
                            Mes Siguiente <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Panel de confirmación para día seleccionado -->
    <div class="row mt-4" id="panelConfirmacion" style="display: none;">
        <div class="col-12">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-calendar-check"></i> Confirmar Asistencia - 
                        <span id="fechaSeleccionada"></span>
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-check form-switch mb-4" style="padding-left: 4rem;">
                                <input class="form-check-input form-check-input-xl" 
                                       type="checkbox" 
                                       role="switch"
                                       id="switchMañana" 
                                       checked>
                                <label class="form-check-label ms-3" for="switchMañana" style="cursor: pointer;">
                                    <i class="bi bi-sunrise-fill text-warning fs-4"></i>
                                    <strong class="d-block">Ruta Matutina</strong>
                                    <small class="text-muted">Ida al colegio</small>
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch mb-4" style="padding-left: 4rem;">
                                <input class="form-check-input form-check-input-xl" 
                                       type="checkbox" 
                                       role="switch"
                                       id="switchTarde" 
                                       checked>
                                <label class="form-check-label ms-3" for="switchTarde" style="cursor: pointer;">
                                    <i class="bi bi-sunset-fill text-info fs-4"></i>
                                    <strong class="d-block">Ruta Vespertina</strong>
                                    <small class="text-muted">Regreso a casa</small>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Importante:</strong> Si desmarca una opción, su hijo(a) NO será recogido en esa ruta.
                    </div>

                    <!-- ✅ NUEVO: Indicador de traslado -->
                    <div id="alertaTraslado" class="alert alert-info" style="display: none;">
                        <h6 class="alert-heading">
                            <i class="bi bi-bus-front"></i> Traslado Temporal Activo
                        </h6>
                        <p id="textoTraslado" class="mb-0"></p>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-success btn-lg" onclick="confirmarDia()">
                            <i class="bi bi-check-circle-fill"></i> Confirmar Asistencia para este Día
                        </button>
                        <button type="button" class="btn btn-outline-info" onclick="abrirModalTraslado()">
                            <i class="bi bi-arrow-left-right"></i> Solicitar Traslado de Bus
                        </button>
                        <button type="button" class="btn btn-outline-secondary" onclick="cerrarPanelConfirmacion()">
                            Cancelar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Traslado -->
<div class="modal fade" id="modalTraslado" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">
                    <i class="bi bi-arrow-left-right"></i> Solicitar Traslado Temporal de Bus
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    <strong>¿Qué es un traslado?</strong> Permite que su hijo(a) viaje en otro bus temporalmente 
                    (por ejemplo, si se quedará en casa de un familiar).
                </div>

                <form id="formTraslado">
                    <input type="hidden" id="trasladoIdAlumno" value="1">
                    <input type="hidden" id="trasladoFecha" value="">

                    <div class="mb-3">
                        <label class="form-label"><strong>Fecha del traslado:</strong></label>
                        <p id="trasladoFechaTexto" class="text-muted"></p>
                    </div>

                    <div class="mb-3">
                        <label for="trasladoTurno" class="form-label"><strong>Turno:</strong></label>
                        <select class="form-select" id="trasladoTurno" required onchange="cargarBusesDisponibles()">
                            <option value="Ambos">Ambos (Mañana y Tarde)</option>
                            <option value="Mañana">Solo Mañana (Ida)</option>
                            <option value="Tarde">Solo Tarde (Regreso)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="trasladoBusDestino" class="form-label"><strong>Seleccionar bus destino:</strong></label>
                        <select class="form-select" id="trasladoBusDestino" required>
                            <option value="">-- Cargando buses disponibles --</option>
                        </select>
                        <small class="text-muted">Buses disponibles con espacio</small>
                    </div>

                    <div class="mb-3">
                        <label for="trasladoMotivo" class="form-label"><strong>Motivo del traslado:</strong></label>
                        <textarea class="form-control" id="trasladoMotivo" rows="3" 
                                  placeholder="Ejemplo: Se quedará en casa de su abuela esa semana"
                                  maxlength="250"></textarea>
                        <small class="text-muted">Opcional - máximo 250 caracteres</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-info" onclick="enviarSolicitudTraslado()">
                    <i class="bi bi-send"></i> Enviar Solicitud
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal de éxito -->
<div class="modal fade" id="modalExito" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="bi bi-check-circle-fill"></i> <span id="tituloExito">¡Confirmado!</span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                <h4 class="mt-3" id="subtituloExito">Asistencia Confirmada</h4>
                <div id="mensajeExito" class="text-start mt-3"></div>
            </div>
            <div class="modal-footer" id="botonesExito">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Entendido</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal de error -->
<div class="modal fade" id="modalError" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill"></i> Error</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="mensajeError" class="mb-0"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<script>
    let mesActual = new Date().getMonth();
    let anioActual = new Date().getFullYear();
    let diaSeleccionado = null;
    let puedeConfirmarMañanaGlobal = false;
    let puedeConfirmarTardeGlobal = false;
    let asistenciasDelMes = [];
    let trasladosDelMes = []; // ✅ NUEVO: Almacenar traslados aprobados del mes
    let confirmacionesLocales = {}; // Guardar confirmaciones en memoria

    // Cargar confirmaciones guardadas del localStorage
    function cargarConfirmacionesLocales() {
        try {
            const guardadas = localStorage.getItem('asistenciasConfirmadas');
            if (guardadas) {
                confirmacionesLocales = JSON.parse(guardadas);
            }
        } catch (error) {
            console.log('No hay confirmaciones previas guardadas');
        }
    }

    // Guardar confirmaciones en localStorage
    function guardarConfirmacionLocal(fecha, asisteMañana, asisteTarde) {
        const fechaKey = fecha.toISOString().split('T')[0];
        confirmacionesLocales[fechaKey] = {
            asisteMañana: asisteMañana,
            asisteTarde: asisteTarde,
            fechaConfirmacion: new Date().toISOString()
        };
        localStorage.setItem('asistenciasConfirmadas', JSON.stringify(confirmacionesLocales));
    }

    // Cargar al iniciar
    document.addEventListener('DOMContentLoaded', function() {
        cargarConfirmacionesLocales();
        verificarHorarios();
        cargarInfoAlumno();
        cargarCalendario();
    });

    // Verificar horarios de confirmación
    async function verificarHorarios() {
        try {
            // Mañana: 2:00 PM a 4:00 AM
            const respMañana = await fetch('/api/asistencia/puede-confirmar/manana');
            const dataMañana = await respMañana.json();
            puedeConfirmarMañanaGlobal = dataMañana.puede;

            const estadoMañanaEl = document.getElementById('estadoMañana');
            estadoMañanaEl.className = puedeConfirmarMañanaGlobal 
                ? 'alert alert-success mb-0' 
                : 'alert alert-danger mb-0';
            estadoMañanaEl.innerHTML = `<strong>${puedeConfirmarMañanaGlobal ? '✓ Disponible' : '✗ No disponible'}</strong><br>
                <small>${dataMañana.mensaje}</small>`;

            // Tarde: 5:00 PM a 11:00 AM
            const respTarde = await fetch('/api/asistencia/puede-confirmar/tarde');
            const dataTarde = await respTarde.json();
            puedeConfirmarTardeGlobal = dataTarde.puede;

            const estadoTardeEl = document.getElementById('estadoTarde');
            estadoTardeEl.className = puedeConfirmarTardeGlobal 
                ? 'alert alert-success mb-0' 
                : 'alert alert-danger mb-0';
            estadoTardeEl.innerHTML = `<strong>${puedeConfirmarTardeGlobal ? '✓ Disponible' : '✗ No disponible'}</strong><br>
                <small>${dataTarde.mensaje}</small>`;

        } catch (error) {
            console.error('Error al verificar horarios:', error);
        }
    }

    // Cargar información del alumno
    async function cargarInfoAlumno() {
        const idAlumno = document.getElementById('selectAlumno').value;
        try {
            const response = await fetch(`/api/asistencia/alumno/${idAlumno}/hoy`);
            const data = await response.json();

            document.getElementById('nombreAlumno').textContent = data.nombreCompleto || 'Alumno de Prueba';
            document.getElementById('busAsignado').textContent = data.placaBus || 'Sin asignar';

            // Mostrar mensaje si es fin de semana
            const hoy = new Date();
            const diaSemana = hoy.getDay();
            if (diaSemana === 0 || diaSemana === 6) { // Domingo o Sábado
                const mensajeDiv = document.getElementById('mensajeFinSemana');
                const textoSpan = document.getElementById('textoFinSemana');

                if (diaSemana === 6) {
                    textoSpan.textContent = 'Hoy es sábado. El calendario muestra solo días escolares (L-V).';
                } else {
                    textoSpan.textContent = 'Hoy es domingo. El calendario muestra solo días escolares (L-V).';
                }

                mensajeDiv.style.display = 'block';
            }
        } catch (error) {
            console.error('Error al cargar alumno:', error);
            document.getElementById('nombreAlumno').textContent = 'Alumno de Prueba';
            document.getElementById('busAsignado').textContent = 'BUS-001';
        }
    }

    // Cargar calendario del mes
    async function cargarCalendario() {
        const idAlumno = document.getElementById('selectAlumno').value;

        // Actualizar título del mes
        const nombresMeses = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
                              'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
        document.getElementById('mesActual').textContent = `${nombresMeses[mesActual]} ${anioActual}`;

        // Cargar asistencias del mes desde API
        const primerDia = new Date(anioActual, mesActual, 1);
        const ultimoDia = new Date(anioActual, mesActual + 1, 0);

        try {
            const response = await fetch(
                `/api/asistencia/alumno/${idAlumno}/historial?fechaInicio=${primerDia.toISOString()}&fechaFin=${ultimoDia.toISOString()}`
            );
            asistenciasDelMes = await response.json();
        } catch (error) {
            console.error('Error al cargar asistencias:', error);
            asistenciasDelMes = [];
        }

        // ✅ NUEVO: Cargar traslados aprobados del mes
        try {
            const responseTras = await fetch(`/api/traslados/alumno/${idAlumno}`);
            const todosTras = await responseTras.json();

            console.log(`[CALENDARIO] Total traslados recibidos: ${todosTras.length}`);
            console.log('[CALENDARIO] Mes actual:', mesActual, 'Año actual:', anioActual);

            // Filtrar solo los aprobados del mes actual
            trasladosDelMes = todosTras.filter(t => {
                console.log(`[TRASLADO] ID: ${t.idSolicitud}, Estado: "${t.estado}", Fecha: ${t.fechaTraslado}`);

                if (t.estado.toLowerCase() !== 'aprobado') return false; // Case insensitive

                const fechaTras = new Date(t.fechaTraslado);
                const esDelMes = fechaTras.getFullYear() === anioActual && fechaTras.getMonth() === mesActual;

                console.log(`  -> Año: ${fechaTras.getFullYear()}, Mes: ${fechaTras.getMonth()}, Coincide: ${esDelMes}`);

                return esDelMes;
            });

            console.log(`[CALENDARIO] ✅ Traslados aprobados del mes: ${trasladosDelMes.length}`);
            if (trasladosDelMes.length > 0) {
                console.log('[CALENDARIO] Traslados filtrados:', trasladosDelMes);
            }
        } catch (error) {
            console.error('Error al cargar traslados:', error);
            trasladosDelMes = [];
        }

        // Generar calendario
        generarCalendario();
    }

    // Generar la tabla del calendario
    function generarCalendario() {
        const tbody = document.getElementById('calendarioBody');
        tbody.innerHTML = '';

        const primerDia = new Date(anioActual, mesActual, 1);
        const ultimoDia = new Date(anioActual, mesActual + 1, 0);
        const primerDiaSemana = primerDia.getDay();

        let fecha = 1;
        let filas = Math.ceil((primerDiaSemana + ultimoDia.getDate()) / 7);

        for (let i = 0; i < filas; i++) {
            const fila = document.createElement('tr');

            for (let j = 0; j < 7; j++) {
                const celda = document.createElement('td');
                celda.style.padding = '15px';
                celda.style.cursor = 'pointer';
                celda.style.minWidth = '80px';
                celda.style.height = '80px';
                celda.style.verticalAlign = 'top';

                if (i === 0 && j < primerDiaSemana) {
                    celda.innerHTML = '';
                } else if (fecha > ultimoDia.getDate()) {
                    celda.innerHTML = '';
                } else {
                    const fechaActual = new Date(anioActual, mesActual, fecha);
                    const diaSemana = fechaActual.getDay();

                    // Solo días de lunes a viernes (1-5)
                    if (diaSemana >= 1 && diaSemana <= 5) {
                        const asistencia = buscarAsistencia(fechaActual);
                        const traslado = buscarTraslado(fechaActual); // ✅ NUEVO
                        const color = obtenerColor(asistencia, fechaActual);
                        const icono = obtenerIcono(asistencia);

                        celda.style.backgroundColor = color;
                        celda.style.color = (color === '#28a745' || color === '#dc3545' || color === '#17a2b8') ? 'white' : 'black';

                        // ✅ NUEVO: Agregar borde si hay traslado aprobado
                        if (traslado) {
                            celda.style.border = '3px solid #ff9800'; // Borde naranja
                            celda.style.boxShadow = '0 0 8px rgba(255, 152, 0, 0.5)';
                            celda.title = `Traslado aprobado a ${traslado.placaBusDestino || 'bus temporal'}`; // Tooltip
                        }

                        // ✅ NUEVO: Agregar icono de bus si hay traslado
                        const iconoTraslado = traslado ? '<div style="font-size: 0.9em;">🚌</div>' : '';

                        celda.innerHTML = `
                            <div class="fw-bold">${fecha}</div>
                            <div class="mt-1">${icono}</div>
                            ${iconoTraslado}
                        `;

                        const fechaClick = new Date(fechaActual);
                        celda.onclick = () => seleccionarDia(fechaClick);
                    } else {
                        // Fines de semana en gris
                        celda.style.backgroundColor = '#e9ecef';
                        celda.innerHTML = `<div class="text-muted">${fecha}</div>`;
                    }

                    fecha++;
                }

                fila.appendChild(celda);
            }

            tbody.appendChild(fila);
        }
    }

    // ✅ NUEVO: Buscar traslado aprobado para una fecha
    function buscarTraslado(fecha) {
        return trasladosDelMes.find(t => {
            const fechaTras = new Date(t.fechaTraslado);
            return fechaTras.toDateString() === fecha.toDateString();
        });
    }

    // Buscar asistencia para una fecha (incluir confirmaciones locales)
    function buscarAsistencia(fecha) {
        // Primero buscar en confirmaciones locales
        const fechaKey = fecha.toISOString().split('T')[0];
        if (confirmacionesLocales[fechaKey]) {
            return {
                fecha: fecha,
                asisteMañana: confirmacionesLocales[fechaKey].asisteMañana,
                asisteTarde: confirmacionesLocales[fechaKey].asisteTarde,
                fechaConfirmacion: confirmacionesLocales[fechaKey].fechaConfirmacion
            };
        }

        // Si no, buscar en datos del servidor
        return asistenciasDelMes.find(a => {
            const fechaAsist = new Date(a.fecha);
            return fechaAsist.toDateString() === fecha.toDateString();
        });
    }

    // Obtener color según estado
    function obtenerColor(asistencia, fecha) {
        const hoy = new Date();
        hoy.setHours(0, 0, 0, 0);
        fecha.setHours(0, 0, 0, 0);

        if (!asistencia) {
            // Sin asistencia registrada
            if (fecha < hoy) return '#e9ecef'; // Pasado sin confirmar
            if (fecha.toDateString() === hoy.toDateString()) return '#ffc107'; // Hoy pendiente
            return '#28a745'; // Futuro (por default confirmado)
        }

        // Con asistencia registrada
        if (asistencia.asisteMañana && asistencia.asisteTarde) return '#28a745'; // Verde - ambas rutas
        if (asistencia.asisteMañana || asistencia.asisteTarde) return '#17a2b8'; // Azul - una ruta
        return '#dc3545'; // Rojo - no asiste
    }

    // Obtener icono según estado
    function obtenerIcono(asistencia) {
        // Si no hay asistencia registrada
        if (!asistencia) {
            return '✓'; // Check simple por defecto
        }

        // Si hay asistencia registrada
        if (asistencia.asisteMañana && asistencia.asisteTarde) {
            return '✓'; // Ambas rutas confirmadas
        }
        if (asistencia.asisteMañana && !asistencia.asisteTarde) {
            return '🌅'; // Solo mañana
        }
        if (!asistencia.asisteMañana && asistencia.asisteTarde) {
            return '🌆'; // Solo tarde
        }

        // No asiste a ninguna
        return '✗';
    }

    // Seleccionar un día del calendario
    function seleccionarDia(fecha) {
        diaSeleccionado = fecha;
        const asistencia = buscarAsistencia(fecha);
        const traslado = buscarTraslado(fecha); // ✅ NUEVO

        // Formatear fecha
        const opciones = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        document.getElementById('fechaSeleccionada').textContent = fecha.toLocaleDateString('es-ES', opciones);

        // Cargar valores actuales
        document.getElementById('switchMañana').checked = asistencia ? asistencia.asisteMañana : true;
        document.getElementById('switchTarde').checked = asistencia ? asistencia.asisteTarde : true;

        // Habilitar/deshabilitar según horarios
        const hoy = new Date();
        const esFuturo = fecha > hoy;

        document.getElementById('switchMañana').disabled = !puedeConfirmarMañanaGlobal && !esFuturo;
        document.getElementById('switchTarde').disabled = !puedeConfirmarTardeGlobal && !esFuturo;

        // ✅ NUEVO: Mostrar alerta si hay traslado aprobado
        const alertaTraslado = document.getElementById('alertaTraslado');
        const textoTraslado = document.getElementById('textoTraslado');

        if (traslado) {
            alertaTraslado.style.display = 'block';
            const turnoTexto = traslado.turno === 'Ambos' ? 'ambas rutas' : 
                              traslado.turno === 'Mañana' ? 'ruta matutina' : 'ruta vespertina';
            textoTraslado.innerHTML = `
                <strong>Este día tiene un traslado aprobado:</strong><br>
                🚌 Bus temporal: <strong>${traslado.placaBusDestino || 'N/A'}</strong><br>
                ⏰ Turno: <strong>${turnoTexto}</strong><br>
                ${traslado.motivo ? `📝 Motivo: ${traslado.motivo}` : ''}
            `;
        } else {
            alertaTraslado.style.display = 'none';
        }

        // Mostrar panel
        document.getElementById('panelConfirmacion').style.display = 'block';
        document.getElementById('panelConfirmacion').scrollIntoView({ behavior: 'smooth' });
    }

    // Confirmar asistencia para el día seleccionado
    async function confirmarDia() {
        if (!diaSeleccionado) return;

        const idAlumno = document.getElementById('selectAlumno').value;
        const asisteMañana = document.getElementById('switchMañana').checked;
        const asisteTarde = document.getElementById('switchTarde').checked;

        // El padre PUEDE cancelar ambas rutas (no asiste ese día)
        // Ya no validamos que al menos una esté marcada

        const dto = {
            idAlumno: parseInt(idAlumno),
            fecha: diaSeleccionado.toISOString(),
            asisteMañana: asisteMañana,
            asisteTarde: asisteTarde
        };

        try {
            const response = await fetch('/api/asistencia/confirmar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(dto)
            });

            const result = await response.json();

            if (result.success) {
                // Guardar confirmación localmente
                guardarConfirmacionLocal(diaSeleccionado, asisteMañana, asisteTarde);

                const mensaje = `
                    Confirmado para ${diaSeleccionado.toLocaleDateString('es-ES')}:<br>
                    ${asisteMañana ? '✅ Ruta Matutina' : '❌ NO viajará en la mañana'}<br>
                    ${asisteTarde ? '✅ Ruta Vespertina' : '❌ NO viajará en la tarde'}
                `;
                mostrarExito(mensaje);
                cerrarPanelConfirmacion();
                cargarCalendario();
            } else {
                mostrarError(result.message);
            }
        } catch (error) {
            console.error('Error:', error);
            mostrarError('Error de conexión. Intente nuevamente.');
        }
    }

    // Cerrar panel de confirmación
    function cerrarPanelConfirmacion() {
        document.getElementById('panelConfirmacion').style.display = 'none';
        diaSeleccionado = null;
    }

    // Navegar al mes anterior
    function mesAnterior() {
        mesActual--;
        if (mesActual < 0) {
            mesActual = 11;
            anioActual--;
        }
        cargarCalendario();
    }

    // Navegar al mes siguiente
    function mesSiguiente() {
        mesActual++;
        if (mesActual > 11) {
            mesActual = 0;
            anioActual++;
        }
        cargarCalendario();
    }

    // Mostrar modal de éxito
    function mostrarExito(mensaje, esTraslado = false) {
        document.getElementById('mensajeExito').innerHTML = mensaje;

        if (esTraslado) {
            // Cambiar título para traslados
            document.getElementById('tituloExito').textContent = 'Solicitud Enviada';
            document.getElementById('subtituloExito').textContent = 'Traslado Temporal';

            // Agregar botón para ver historial
            document.getElementById('botonesExito').innerHTML = `
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <a href="/Padres/Traslados" class="btn btn-primary">
                    <i class="bi bi-list-check"></i> Ver Historial de Traslados
                </a>
            `;
        } else {
            // Restaurar valores por defecto para confirmaciones
            document.getElementById('tituloExito').textContent = '¡Confirmado!';
            document.getElementById('subtituloExito').textContent = 'Asistencia Confirmada';
            document.getElementById('botonesExito').innerHTML = `
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Entendido</button>
            `;
        }

        new bootstrap.Modal(document.getElementById('modalExito')).show();
    }

    // Mostrar modal de error
    function mostrarError(mensaje) {
        document.getElementById('mensajeError').textContent = mensaje;
        new bootstrap.Modal(document.getElementById('modalError')).show();
    }

    // ========================================
    // FUNCIONES PARA TRASLADOS
    // ========================================

    // Abrir modal de traslado
    function abrirModalTraslado() {
        if (!diaSeleccionado) {
            mostrarError('Debe seleccionar un día del calendario primero');
            return;
        }

        // Configurar fecha en el modal
        document.getElementById('trasladoFecha').value = diaSeleccionado.toISOString();
        document.getElementById('trasladoFechaTexto').textContent = diaSeleccionado.toLocaleDateString('es-ES', {
            weekday: 'long',
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        });

        // Cargar buses disponibles
        cargarBusesDisponibles();

        // Abrir modal
        new bootstrap.Modal(document.getElementById('modalTraslado')).show();
    }

    // Cargar buses disponibles
    async function cargarBusesDisponibles() {
        const turno = document.getElementById('trasladoTurno').value;
        const fecha = diaSeleccionado.toISOString();

        try {
            const response = await fetch(`/api/traslados/buses-disponibles?fecha=${fecha}&turno=${turno}`);
            const buses = await response.json();

            const select = document.getElementById('trasladoBusDestino');
            select.innerHTML = '<option value="">-- Seleccione un bus --</option>';

            buses.forEach(bus => {
                const option = document.createElement('option');
                option.value = bus.idBus;
                option.textContent = `${bus.placa} - ${bus.modelo} (${bus.asientosDisponibles}/${bus.capacidad} disponibles)`;
                select.appendChild(option);
            });
        } catch (error) {
            console.error('Error al cargar buses:', error);
            mostrarError('No se pudieron cargar los buses disponibles');
        }
    }

    // Enviar solicitud de traslado
    async function enviarSolicitudTraslado() {
        const idAlumno = document.getElementById('trasladoIdAlumno').value;
        const fecha = document.getElementById('trasladoFecha').value;
        const turno = document.getElementById('trasladoTurno').value;
        const idBusDestino = document.getElementById('trasladoBusDestino').value;
        const motivo = document.getElementById('trasladoMotivo').value;

        // Validaciones
        if (!idBusDestino) {
            mostrarError('Debe seleccionar un bus destino');
            return;
        }

        const dto = {
            idAlumno: parseInt(idAlumno),
            fechaTraslado: fecha,
            turno: turno,
            idBusDestino: parseInt(idBusDestino),
            motivo: motivo || null
        };

        try {
            const response = await fetch('/api/traslados', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(dto)
            });

            const result = await response.json();

            if (result.success) {
                // Cerrar modal de traslado
                bootstrap.Modal.getInstance(document.getElementById('modalTraslado')).hide();

                // Obtener información para mostrar
                const busTexto = document.getElementById('trasladoBusDestino').selectedOptions[0].text;
                const fechaTexto = diaSeleccionado.toLocaleDateString('es-ES', { 
                    weekday: 'long', 
                    day: 'numeric', 
                    month: 'long', 
                    year: 'numeric' 
                });

                // Mostrar éxito con detalles completos
                mostrarExito(`
                    <div class="alert alert-success mb-3">
                        <i class="bi bi-check-circle-fill"></i>
                        <strong> Solicitud creada exitosamente</strong>
                    </div>

                    <div class="mb-3">
                        <h6 class="text-primary mb-3"><i class="bi bi-info-circle"></i> Detalles de la Solicitud:</h6>

                        <table class="table table-sm table-borderless">
                            <tr>
                                <td class="text-muted" style="width: 40%;"><strong>Fecha del traslado:</strong></td>
                                <td>${fechaTexto}</td>
                            </tr>
                            <tr>
                                <td class="text-muted"><strong>Turno:</strong></td>
                                <td><span class="badge bg-info">${turno}</span></td>
                            </tr>
                            <tr>
                                <td class="text-muted"><strong>Bus solicitado:</strong></td>
                                <td><span class="badge bg-secondary">${busTexto}</span></td>
                            </tr>
                            <tr>
                                <td class="text-muted"><strong>Estado:</strong></td>
                                <td><span class="badge bg-warning text-dark"><i class="bi bi-clock"></i> Pendiente</span></td>
                            </tr>
                        </table>
                    </div>

                    <div class="alert alert-info mb-0">
                        <i class="bi bi-bell"></i> 
                        <small>Recibirá una notificación cuando el administrador revise su solicitud.</small>
                    </div>
                `, true); // true = es un traslado

                // Recargar calendario
                cargarCalendario();
            } else {
                mostrarError(result.message);
            }
        } catch (error) {
            console.error('Error al enviar solicitud:', error);
            mostrarError('Error al enviar la solicitud. Intente nuevamente.');
        }
    }

</script>

