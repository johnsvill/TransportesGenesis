@page
@model TransportesGenesis.Pages.Padres.DashboardRutaBusAsignadoModel
@using System.Text.Json
@{
    ViewData["Title"] = "Ruta Bus Asignado";
    Layout = "~/Pages/Shared/_Layout.cshtml";

    // Serializar datos del servidor para el JS
    var casaLatStr  = Model.CasaLatitud.HasValue  ? Model.CasaLatitud.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)  : "null";
    var casaLngStr  = Model.CasaLongitud.HasValue ? Model.CasaLongitud.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null";
    var coleLatStr  = Model.ColegioLatitud.ToString(System.Globalization.CultureInfo.InvariantCulture);
    var coleLngStr  = Model.ColegioLongitud.ToString(System.Globalization.CultureInfo.InvariantCulture);
    var idsAlumnos  = JsonSerializer.Serialize(Model.IdsAlumnos);
}

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
    #mapa {
        height: 65vh;
        min-height: 450px;
        border-radius: 8px;
        box-shadow: 0 2px 10px rgba(0,0,0,.1);
    }
    .ruta-header {
        background: linear-gradient(135deg, #007bff 0%, #6610f2 100%);
        color: white;
        border-radius: 10px 10px 0 0;
        padding: 15px;
        box-shadow: 0 4px 12px rgba(0,123,255,.3);
    }
    .alerta-panel { max-height: 280px; overflow-y: auto; }
    .alerta-item {
        border-left: 4px solid #17a2b8;
        margin-bottom: 8px;
        padding: 8px 12px;
        background: #f8f9fa;
        border-radius: 4px;
        font-size: .875rem;
    }
    .alerta-item.alerta-success { border-left-color: #28a745; background: #f0fff4; }
    .alerta-item.alerta-warning { border-left-color: #ffc107; background: #fffdf0; }
    .alerta-item.alerta-danger  { border-left-color: #dc3545; background: #fff5f5; }
    .alerta-item.alerta-info    { border-left-color: #17a2b8; }
    .alerta-item.alerta-hijo    { border-left-color: #0dcaf0; background: #e3f7fc; color: #055160; }
    .marcador-hijo-pendiente {
        animation: pulso-hijo 1.8s ease-in-out infinite;
    }
    @@keyframes pulso-hijo {
        0%, 100% { box-shadow: 0 0 0 0 rgba(255, 193, 7, .6); }
        50%      { box-shadow: 0 0 0 10px rgba(255, 193, 7, 0); }
    }
</style>

<div class="container-fluid">

    <!-- ── HEADER ──────────────────────────────────────────────────────────── -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="ruta-header">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h4 class="mb-1">
                            <i class="bi bi-map-fill me-2"></i>Ruta en Tiempo Real
                        </h4>
                        <p class="mb-0 opacity-75 small">
                            <i class="bi bi-person-circle me-1"></i>
                            <strong>@(!string.IsNullOrEmpty(Model.PadreNombre) ? Model.PadreNombre : User.Identity?.Name)</strong>
                            &nbsp;&middot;&nbsp;
                            <i class="bi bi-person-badge me-1"></i> @Model.NombreHijo
                            &nbsp;&middot;&nbsp;
                            @DateTime.Now.ToString("dddd, d 'de' MMMM", new System.Globalization.CultureInfo("es-ES"))
                        </p>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span id="estadoSignalR" class="badge bg-secondary fs-6">
                            <i class="bi bi-wifi-off"></i> Conectando...
                        </span>
                        <span class="badge bg-info fs-6">
                            <i class="bi bi-bus-front"></i>
                            Bus #@Model.IdBusAsignado — @Model.PlacaBus
                        </span>
                        <span id="badgeTurnoActivo" class="badge @(Model.TipoRutaActiva == "Mañana" ? "bg-warning text-dark" : "bg-orange fs-6") fs-6" style="@(Model.TipoRutaActiva == "Tarde" ? "background:#fd7e14" : "")">
                            <i class="bi bi-@(Model.TipoRutaActiva == "Mañana" ? "sunrise" : "sunset")"></i>
                            Turno @Model.TipoRutaActiva
                        </span>
                        <span class="badge bg-light text-dark fs-6">
                            <i class="bi bi-person-fill me-1"></i>@Model.NombrePiloto
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12">
            <div class="alert alert-info py-2 mb-0 small d-flex align-items-start gap-2">
                <i class="bi bi-info-circle-fill mt-1"></i>
                <div id="infoTurnoActivo">
                    <strong>Turno @Model.TipoRutaActiva activo</strong> (automático según la hora; demo Mañana:
                    <a href="?turno=Mañana">?turno=Mañana</a> · Tarde: <a href="?turno=Tarde">?turno=Tarde</a>)
                    <br>@if (Model.TipoRutaActiva == "Mañana") {
                        <text>Mañana: inicia en casas de Diego/Sofía → termina en el colegio.</text>
                    } else {
                        <text>Tarde: inicia en el colegio → termina en casas de Diego/Sofía.</text>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">

        <!-- ── MAPA ────────────────────────────────────────────────────────── -->
        <div class="col-12 col-xl-8">
            <div class="card h-100">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-geo-alt-fill me-1"></i> Mapa del Recorrido — <span id="lblRutaNombre">@Model.RutaNombre</span></span>
                    <small class="opacity-75 d-none d-md-inline ms-2">
                        <span style="color:#2563eb">━</span> pendiente &nbsp;
                        <span style="color:#28a745">━</span> recorrido &nbsp;
                        <span class="badge bg-warning text-dark">👤</span> tus hijos
                        · Mañana: verde → colegio · Tarde: verde colegio → tus hijos
                    </small>
                    <div class="d-flex gap-2">
                        <button onclick="centrarEnBus()" class="btn btn-sm btn-light" title="Centrar en bus">
                            <i class="bi bi-crosshair"></i>
                        </button>
                        <button onclick="verRutaCompleta()" class="btn btn-sm btn-light" title="Ver ruta completa">
                            <i class="bi bi-zoom-out"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div id="mapa"></div>
                </div>
            </div>
        </div>

        <!-- ── PANEL LATERAL ───────────────────────────────────────────────── -->
        <div class="col-12 col-xl-4 d-flex flex-column gap-3">

            <!-- Información del bus -->
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-bus-front-fill me-1"></i> Bus Asignado
                </div>
                <div class="card-body">
                    <table class="table table-sm table-borderless mb-0">
                        <tr><th>Bus</th><td>Bus #@Model.IdBusAsignado — @Model.PlacaBus</td></tr>
                        <tr><th>Piloto</th><td>@Model.NombrePiloto</td></tr>
                        <tr><th>Ruta</th><td>@Model.RutaNombre</td></tr>
                        <tr><th>Alumno(s)</th><td>@Model.NombreHijo</td></tr>
                        @if (Model.HorarioMañana != "—")
                        {
                            <tr><th>Mañana</th><td>@Model.HorarioMañana</td></tr>
                        }
                        @if (Model.HorarioTarde != "—")
                        {
                            <tr><th>Tarde</th><td>@Model.HorarioTarde</td></tr>
                        }
                    </table>
                </div>
            </div>

            <!-- [FALLBACK - FASE 0.1] Simulación local — plan B si falla la sincronización en vivo -->
            <div class="card border-secondary">
                <div class="card-header bg-secondary text-white">
                    <i class="bi bi-shield-exclamation me-1"></i> Respaldo — Simulación Local
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-2" id="estadoSimulacion">
                        Por defecto verás el bus en vivo. Si no hay señal, usa este botón.
                    </p>
                    <button id="btnSimular" onclick="simularRuta()" class="btn btn-outline-primary w-100">
                        <i class="bi bi-play-circle-fill me-2"></i>Iniciar Simulación (Plan B)
                    </button>
                </div>
            </div>

            <!-- Panel de alertas -->
            <div class="card flex-grow-1">
                <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                    <span>
                        <i class="bi bi-bell-fill me-1"></i> Alertas en Tiempo Real
                        <span id="contadorAlertas" class="badge bg-danger ms-1 d-none">0</span>
                    </span>
                    <button onclick="limpiarAlertas()" class="btn btn-sm btn-outline-dark">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
                <div class="card-body alerta-panel" id="panelAlertas">
                    <p class="text-muted small mb-0" id="sinAlertas">
                        <i class="bi bi-info-circle me-1"></i> Sin alertas recientes
                    </p>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    <script src="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.js"></script>

    <script>
        // ══════════════════════════════════════════════════════════════════════
        // DATOS INYECTADOS DESDE EL SERVIDOR — todo dinámico, sin hardcodeo
        // ══════════════════════════════════════════════════════════════════════
        const ID_BUS         = @Model.IdBusAsignado;
        const IDS_ALUMNOS    = @Html.Raw(idsAlumnos);       // [1,2,...]
        const CASA_LAT       = @Html.Raw(casaLatStr);        // null si no hay
        const CASA_LNG       = @Html.Raw(casaLngStr);
        const COLEGIO_LAT    = @Html.Raw(coleLatStr);        // última parada o fallback
        const COLEGIO_LNG    = @Html.Raw(coleLngStr);
        const TIPO_RUTA      = '@Model.TipoRutaActiva';
        // [FASE 0.2] Segmento Plan B (fallback) y ruta completa del bus (en vivo)
        const PARADAS_BD     = @Html.Raw(Model.ParadasJson);
        const PARADAS_HIJOS  = @Html.Raw(Model.ParadasHijosJson);

        // Estado mutable: se actualiza vía SignalR cuando el monitor genera ruta demo
        let tipoRutaActivo     = TIPO_RUTA;
        let rutaCompletaActiva = @Html.Raw(Model.RutaCompletaJson);
        let colegioLat         = COLEGIO_LAT;
        let colegioLng         = COLEGIO_LNG;

        // ── [EN VIVO - FASE 0.1] Modo principal: sincronización piloto → servidor → padre ──
        let modoVisualizacion   = 'vivo';   // 'vivo' | 'fallback'
        let signalRConectado    = false;
        let ultimaUbicacionVivo = null;
        const TIMEOUT_SIN_DATOS_MS = 30000;

        // ── Variables del mapa ────────────────────────────────────────────────
        let mapa;
        let busMarker           = null;   // [EN VIVO] marcador verde
        let routeSegmentosVivo  = [];     // segmentos azul/verde (ruta completa en vivo)
        let routePolylineFallback = null; // línea naranja punteada (solo Plan B)
        let marcadoresHijos     = {};     // idAlumno|idParada → L.marker
        const paradasVisitadas  = new Set(); // idParada visitados

        // ── [FALLBACK - FASE 0.1] Simulación local del padre (plan B) ─────────
        let simMarker      = null;
        let simActiva      = false;
        let simPuntos      = [];

        // ── Flags de notificación (evitar duplicados por sesión) ──────────────
        let notifProximo   = false;
        let notifColegio   = false;
        let notifEntregaHijos = false;
        let contadorAlertas = 0;

        // ════════════════════════════════════════════════════════════════════
        // INICIO
        // ════════════════════════════════════════════════════════════════════
        document.addEventListener('DOMContentLoaded', async () => {
            inicializarMapa();
            dibujarMarcadoresFijos();
            await dibujarRutaVivoCompleta();
            await conectarSignalR();
        });

        // ── Mapa ──────────────────────────────────────────────────────────────
        function inicializarMapa() {
            mapa = L.map('mapa').setView([colegioLat, colegioLng], 13);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors', maxZoom: 19
            }).addTo(mapa);
        }

        function iconoCirculo(emoji, color, sz) {
            sz = sz || 38;
            return L.divIcon({
                className: '',
                html: `<div style="width:${sz}px;height:${sz}px;border-radius:50%;background:${color};border:3px solid white;display:flex;align-items:center;justify-content:center;font-size:${Math.round(sz*.55)}px;box-shadow:0 2px 8px rgba(0,0,0,.3)">${emoji}</div>`,
                iconSize: [sz,sz], iconAnchor: [sz/2,sz/2], popupAnchor: [0,-sz/2]
            });
        }

        function dibujarMarcadoresFijos() {
            // Colegio
            L.marker([colegioLat, colegioLng], { icon: iconoCirculo('🏫','#6f42c1', 46) })
             .addTo(mapa)
             .bindPopup('<strong>🏫 Colegio</strong>');

            // Solo paradas/casas de los hijos de este padre (Diego, Sofía, etc.)
            PARADAS_HIJOS.forEach((p) => {
                const key = p.idParada ?? `casa_${p.idAlumno}`;
                const esCasa = p.esCasa === true;
                const visitado = p.idParada && paradasVisitadas.has(p.idParada);
                const color = visitado ? '#28a745' : (esCasa ? '#0069d9' : '#ffc107');
                const emoji = visitado ? '✓' : (esCasa ? '🏠' : '👤');
                const sz = esCasa ? 38 : 42;

                const html = visitado
                    ? `<div style="width:${sz}px;height:${sz}px;border-radius:50%;background:${color};border:3px solid white;display:flex;align-items:center;justify-content:center;color:white;font-size:${Math.round(sz*.45)}px;font-weight:bold;box-shadow:0 2px 8px rgba(0,0,0,.3)">${emoji}</div>`
                    : `<div class="${visitado ? '' : 'marcador-hijo-pendiente'}" style="width:${sz}px;height:${sz}px;border-radius:50%;background:${color};border:3px solid white;display:flex;align-items:center;justify-content:center;color:${esCasa ? 'white' : '#333'};font-size:${Math.round(sz*.4)}px;font-weight:bold;box-shadow:0 2px 8px rgba(0,0,0,.3)">${emoji}</div>`;

                const m = L.marker([p.lat, p.lng], {
                    icon: L.divIcon({ className: '', html, iconSize: [sz, sz], iconAnchor: [sz/2, sz/2], popupAnchor: [0, -sz/2] })
                }).addTo(mapa).bindPopup(`<strong>${esCasa ? '🏠' : '🚏'} ${p.nombre}</strong>${visitado ? '<br><span class="badge bg-success">Recogido / visitado</span>' : '<br><span class="badge bg-warning text-dark">Pendiente</span>'}`);

                marcadoresHijos[key] = { marker: m, parada: p };
            });
        }

        function actualizarMarcadorHijo(key, visitado) {
            const item = marcadoresHijos[key];
            if (!item) return;
            const p = item.parada;
            const esCasa = p.esCasa === true;
            const color = visitado ? '#28a745' : (esCasa ? '#0069d9' : '#ffc107');
            const emoji = visitado ? '✓' : (esCasa ? '🏠' : '👤');
            const sz = esCasa ? 38 : 42;
            item.marker.setIcon(L.divIcon({
                className: '',
                html: `<div style="width:${sz}px;height:${sz}px;border-radius:50%;background:${color};border:3px solid white;display:flex;align-items:center;justify-content:center;color:white;font-size:${Math.round(sz*.45)}px;font-weight:bold;box-shadow:0 2px 8px rgba(0,0,0,.3)">${emoji}</div>`,
                iconSize: [sz, sz], iconAnchor: [sz/2, sz/2], popupAnchor: [0, -sz/2]
            }));
            item.marker.setPopupContent(`<strong>${esCasa ? '🏠' : '🚏'} ${p.nombre}</strong><br><span class="badge bg-success">Recogido / visitado</span>`);
        }

        async function dibujarRutaVivoCompleta() {
            if (!rutaCompletaActiva.length || modoVisualizacion !== 'vivo') return;

            limpiarSegmentosVivo();
            const puntosRuta = [];

            for (let i = 0; i < rutaCompletaActiva.length - 1; i++) {
                const desde = rutaCompletaActiva[i];
                const hasta = rutaCompletaActiva[i + 1];
                const coords = await segmentoOSRM([desde.lat, desde.lng], [hasta.lat, hasta.lng]);
                puntosRuta.push(...coords);

                const idParadaDestino = hasta.idParada ?? null;
                const visitado = idParadaDestino && paradasVisitadas.has(idParadaDestino);
                const poly = L.polyline(coords, {
                    color: visitado ? '#28a745' : '#2563eb',
                    weight: visitado ? 6 : 5,
                    opacity: .9,
                    lineJoin: 'round',
                    lineCap: 'round'
                }).addTo(mapa);

                routeSegmentosVivo.push({
                    poly, idParadaDestino, indice: i + 1,
                    ordenDestino: hasta.orden ?? (i + 2),
                    esColegioDestino: hasta.esColegio === true
                });
            }

            if (puntosRuta.length) {
                mapa.fitBounds(L.latLngBounds(puntosRuta).pad(.1));
                console.log(`[PadreDashboard] Ruta en vivo: ${routeSegmentosVivo.length} segmentos, ${puntosRuta.length} pts`);
            }
        }

        function limpiarSegmentosVivo() {
            routeSegmentosVivo.forEach(s => mapa.removeLayer(s.poly));
            routeSegmentosVivo = [];
        }

        function ocultarRutaVivo() {
            routeSegmentosVivo.forEach(s => mapa.removeLayer(s.poly));
        }

        function mostrarRutaVivo() {
            routeSegmentosVivo.forEach(s => mapa.addLayer(s.poly));
        }

        function getOrdenColegio() {
            const c = rutaCompletaActiva.find(p => p.esColegio);
            return c?.orden ?? Math.max(...rutaCompletaActiva.map(p => p.orden ?? 0), 0);
        }

        function getOrdenesHijosEnRuta() {
            return PARADAS_HIJOS
                .filter(p => p.idParada)
                .map(p => rutaCompletaActiva.find(r => r.idParada === p.idParada)?.orden ?? 0)
                .filter(o => o > 0);
        }

        function getMaxOrdenVisitado() {
            let maxO = 0;
            rutaCompletaActiva.forEach(p => {
                if (p.idParada && paradasVisitadas.has(p.idParada))
                    maxO = Math.max(maxO, p.orden ?? 0);
            });
            return maxO;
        }

        /** Progreso del bus sobre la ruta (por cercanía GPS) */
        function getOrdenProgresoBus(lat, lng) {
            let maxO = 0;
            rutaCompletaActiva.forEach(p => {
                if (distM([lat, lng], [p.lat, p.lng]) <= 220)
                    maxO = Math.max(maxO, p.orden ?? 0);
            });
            return maxO;
        }

        /**
         * Mañana: verde desde inicio → colegio (según avance del bus).
         * Tarde: verde desde colegio → última parada de los hijos de este padre.
         */
        function actualizarColoresSegmentos(lat, lng) {
            const ordenColegio   = getOrdenColegio();
            const ordenesHijos   = getOrdenesHijosEnRuta();
            const maxOrdenHijo   = ordenesHijos.length ? Math.max(...ordenesHijos) : ordenColegio;
            const visitado       = getMaxOrdenVisitado();
            const progresoBus    = (lat != null && lng != null) ? getOrdenProgresoBus(lat, lng) : 0;
            const progreso       = Math.max(visitado, progresoBus);

            const esMañana = tipoRutaActivo === 'Mañana' || tipoRutaActivo.toLowerCase().includes('mañana') || tipoRutaActivo.toLowerCase().includes('manana');

            routeSegmentosVivo.forEach(seg => {
                const ord = seg.ordenDestino ?? 0;
                let verde = false;

                if (esMañana) {
                    // Hasta el colegio, según avance real del bus
                    verde = ord <= ordenColegio && ord <= progreso;
                } else {
                    // Desde colegio (parada 1) hasta dejar a los hijos de este padre
                    verde = ord <= maxOrdenHijo && ord <= progreso;
                }

                seg.poly.setStyle({
                    color: verde ? '#28a745' : '#2563eb',
                    weight: verde ? 6 : 5
                });
            });
        }

        function marcarParadaVisitada(idParada, idAlumno) {
            if (idParada) {
                if (paradasVisitadas.has(idParada)) return;
                paradasVisitadas.add(idParada);
                if (marcadoresHijos[idParada])
                    actualizarMarcadorHijo(idParada, true);
            }
            if (idAlumno) {
                Object.entries(marcadoresHijos).forEach(([key, item]) => {
                    if (item.parada.idAlumno === idAlumno)
                        actualizarMarcadorHijo(key, true);
                });
            }
            actualizarColoresSegmentos(
                ultimaUbicacionVivo?.[0] ?? null,
                ultimaUbicacionVivo?.[1] ?? null
            );
        }

        function esTurnoMañanaPadre() {
            return tipoRutaActivo === 'Mañana'
                || tipoRutaActivo.toLowerCase().includes('mañana')
                || tipoRutaActivo.toLowerCase().includes('manana');
        }

        /** Sincroniza posición de marcadores Diego/Sofía con la ruta recibida del monitor */
        function actualizarMarcadoresHijosDesdeRuta() {
            rutaCompletaActiva.forEach(p => {
                if (p.esColegio) return;
                const esHijo = (p.idAlumno && IDS_ALUMNOS.includes(parseInt(p.idAlumno)))
                    || /diego|sof[ií]a/i.test(p.nombre || '');
                if (!esHijo) return;

                let actualizado = false;
                Object.entries(marcadoresHijos).forEach(([key, item]) => {
                    const matchId = p.idAlumno && item.parada.idAlumno === parseInt(p.idAlumno);
                    const matchNombre = !p.idAlumno && item.parada.nombre
                        && (p.nombre || '').toLowerCase().includes(
                            item.parada.nombre.replace(/^Casa — |^Parada — /, '').split(' ')[0].toLowerCase()
                        );
                    if (!matchId && !matchNombre) return;

                    item.parada.lat = p.lat;
                    item.parada.lng = p.lng;
                    item.parada.nombre = p.nombre;
                    item.marker.setLatLng([p.lat, p.lng]);
                    const visitado = p.idParada && paradasVisitadas.has(p.idParada);
                    item.marker.setPopupContent(
                        `<strong>🚏 ${p.nombre}</strong>${visitado
                            ? '<br><span class="badge bg-success">Recogido / visitado</span>'
                            : '<br><span class="badge bg-warning text-dark">Pendiente</span>'}`
                    );
                    actualizado = true;
                });
                if (!actualizado && p.idAlumno) {
                    const key = p.idParada ?? `sync_${p.idAlumno}`;
                    if (!marcadoresHijos[key]) {
                        const m = L.marker([p.lat, p.lng], { icon: iconoCirculo('👤', '#ffc107', 42) })
                            .addTo(mapa)
                            .bindPopup(`<strong>🚏 ${p.nombre}</strong>`);
                        marcadoresHijos[key] = { marker: m, parada: { ...p, esCasa: false } };
                    }
                }
            });
        }

        function detectarParadasCercanas(lat, lng) {
            const UMBRAL_M = 180;
            // Usar coordenadas de la ruta sincronizada (incluye Sofía en tía Z9)
            rutaCompletaActiva.forEach(p => {
                if (p.esColegio) return;
                const esMiHijo = (p.idAlumno && IDS_ALUMNOS.includes(parseInt(p.idAlumno)))
                    || /diego mart|sof[ií]a mart/i.test(p.nombre || '');
                if (!esMiHijo) return;
                if (p.idParada && paradasVisitadas.has(p.idParada)) return;
                if (distM([lat, lng], [p.lat, p.lng]) <= UMBRAL_M)
                    marcarParadaVisitada(p.idParada, p.idAlumno);
            });

            PARADAS_HIJOS.forEach(p => {
                if (!p.idParada || paradasVisitadas.has(p.idParada)) return;
                if (distM([lat, lng], [p.lat, p.lng]) <= UMBRAL_M)
                    marcarParadaVisitada(p.idParada, p.idAlumno);
            });

            if (esTurnoMañanaPadre()) {
                const colegioFin = rutaCompletaActiva.filter(p => p.esColegio).pop();
                if (colegioFin && distM([lat, lng], [colegioFin.lat, colegioFin.lng]) <= 100)
                    marcarParadaVisitada(colegioFin.idParada, null);
            }
        }

        // ── Ruta OSRM (solo Plan B) ───────────────────────────────────────────
        async function segmentoOSRM(desde, hasta) {
            try {
                const r = await fetch(`https://router.project-osrm.org/route/v1/driving/${desde[1]},${desde[0]};${hasta[1]},${hasta[0]}?overview=full&geometries=geojson`);
                const d = await r.json();
                if (d.code === 'Ok' && d.routes?.length)
                    return d.routes[0].geometry.coordinates.map(c => [c[1], c[0]]);
            } catch (_) {}
            return [desde, hasta];
        }

        async function dibujarRutaFallback() {
            if (!PARADAS_BD.length) return;
            if (routePolylineFallback) mapa.removeLayer(routePolylineFallback);

            const todos = [];
            for (let i = 0; i < PARADAS_BD.length - 1; i++) {
                const seg = await segmentoOSRM(
                    [PARADAS_BD[i].lat,   PARADAS_BD[i].lng],
                    [PARADAS_BD[i+1].lat, PARADAS_BD[i+1].lng]
                );
                todos.push(...seg);
            }
            routePolylineFallback = L.polyline(todos, {
                color: '#FF6B35', weight: 5, opacity: .85, dashArray: '10,5'
            }).addTo(mapa).bindPopup('<strong>🚌 Simulación local (Plan B)</strong>');
            mapa.fitBounds(L.latLngBounds(todos).pad(.1));
            return todos;
        }

        // ── [EN VIVO - FASE 0.1/0.5] SignalR ─────────────────────────────────
        async function conectarSignalR() {
            try {
                window.padreNot = new NotificacionesCliente();
                await window.padreNot.conectar();

                await window.padreNot.unirseAGrupo(`Bus_${ID_BUS}`);
                console.log(`✅ [PadreDashboard] Unido a Bus_${ID_BUS}`);

                for (const idAlumno of IDS_ALUMNOS) {
                    await window.padreNot.unirseAGrupo(`Alumno_${idAlumno}`);
                    console.log(`✅ [PadreDashboard] Unido a Alumno_${idAlumno}`);
                }

                signalRConectado = true;
                actualizarBadge(true);

                // [EN VIVO] Ubicación desde servidor (canal principal vía POST /api/ubicaciones)
                window.padreNot.onUbicacionActualizada((data) => {
                    if (modoVisualizacion === 'fallback') return;
                    actualizarMarcadorVivo(data);
                });

                // Ruta demo aleatoria sincronizada desde el monitor
                const handlerRutaDemo = (data) => {
                    if (modoVisualizacion === 'fallback') return;
                    aplicarRutaDemoDesdeMonitor(data);
                };
                if (typeof window.padreNot.onRutaDemoActualizada === 'function') {
                    window.padreNot.onRutaDemoActualizada(handlerRutaDemo);
                } else if (window.padreNot.connection) {
                    window.padreNot.connection.on('RutaDemoActualizada', handlerRutaDemo);
                }

                // [EN VIVO - FASE 0.5] Parada completada por el piloto
                window.padreNot.onParadaCompletada(mostrarAlertaParadaCompletada);

                window.padreNot.onAlerta((data) => {
                    if (modoVisualizacion === 'fallback') return;
                    const msg  = data.mensaje ?? data.Mensaje ?? 'Alerta del sistema';
                    const tipo = data.tipoAlerta ?? data.TipoAlerta ?? '';
                    const idAlumno = data.idAlumno ?? data.IdAlumno;
                    const esMiHijo = esAlertaDeMisHijos(idAlumno);
                    const cls  = (esMiHijo && (tipo === 'proximidad' || tipo === 'recogida' || tipo === 'dejada'))
                               ? 'hijo'
                               : tipo === 'llegada_colegio' ? (esMiHijo ? 'hijo' : 'success')
                               : tipo === 'proximidad'      ? 'warning'
                               : 'info';
                    agregarAlerta(msg, cls);
                    toast(msg, cls);
                });

                window.padreNot.onAlertaPersonal((data) => {
                    if (modoVisualizacion === 'fallback') return;
                    const msg = data.mensaje ?? data.Mensaje ?? 'Alerta personal';
                    agregarAlerta(msg, 'hijo');
                    toast(msg, 'hijo');
                });

                // Si no llegan datos en vivo, sugerir plan B
                setTimeout(() => {
                    if (!ultimaUbicacionVivo && modoVisualizacion === 'vivo') {
                        document.getElementById('estadoSimulacion').innerHTML =
                            '<span class="text-warning">⚠️ Sin datos en vivo. Usa la simulación como respaldo.</span>';
                    }
                }, TIMEOUT_SIN_DATOS_MS);

            } catch (e) {
                console.warn('[PadreDashboard] SignalR no disponible:', e);
                signalRConectado = false;
                actualizarBadge(false);
                document.getElementById('estadoSimulacion').innerHTML =
                    '<span class="text-danger">Sin conexión en vivo. Usa el botón de simulación.</span>';
            }
        }

        // [EN VIVO] Mover marcador verde con ubicación del piloto
        function actualizarMarcadorVivo(data) {
            const idBusEvt = parseInt(data.idBus ?? data.IdBus ?? ID_BUS);
            if (idBusEvt !== ID_BUS) return;

            const lat = parseFloat(data.latitud ?? data.Latitud);
            const lng = parseFloat(data.longitud ?? data.Longitud);
            if (isNaN(lat) || isNaN(lng)) return;

            ultimaUbicacionVivo = [lat, lng];

            if (simMarker) { mapa.removeLayer(simMarker); simMarker = null; }

            if (!busMarker) {
                busMarker = L.marker([lat, lng], { icon: iconoCirculo('🚌','#28a745', 44) })
                             .addTo(mapa)
                             .bindPopup(`<strong>🚌 Bus #${ID_BUS} en vivo</strong>`);
            } else {
                busMarker.setLatLng([lat, lng]);
            }
            mapa.panTo([lat, lng], { animate: true, duration: 0.4 });

            detectarParadasCercanas(lat, lng);
            actualizarColoresSegmentos(lat, lng);

            document.getElementById('estadoSimulacion').innerHTML =
                '<span class="text-success"><i class="bi bi-broadcast"></i> Bus en movimiento — datos en vivo</span>';

            if (CASA_LAT !== null && CASA_LNG !== null && esTurnoMañanaPadre()) {
                const dCasa = distM([lat, lng], [CASA_LAT, CASA_LNG]);
                if (dCasa <= 300 && !notifProximo) {
                    notifProximo = true;
                    const msg = `⚠️ El bus está a menos de 300 m de la casa — viene a recoger a <strong>@Html.Raw(Model.NombreHijo.Replace("'","\\'"  ))</strong>`;
                    agregarAlerta(msg, 'hijo');
                    toast(msg, 'hijo');
                }
            }

            // Mañana: alerta al llegar al colegio (destino final). Tarde: no finaliza en colegio.
            if (esTurnoMañanaPadre()) {
                const colegioFin = rutaCompletaActiva.filter(p => p.esColegio).pop();
                const refCole = colegioFin ?? { lat: colegioLat, lng: colegioLng };
                if (distM([lat, lng], [refCole.lat, refCole.lng]) <= 100 && !notifColegio) {
                    notifColegio = true;
                    const msg = `✅ El bus ha llegado al colegio. <strong>@Html.Raw(Model.NombreHijo.Replace("'","\\'"  ))</strong> ya está en el colegio.`;
                    agregarAlerta(msg, 'hijo');
                    toast(msg, 'hijo');
                }
            } else {
                const paradasHijosRuta = rutaCompletaActiva.filter(p =>
                    p.idAlumno && IDS_ALUMNOS.includes(parseInt(p.idAlumno))
                );
                if (paradasHijosRuta.length && !notifEntregaHijos) {
                    const ultima = paradasHijosRuta.reduce((a, b) => (a.orden ?? 0) >= (b.orden ?? 0) ? a : b);
                    if (distM([lat, lng], [ultima.lat, ultima.lng]) <= 120) {
                        notifEntregaHijos = true;
                        const msg = `✅ El bus ha dejado a <strong>@Html.Raw(Model.NombreHijo.Replace("'","\\'"  ))</strong> en casa (fin del recorrido tarde).`;
                        agregarAlerta(msg, 'hijo');
                        toast(msg, 'hijo');
                    }
                }
            }
        }

        /** Redibujar mapa cuando el monitor publica ruta demo (aleatoria o restaurada) */
        async function aplicarRutaDemoDesdeMonitor(data) {
            const idBusEvt = parseInt(data.idBus ?? data.IdBus ?? 0);
            if (idBusEvt && idBusEvt !== ID_BUS) return;

            let paradas = [];
            try {
                const json = data.paradasJson ?? data.ParadasJson ?? '[]';
                paradas = typeof json === 'string' ? JSON.parse(json) : json;
            } catch (e) {
                console.warn('[PadreDashboard] Error parseando paradas demo:', e);
                return;
            }
            if (!paradas.length) return;

            const tipo = data.tipoRuta ?? data.TipoRuta ?? tipoRutaActivo;
            tipoRutaActivo = tipo;
            rutaCompletaActiva = paradas.map(p => ({
                nombre: p.nombre,
                lat: parseFloat(p.lat),
                lng: parseFloat(p.lng),
                orden: p.orden,
                idParada: p.idParada ?? null,
                idAlumno: p.idAlumno ?? null,
                esColegio: p.esColegio === true
                    || (p.nombre && /colegio|yulimay/i.test(p.nombre))
            }));

            const cole = rutaCompletaActiva.find(p => p.esColegio);
            if (cole) {
                colegioLat = cole.lat;
                colegioLng = cole.lng;
            }

            paradasVisitadas.clear();
            notifProximo = false;
            notifColegio = false;
            notifEntregaHijos = false;

            actualizarMarcadoresHijosDesdeRuta();

            const desc = data.descripcion ?? data.Descripcion ?? '';
            actualizarUiTurno(tipo, desc);

            if (modoVisualizacion === 'vivo') {
                await dibujarRutaVivoCompleta();
            }

            const esAleatoria = data.esAleatoria ?? data.EsAleatoria;
            const msg = esAleatoria
                ? `🎲 Ruta demo aleatoria sincronizada (${tipo})`
                : `🗺️ Ruta actualizada desde el monitor (${tipo})`;
            agregarAlerta(msg, 'info');
            toast(msg, 'info');
            console.log('[PadreDashboard] Ruta demo aplicada:', rutaCompletaActiva.length, 'paradas, turno', tipo);
        }

        function actualizarUiTurno(tipo, nombreRuta) {
            const esMañana = tipo === 'Mañana' || tipo.toLowerCase().includes('mañana');
            const badge = document.getElementById('badgeTurnoActivo');
            if (badge) {
                badge.className = `badge fs-6 ${esMañana ? 'bg-warning text-dark' : ''}`;
                badge.style.background = esMañana ? '' : '#fd7e14';
                badge.innerHTML = `<i class="bi bi-${esMañana ? 'sunrise' : 'sunset'}"></i> Turno ${tipo}`;
            }
            const info = document.getElementById('infoTurnoActivo');
            if (info) {
                const desc = esMañana
                    ? 'Mañana: inicia en casas de Diego/Sofía → termina en el colegio (nunca al revés).'
                    : 'Tarde: inicia en el colegio → termina en casas de Diego/Sofía (no regresa al colegio).';
                info.innerHTML = `<strong>Turno ${tipo} activo</strong> (sincronizado con monitor)<br>${desc}`;
            }
            if (nombreRuta) {
                const lbl = document.getElementById('lblRutaNombre');
                if (lbl) lbl.textContent = nombreRuta;
            }
        }

        // [EN VIVO - FASE 0.5] Alerta cuando el piloto completa una parada
        function mostrarAlertaParadaCompletada(data) {
            const idParada = data.idParada ?? data.IdParada;
            const idAlumno = data.idAlumno ?? data.IdAlumno;
            if (idParada) marcarParadaVisitada(idParada, idAlumno);

            const esMiHijo = esAlertaDeMisHijos(idAlumno);
            const nombreHijo = nombreHijoPorId(idAlumno);
            const msg = data.mensaje ?? data.Mensaje ?? (
                esMiHijo && nombreHijo
                    ? ((data.tipoRuta ?? data.TipoRuta ?? tipoRutaActivo) === 'Tarde'
                        ? `✅ ${nombreHijo} ha sido dejado en casa.`
                        : (data.esParadaColegio ?? data.EsParadaColegio)
                            ? `✅ ${nombreHijo} ha llegado al colegio.`
                            : `✅ ${nombreHijo} ha sido recogido.`)
                    : ((data.tipoRuta ?? data.TipoRuta ?? tipoRutaActivo) === 'Tarde'
                        ? `✅ @Html.Raw(Model.NombreHijo.Replace("'","\\'"  )) ha sido dejado en casa.`
                        : (data.esParadaColegio ?? data.EsParadaColegio)
                            ? `✅ @Html.Raw(Model.NombreHijo.Replace("'","\\'"  )) ha llegado al colegio.`
                            : `✅ @Html.Raw(Model.NombreHijo.Replace("'","\\'"  )) ha sido recogido.`)
            );
            const cls = esMiHijo ? 'hijo' : 'success';
            agregarAlerta(msg, cls);
            toast(msg, cls);
        }

        function esAlertaDeMisHijos(idAlumno) {
            if (idAlumno == null) return false;
            return IDS_ALUMNOS.includes(parseInt(idAlumno));
        }

        function nombreHijoPorId(idAlumno) {
            if (idAlumno == null) return null;
            const id = parseInt(idAlumno);
            const item = PARADAS_HIJOS.find(p => p.idAlumno === id);
            if (item?.nombre) return item.nombre.replace(/^Casa — /, '').replace(/^Parada — /, '');
            return null;
        }

        function actualizarBadge(ok) {
            const b = document.getElementById('estadoSignalR');
            b.className = `badge ${ok ? 'bg-success' : 'bg-danger'} fs-6`;
            b.innerHTML = ok ? '<i class="bi bi-wifi"></i> En vivo' : '<i class="bi bi-wifi-off"></i> Sin conexión';
        }

        // ── Panel de alertas ──────────────────────────────────────────────────
        function agregarAlerta(mensaje, tipo) {
            const panel = document.getElementById('panelAlertas');
            document.getElementById('sinAlertas')?.remove();

            contadorAlertas++;
            const contador = document.getElementById('contadorAlertas');
            contador.textContent = contadorAlertas;
            contador.classList.remove('d-none');

            const item = document.createElement('div');
            item.className = `alerta-item alerta-${tipo}`;
            item.innerHTML = `<span class="text-muted small">${new Date().toLocaleTimeString()}</span><br>${mensaje}`;
            panel.prepend(item);
        }

        function limpiarAlertas() {
            contadorAlertas = 0;
            document.getElementById('contadorAlertas').classList.add('d-none');
            document.getElementById('panelAlertas').innerHTML =
                '<p class="text-muted small mb-0" id="sinAlertas"><i class="bi bi-info-circle me-1"></i> Sin alertas recientes</p>';
        }

        function toast(msg, tipo) {
            const el = document.createElement('div');
            el.className = 'alert alert-dismissible fade show position-fixed shadow';
            if (tipo === 'hijo') {
                el.style.cssText = 'top:80px;right:20px;z-index:9999;min-width:280px;max-width:420px;background:#e3f7fc;border:1px solid #0dcaf0;color:#055160';
            } else {
                el.classList.add(`alert-${tipo}`);
                el.style.cssText = 'top:80px;right:20px;z-index:9999;min-width:280px;max-width:420px';
            }
            el.innerHTML = `${msg} <button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
            document.body.appendChild(el);
            setTimeout(() => { if (el.parentNode) el.remove(); }, 8000);
        }

        // ── Controles del mapa ────────────────────────────────────────────────
        function centrarEnBus() {
            if (busMarker) { mapa.setView(busMarker.getLatLng(), 16); busMarker.openPopup(); }
            else if (PARADAS_BD.length) mapa.setView([PARADAS_BD[0].lat, PARADAS_BD[0].lng], 14);
        }

        function verRutaCompleta() {
            if (modoVisualizacion === 'fallback' && routePolylineFallback)
                mapa.fitBounds(routePolylineFallback.getBounds().pad(.1));
            else if (routeSegmentosVivo.length) {
                const grupo = L.featureGroup(routeSegmentosVivo.map(s => s.poly));
                mapa.fitBounds(grupo.getBounds().pad(.1));
            }
        }

        // ── [FALLBACK - FASE 0.1] Simulación local del padre (plan B) ─────────
        async function simularRuta() {
            if (simActiva) { detenerSimulacion(); return; }

            modoVisualizacion = 'fallback';

            // Ocultar ruta en vivo; mostrar solo línea Plan B
            ocultarRutaVivo();
            if (busMarker) { mapa.removeLayer(busMarker); busMarker = null; }

            const btn    = document.getElementById('btnSimular');
            const estado = document.getElementById('estadoSimulacion');
            btn.innerHTML = '<i class="bi bi-stop-circle-fill me-2"></i>Detener';
            btn.className = 'btn btn-danger w-100';
            estado.textContent = 'Simulación local activa (plan B)...';
            simActiva = true;

            await dibujarRutaFallback();

            if (simPuntos.length === 0) {
                for (let i = 0; i < PARADAS_BD.length - 1; i++) {
                    const seg = await segmentoOSRM(
                        [PARADAS_BD[i].lat,   PARADAS_BD[i].lng],
                        [PARADAS_BD[i+1].lat, PARADAS_BD[i+1].lng]
                    );
                    seg.forEach((c, idx) => simPuntos.push({
                        coord: c,
                        esParada: idx === 0,
                        nombre:   idx === 0 ? PARADAS_BD[i].nombre : null
                    }));
                }
                const ult = PARADAS_BD[PARADAS_BD.length - 1];
                simPuntos.push({ coord: [ult.lat, ult.lng], esParada: true, nombre: ult.nombre });
            }

            if (simMarker) mapa.removeLayer(simMarker);
            simMarker = L.marker(simPuntos[0].coord, { icon: iconoCirculo('🚌','#ff6b35', 44) })
                         .addTo(mapa)
                         .bindPopup(`<strong>🚌 Bus #${ID_BUS} (Simulación local)</strong>`);

            let i = 0;
            const vel = 700;

            function paso() {
                if (!simActiva || i >= simPuntos.length) {
                    if (simActiva) {
                        estado.textContent = '✅ Simulación completada';
                        setTimeout(detenerSimulacion, 3000);
                    }
                    return;
                }
                const p = simPuntos[i];
                simMarker.setLatLng(p.coord);
                mapa.panTo(p.coord, { animate: true, duration: 0.4 });
                estado.textContent = `🚌 ${Math.floor((i/simPuntos.length)*100)}%${p.esParada && p.nombre ? ' — '+p.nombre : ''}`;
                if (p.esParada && p.nombre) simMarker.setPopupContent(`<strong>🚏 ${p.nombre}</strong>`).openPopup();
                i++;
                setTimeout(paso, p.esParada ? vel + 1500 : vel);
            }
            paso();
        }

        function detenerSimulacion() {
            simActiva = false;
            modoVisualizacion = 'vivo';
            document.getElementById('btnSimular').innerHTML = '<i class="bi bi-play-circle-fill me-2"></i>Iniciar Simulación (Plan B)';
            document.getElementById('btnSimular').className = 'btn btn-outline-primary w-100';
            document.getElementById('estadoSimulacion').textContent =
                signalRConectado
                    ? 'Por defecto verás el bus en vivo. Si no hay señal, usa este botón.'
                    : 'Sin conexión en vivo. Usa el botón de simulación.';
            if (simMarker) { mapa.removeLayer(simMarker); simMarker = null; }
            if (routePolylineFallback) { mapa.removeLayer(routePolylineFallback); routePolylineFallback = null; }
            mostrarRutaVivo();
            // Restaurar última posición en vivo si la había
            if (ultimaUbicacionVivo) {
                actualizarMarcadorVivo({ latitud: ultimaUbicacionVivo[0], longitud: ultimaUbicacionVivo[1] });
            }
        }

        // ── Haversine ────────────────────────────────────────────────────────
        function distM(p1, p2) {
            const R = 6371000, toR = v => v * Math.PI / 180;
            const dLat = toR(p2[0]-p1[0]), dLon = toR(p2[1]-p1[1]);
            const a = Math.sin(dLat/2)**2 + Math.cos(toR(p1[0]))*Math.cos(toR(p2[0]))*Math.sin(dLon/2)**2;
            return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
        }
    </script>
}
