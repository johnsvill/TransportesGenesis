@page "/Geolocalizacion/BusEdit"
@model TransportesGenesis.Pages.Geolocalizacion.BusEditModel
@{
    ViewData["Title"] = "Editar Bus";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary"><i class="bi bi-pencil-square"></i> Editar Bus</h2>
        <a asp-page="./BusesIndex" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="alert alert-danger">@Model.MensajeError</div>
    }

    <div class="card">
        <div class="card-body">
            <form method="post">
                <input type="hidden" asp-for="Bus.IdBus" />
                <div class="mb-3">
                    <label asp-for="Bus.Placa" class="form-label">Placa *</label>
                    <input asp-for="Bus.Placa" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label asp-for="Bus.Modelo" class="form-label">Modelo</label>
                    <input asp-for="Bus.Modelo" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Bus.Capacidad" class="form-label">Capacidad *</label>
                    <input asp-for="Bus.Capacidad" class="form-control" type="number" min="1" required />
                </div>
                <div class="form-check mb-3">
                    <input asp-for="Bus.Estado" class="form-check-input" type="checkbox" />
                    <label asp-for="Bus.Estado" class="form-check-label">Bus activo</label>
                </div>
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-save"></i> Guardar Cambios
                </button>
            </form>
        </div>
    </div>
</div>
