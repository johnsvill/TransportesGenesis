@page "/Geolocalizacion/BusCreate"
@model TransportesGenesis.Pages.Geolocalizacion.BusCreateModel
@{
    ViewData["Title"] = "Crear Bus";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary"><i class="bi bi-bus-front"></i> Crear Bus</h2>
        <a asp-page="./BusesIndex" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="alert alert-danger">@Model.MensajeError</div>
    }

    <div class="card">
        <div class="card-body">
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Bus.Placa" class="form-label">Placa *</label>
                    <input asp-for="Bus.Placa" class="form-control" placeholder="Ej: BUS-001" required />
                </div>
                <div class="mb-3">
                    <label asp-for="Bus.Modelo" class="form-label">Modelo</label>
                    <input asp-for="Bus.Modelo" class="form-control" placeholder="Ej: Mercedes-Benz Sprinter" />
                </div>
                <div class="mb-3">
                    <label asp-for="Bus.Capacidad" class="form-label">Capacidad *</label>
                    <input asp-for="Bus.Capacidad" class="form-control" type="number" min="1" required />
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Guardar Bus
                </button>
            </form>
        </div>
    </div>
</div>
