@page
@model TransportesGenesis.Pages.Geolocalizacion.MapaEnTiempoRealModel
@{
    ViewData["Title"] = "Mapa en Tiempo Real";
}

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<!-- Routing Machine CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.css" />

<style>
    .realtime-header {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        border-radius: 20px;
        padding: 25px;
        margin-bottom: 25px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(40,167,69,0.3);
    }

    .realtime-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 150px;
        height: 150px;
        background: rgba(255,255,255,0.1);
        border-radius: 50%;
        animation: float 8s ease-in-out infinite;
    }

    .live-indicator {
        display: inline-flex;
        align-items: center;
        background: rgba(255,255,255,0.2);
        padding: 8px 16px;
        border-radius: 20px;
        font-weight: 600;
        margin-left: 15px;
    }

    .live-dot {
        width: 12px;
        height: 12px;
        background: #ff4444;
        border-radius: 50%;
        margin-right: 8px;
        animation: pulse-red 1.5s infinite;
    }

    @@keyframes pulse-red {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
    }

    .stat-item {
        text-align: center;
        padding: 15px;
        background: rgba(255,255,255,0.15);
        border-radius: 12px;
        backdrop-filter: blur(10px);
    }

    .stat-number {
        font-size: 2rem;
        font-weight: bold;
        display: block;
    }

    .stat-label {
        font-size: 0.9rem;
        opacity: 0.8;
        margin-top: 5px;
    }

    .info-panel {
        background: #fff;
        border-radius: 15px;
        margin-bottom: 20px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        transition: transform 0.3s ease;
    }

    .info-panel:hover {
        transform: translateY(-5px);
    }

    .info-panel .card-header {
        background: linear-gradient(135deg, #007bff 0%, #6610f2 100%);
        border: none;
        padding: 15px 20px;
    }

    .buses-panel .card-header {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
    }

    .legend-panel .card-header {
        background: linear-gradient(135deg, #fd7e14 0%, #ffc107 100%);
    }

    .stats-panel .card-header {
        background: linear-gradient(135deg, #6f42c1 0%, #e83e8c 100%);
    }

    #map {
        height: 70vh;
        min-height: 500px;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        overflow: hidden;
    }

    .bus-item {
        padding: 15px 20px;
        border-bottom: 1px solid #eee;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .bus-item:hover {
        background: #f8f9fa;
        transform: translateX(5px);
    }

    .bus-item:last-child {
        border-bottom: none;
    }

    .bus-item.active {
        background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
        border-left: 4px solid #2196f3;
    }

    .bus-status {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        display: inline-block;
    }

    .status-moving {
        background: #28a745;
        animation: pulse 2s infinite;
    }

    .status-stopped {
        background: #ffc107;
    }

    .status-offline {
        background: #dc3545;
        animation: blink 1s infinite;
    }

    @@keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
    }

    .legend-item {
        padding: 10px 0;
        border-bottom: 1px solid #eee;
    }

    .legend-item:last-child {
        border-bottom: none;
    }

    .floating-controls {
        position: absolute;
        top: 20px;
        right: 20px;
        z-index: 1000;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .floating-btn {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        border: none;
        background: white;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .floating-btn:hover {
        transform: scale(1.1);
        box-shadow: 0 6px 20px rgba(0,0,0,0.3);
    }

    .custom-bus-marker {
        background: transparent;
        border: none;
    }

    .bus-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        border: 3px solid white;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        cursor: pointer;
        transition: transform 0.2s;
    }

    .bus-icon:hover {
        transform: scale(1.2);
    }

    .custom-school-marker {
        background: transparent;
        border: none;
    }

    .school-icon {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: 4px solid white;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
        cursor: pointer;
        animation: school-pulse 3s ease-in-out infinite;
    }

    @@keyframes school-pulse {
        0%, 100% { transform: scale(1); box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4); }
        50% { transform: scale(1.05); box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6); }
    }

    @@media (max-width: 768px) {
        #map { height: 60vh; min-height: 400px; }
        .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; padding: 15px; }
        .stat-number { font-size: 1.5rem; }
        .floating-controls { top: 10px; right: 10px; }
        .floating-btn { width: 40px; height: 40px; font-size: 16px; }
        .bus-item { padding: 12px; }

        /* Mejoras para botones en móviles */
        .btn-sm {
            padding: 8px 12px;
            font-size: 0.875rem;
            min-width: 100px;
            text-align: center;
        }

        .card-footer .row > div {
            margin-bottom: 10px;
        }

        .card-footer small {
            font-size: 0.8rem;
        }
    }

    @@media (max-width: 576px) {
        .col-info { order: 2; }
        .col-map { order: 1; }
        #map { height: 50vh; min-height: 350px; }
        .stats-grid { grid-template-columns: 1fr 1fr; }

        /* Botones aún más compactos en pantallas muy pequeñas */
        .btn-sm {
            padding: 6px 10px;
            font-size: 0.8rem;
            min-width: 90px;
        }

        .btn-sm i {
            font-size: 0.9rem;
        }

        /* Espaciado del footer */
        .card-footer {
            padding: 10px 15px;
        }

        .card-footer .d-flex {
            gap: 8px !important;
        }
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-20px) rotate(180deg); }
    }

    @@keyframes pulse {
        0% { opacity: 1; }
        50% { opacity: 0.5; }
        100% { opacity: 1; }
    }

    .loading-skeleton {
        animation: skeleton-loading 1.5s ease-in-out infinite alternate;
    }

    @@keyframes skeleton-loading {
        0% { background-color: #f0f0f0; }
        100% { background-color: #e0e0e0; }
    }
</style>

<div class="container-fluid px-3 px-md-4">
    <!-- Header mejorado -->
    <div class="realtime-header animate__animated animate__fadeInDown">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="mb-2 fw-bold">
                    <i class="bi bi-geo-alt-fill me-3"></i>
                    Mapa en Tiempo Real
                    <small class="text-light ms-3" id="padreNombreHeader">@Model.PadreNombre</small>
                </h1>
                <p class="mb-0 opacity-75">
                    <i class="bi bi-bus-front me-2"></i>
                    Monitoreo y ubicación de la flota de transporte escolar
                    <span class="live-indicator d-none" id="live-indicator-badge">
                        <span class="live-dot"></span>
                        EN VIVO
                    </span>
                    <span class="live-indicator d-none ms-2" id="signal-status-badge" style="background:rgba(255,193,7,0.35);">
                        <i class="bi bi-wifi-off me-1"></i>
                        <span id="signal-status-text">Sin señal</span>
                    </span>
                </p>
            </div>
            <div class="col-md-4">
                <div class="stats-grid">
                    <div class="stat-item">
                        <div class="stat-number" id="busesActivos">-</div>
                        <div class="stat-label">Activos</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-number" id="busesEnRuta">-</div>
                        <div class="stat-label">En Ruta</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Panel de información -->
        <div class="col-12 col-lg-4 col-info">
            <!-- Selector de bus y ruta -->
            <div class="info-panel buses-panel animate__animated animate__fadeInLeft">
                <div class="card-header text-white">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-bus-front-fill me-2"></i>
                        Monitoreo por Bus
                    </h6>
                </div>
                <div class="card-body p-3">
                    <div class="mb-3">
                        <label for="select-bus-monitor" class="form-label fw-semibold">Bus *</label>
                        <select id="select-bus-monitor" class="form-select">
                            <option value="">-- Seleccione un bus --</option>
                        </select>
                        <small class="text-muted">El administrador elige el bus para ver su ubicación y ruta. Los padres ven solo el bus de sus hijos en «Mi Ruta».</small>
                    </div>
                    <div class="mb-3">
                        <label for="select-ruta-monitor" class="form-label fw-semibold">Ruta (turno)</label>
                        <select id="select-ruta-monitor" class="form-select" disabled>
                            <option value="">-- Seleccione una ruta --</option>
                        </select>
                    </div>
                    <button type="button" class="btn btn-success w-100 mb-3" onclick="cargarVistaBusSeleccionada()">
                        <i class="bi bi-map"></i> Ver ruta en mapa
                    </button>
                    <div id="alerta-horario-bus" class="alert alert-warning d-none mb-0" role="alert"></div>
                    <div id="info-bus-seleccionado" class="small text-muted mt-2"></div>
                </div>
            </div>

            <!-- Detalle del bus seleccionado -->
            <div class="info-panel animate__animated animate__fadeInLeft" style="animation-delay: 0.1s;">
                <div class="card-header text-white" style="background: linear-gradient(135deg, #007bff 0%, #6610f2 100%);">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-list-ul me-2"></i>
                        Estado del Bus
                    </h6>
                </div>
                <div class="card-body p-0" style="max-height: 220px; overflow-y: auto;">
                    <div id="busesInfo">
                        <!-- Loading skeleton -->
                        <div class="p-3">
                            <div class="bus-item loading-skeleton mb-2" style="height: 60px;"></div>
                            <div class="bus-item loading-skeleton mb-2" style="height: 60px;"></div>
                            <div class="bus-item loading-skeleton" style="height: 60px;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Leyenda -->
            <div class="info-panel legend-panel animate__animated animate__fadeInLeft" style="animation-delay: 0.2s;">
                <div class="card-header text-white">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-palette-fill me-2"></i>
                        Estados de Buses
                    </h6>
                </div>
                <div class="card-body p-3">
                    <div class="legend-item">
                        <div class="d-flex align-items-center">
                            <span class="bus-status status-moving me-3"></span>
                            <div>
                                <div class="fw-semibold">En Movimiento</div>
                                <small class="text-muted">Velocidad > 5 km/h</small>
                            </div>
                        </div>
                    </div>
                    <div class="legend-item">
                        <div class="d-flex align-items-center">
                            <span class="bus-status status-stopped me-3"></span>
                            <div>
                                <div class="fw-semibold">Detenido</div>
                                <small class="text-muted">Velocidad ≤ 5 km/h</small>
                            </div>
                        </div>
                    </div>
                    <div class="legend-item">
                        <div class="d-flex align-items-center">
                            <span class="bus-status status-offline me-3"></span>
                            <div>
                                <div class="fw-semibold">Sin Señal</div>
                                <small class="text-muted">Sin actualizar > 10 min</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Estadísticas -->
            <div class="info-panel stats-panel animate__animated animate__fadeInLeft" style="animation-delay: 0.4s;">
                <div class="card-header text-white">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-bar-chart-fill me-2"></i>
                        Estadísticas en Tiempo Real
                    </h6>
                </div>
                <div class="card-body p-3">
                    <div class="row text-center">
                        <div class="col-6 border-end">
                            <div class="stat-number text-primary" id="velocidadPromedio">-</div>
                            <small class="text-muted">Velocidad Prom.</small>
                        </div>
                        <div class="col-6">
                            <div class="stat-number text-success" id="estudiantesTotales">-</div>
                            <small class="text-muted">Estudiantes</small>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light">
                    <div class="row align-items-center">
                        <div class="col-12 col-md-6 mb-2 mb-md-0">
                            <small class="text-muted d-flex align-items-center justify-content-center justify-content-md-start">
                                <i class="bi bi-info-circle me-2"></i>
                                Haz clic en un bus de la lista para localizarlo en el mapa
                            </small>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="d-flex flex-column flex-md-row gap-2 justify-content-md-end">
                                <button class="btn btn-sm btn-outline-primary" onclick="verTodosBuses()">
                                    <i class="bi bi-eye me-1"></i>
                                    Ver Todos
                                </button>
                                <button class="btn btn-sm btn-outline-warning" id="btnSimularRutas" onclick="toggleSimulacionRutas()">
                                    <i class="bi bi-map me-1"></i>
                                    Simular Rutas
                                </button>
                                <button class="btn btn-sm btn-outline-success" onclick="seguirBuses()">
                                    <i class="bi bi-camera-video me-1"></i>
                                    Seguimiento
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-12 text-center">
                            <small class="text-muted">
                                <i class="bi bi-clock me-1"></i>
                                Última actualización: <span id="lastUpdate">--:--:--</span>
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mapa -->
        <div class="col-12 col-lg-8 col-map">
            <div class="position-relative">
                <div id="map"></div>

                <!-- Controles flotantes -->
                <div class="floating-controls">
                    <button class="floating-btn" onclick="alternarVista()" title="Cambiar vista">
                        <i class="bi bi-layers"></i>
                    </button>
                    <button class="floating-btn" onclick="verTodosBuses()" title="Ver todos los buses">
                        <i class="bi bi-zoom-out"></i>
                    </button>
                    <button class="floating-btn" onclick="cargarVistaBusSeleccionada()" title="Actualizar">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin=""></script>
<!-- Routing Machine JS -->
<script src="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.js"></script>

@section Scripts {
    <script type="application/json" id="config-mapa-tiempo-real">@Html.Raw(Model.ConfigJson)</script>
    <script>
        // Variables globales - declaradas una sola vez
        let mapaRealTime;
        let marcadores = {};
        let polylines = {};
        let capasRutaEnfocada = [];
        let marcadoresParadasEnfocadas = [];
        let configMapa = { modoSelector: true };
        let busesElegibles = [];
        let signalRGrupoBus = null;
        let seguimientoActivo = false;
        let vistaSatelite = false;
        let busSeleccionado = null;
        let busesData = [];
        let actualizacionInterval;
        let routeControls = {};
        let simulacionRutasActiva = false;
        let rutasCalculadas = {};

        // Colegio principal desde ConfiguracionSistema (pantalla Admin/ConfigurarColegio)
        let COLEGIO_COORDS = [14.6235, -90.4956];
        let COLEGIO_NOMBRE = 'Colegio';

        // Puntos de origen para cada bus
        const puntosOrigen = {
            1: [14.6418, -90.5135], // Zona 1
            2: [14.6152, -90.4895], // Cayalá
            3: [14.6089, -90.5234], // San Cristóbal
            4: [14.5023, -90.5534]  // Petapa
        };

        // Rutas predefinidas simplificadas para movimiento básico
        const rutasBuses = {
            1: { // Bus de Zona 1 a Yulimay PC
                waypoints: [
                    [14.6418, -90.5135], // Zona 1
                    [14.6349, -90.5069], // Centro Ciudad
                    [14.6298, -90.5023], // Camino a Yulimay
                    [14.6235, -90.4956]  // Yulimay PC
                ]
            },
            2: { // Bus de Cayalá a Yulimay PC
                waypoints: [
                    [14.6152, -90.4895], // Cayalá
                    [14.6201, -90.4932], // Ruta intermedia
                    [14.6235, -90.4956]  // Yulimay PC
                ]
            },
            3: { // Bus de San Cristóbal a Yulimay PC
                waypoints: [
                    [14.6089, -90.5234], // San Cristóbal
                    [14.6156, -90.5112], // Ruta intermedia
                    [14.6235, -90.4956]  // Yulimay PC
                ]
            },
            4: { // Bus de Petapa a Yulimay PC
                waypoints: [
                    [14.5023, -90.5534], // Petapa
                    [14.5456, -90.5234], // Ruta intermedia 1
                    [14.6089, -90.4989], // Ruta intermedia 2
                    [14.6235, -90.4956]  // Yulimay PC
                ]
            }
        };

        function mostrarIndicadorEnVivo(visible) {
            const badge = document.getElementById('live-indicator-badge');
            if (badge) badge.classList.toggle('d-none', !visible);
        }

        function limpiarMarcadoresFlota() {
            Object.keys(marcadores).forEach(id => {
                mapaRealTime.removeLayer(marcadores[id]);
                delete marcadores[id];
            });
            limpiarCapasEnfocadas();
        }

        function mostrarAlertaHorario(mensaje) {
            const el = document.getElementById('alerta-horario-bus');
            if (el) {
                if (!mensaje) {
                    el.classList.add('d-none');
                    el.textContent = '';
                } else {
                    el.classList.remove('d-none');
                    el.innerHTML = `<i class="bi bi-exclamation-triangle me-2"></i>${mensaje}`;
                }
            }

            const mapaEl = document.getElementById('map');
            const existente = document.getElementById('banner-fuera-horario');
            if (existente) existente.remove();

            if (mensaje && mapaEl?.parentElement) {
                const banner = document.createElement('div');
                banner.id = 'banner-fuera-horario';
                banner.className = 'alert alert-warning mb-0 position-absolute top-0 start-0 end-0 mx-3 mt-3';
                banner.style.zIndex = '1000';
                banner.innerHTML = `<strong><i class="bi bi-clock-history me-2"></i>Fuera de horario:</strong> ${mensaje}`;
                mapaEl.parentElement.appendChild(banner);
            }
        }

        async function cargarBusesElegibles() {
            if (Array.isArray(configMapa.busesElegibles)) {
                busesElegibles = configMapa.busesElegibles;
                poblarSelectoresBus();
                return;
            }

            const resp = await fetch('/api/mapa-tiempo-real/buses-eligibles', { credentials: 'same-origin' });
            if (!resp.ok) throw new Error('No se pudieron cargar los buses');
            const data = await resp.json();
            busesElegibles = data.buses || [];
            poblarSelectoresBus();
        }

        function poblarSelectoresBus() {
            const selectBus = document.getElementById('select-bus-monitor');
            const selectRuta = document.getElementById('select-ruta-monitor');
            if (!selectBus || !selectRuta) return;

            selectBus.innerHTML = '<option value="">-- Seleccione un bus --</option>';
            busesElegibles.forEach(bus => {
                const opt = document.createElement('option');
                opt.value = String(bus.idBus);
                opt.textContent = `${bus.placa} — ${bus.alumnosAsignados} alumno(s), ${bus.rutas.length} ruta(s)`;
                selectBus.appendChild(opt);
            });

            if (busesElegibles.length === 0) {
                const opt = document.createElement('option');
                opt.value = '';
                opt.textContent = 'No hay buses con rutas y alumnos';
                opt.disabled = true;
                selectBus.appendChild(opt);
            }

            if (configMapa.idBusPreseleccionado) {
                selectBus.value = String(configMapa.idBusPreseleccionado);
                actualizarRutasDelBusSeleccionado(configMapa.idRutaPreseleccionada);
            }
        }

        function actualizarRutasDelBusSeleccionado(idRutaPreseleccionada) {
            const selectBus = document.getElementById('select-bus-monitor');
            const selectRuta = document.getElementById('select-ruta-monitor');
            const idBus = parseInt(selectBus.value);
            selectRuta.innerHTML = '<option value="">-- Seleccione una ruta --</option>';

            if (!idBus) {
                selectRuta.disabled = true;
                return;
            }

            const bus = busesElegibles.find(b => b.idBus == idBus);
            if (!bus) {
                selectRuta.disabled = true;
                return;
            }

            bus.rutas.forEach(ruta => {
                const opt = document.createElement('option');
                opt.value = ruta.idRuta;
                const estado = ruta.esActiva ? 'Operativa' : 'Inactiva';
                opt.textContent = `${ruta.nombre} (${ruta.tipoRuta}) — ${estado}`;
                selectRuta.appendChild(opt);
            });

            selectRuta.disabled = bus.rutas.length === 0;

            if (idRutaPreseleccionada && bus.rutas.some(r => r.idRuta == idRutaPreseleccionada)) {
                selectRuta.value = idRutaPreseleccionada;
            } else {
                const turnoActual = bus.rutas.find(r => r.turnoActual && r.esActiva)
                    || bus.rutas.find(r => r.esActiva)
                    || bus.rutas[0];
                if (turnoActual) selectRuta.value = turnoActual.idRuta;
            }
        }

        async function cargarVistaBusSeleccionada() {
            const idBus = parseInt(document.getElementById('select-bus-monitor').value);
            const idRuta = parseInt(document.getElementById('select-ruta-monitor').value);
            if (!idBus) {
                alert('Seleccione un bus');
                return;
            }

            const url = idRuta
                ? `/api/mapa-tiempo-real/vista?idBus=${idBus}&idRuta=${idRuta}`
                : `/api/mapa-tiempo-real/vista?idBus=${idBus}`;

            const resp = await fetch(url, { credentials: 'same-origin' });
            if (!resp.ok) {
                alert('No se pudo cargar la ruta del bus seleccionado.');
                return;
            }

            const vista = await resp.json();
            configMapa = vista;
            configMapa.modoEnfocado = true;
            configMapa.busesElegibles = busesElegibles;

            limpiarMarcadoresFlota();
            document.getElementById('aviso-sin-ruta-bus')?.remove();
            mostrarAlertaHorario(vista.enHorario ? null : (vista.mensajeHorario || 'El autobús no está en recorrido por el horario.'));
            mostrarIndicadorEnVivo(true);

            const info = document.getElementById('info-bus-seleccionado');
            if (info && vista.ruta) {
                info.innerHTML = vista.rutaEnRecorrido
                    ? '<span class="text-success"><i class="bi bi-broadcast"></i> Bus en recorrido en vivo</span>'
                    : vista.enHorario
                        ? '<span class="text-primary"><i class="bi bi-hourglass-split"></i> En horario — esperando señal del piloto/monitor</span>'
                        : '<span class="text-secondary"><i class="bi bi-pause-circle"></i> Ruta asignada visible — sin recorrido activo</span>';
            }

            inicializarVistaBusEnfocada();
            await conectarSignalRBusEnfocado();
            actualizarEstadisticasPanel(vista);
        }

