        function cargarConfigMapa() {
            const el = document.getElementById('config-mapa-tiempo-real');
            if (!el || !el.textContent.trim()) return;
            try {
                configMapa = JSON.parse(el.textContent);
                if (configMapa.colegio) {
                    const c = configMapa.colegio;
                    if (c.latitud != null && c.longitud != null) {
                        COLEGIO_COORDS = [parseFloat(c.latitud), parseFloat(c.longitud)];
                    }
                    if (c.nombre) COLEGIO_NOMBRE = c.nombre;
                }
            } catch (error) {
                console.warn('[MapaTiempoReal] Error al parsear configuración:', error);
