        function limpiarCapasEnfocadas() {
            capasRutaEnfocada.forEach(capa => mapaRealTime.removeLayer(capa));
            capasRutaEnfocada = [];
            marcadoresParadasEnfocadas.forEach(m => mapaRealTime.removeLayer(m));
            marcadoresParadasEnfocadas = [];
        }

        function dibujarRutaBusEnfocada(paradas) {
            const coords = (paradas || [])
                .map(p => [parseFloat(p.latitud), parseFloat(p.longitud)])
                .filter(c => !isNaN(c[0]) && !isNaN(c[1]) && c[0] !== 0 && c[1] !== 0);

            if (coords.length < 2) return;

            const enRecorrido = configMapa.rutaEnRecorrido === true;
            const colorRuta = enRecorrido ? '#C1121F' : '#6c757d';

            const borde = L.polyline(coords, {
                color: '#FFFFFF',
                weight: 9,
                opacity: 0.95,
                lineJoin: 'round',
                lineCap: 'round',
                dashArray: enRecorrido ? null : '12, 8'
            }).addTo(mapaRealTime);

            const linea = L.polyline(coords, {
                color: colorRuta,
                weight: 5,
                opacity: enRecorrido ? 0.95 : 0.75,
                lineJoin: 'round',
                lineCap: 'round',
                dashArray: enRecorrido ? null : '12, 8'
            }).addTo(mapaRealTime);

            capasRutaEnfocada.push(borde, linea);
        }

        function dibujarParadasBusEnfocada(paradas) {
            (paradas || []).forEach(parada => {
                const lat = parseFloat(parada.latitud);
                const lng = parseFloat(parada.longitud);
                if (isNaN(lat) || isNaN(lng) || lat === 0 || lng === 0) return;

                const esColegio = parada.esColegio;
                const icono = esColegio
                    ? L.divIcon({
                        className: 'custom-school-marker',
                        html: '<div class="school-icon">🏫</div>',
                        iconSize: [46, 46],
                        iconAnchor: [23, 23],
                        popupAnchor: [0, -23]
                    })
                    : L.divIcon({
                        className: 'custom-bus-marker',
                        html: `<div style="background:#C1121F;color:#fff;border-radius:50%;width:28px;height:28px;display:flex;align-items:center;justify-content:center;font-weight:bold;border:2px solid #fff;">${parada.orden || '•'}</div>`,
                        iconSize: [28, 28],
                        iconAnchor: [14, 14]
                    });

                const titulo = esColegio
                    ? 'Colegio'
                    : (parada.nombreAlumno || parada.direccion || `Parada ${parada.orden}`);

                const marcador = L.marker([lat, lng], { icon: icono })
                    .addTo(mapaRealTime)
                    .bindPopup(`<strong>${titulo}</strong><br><small>Orden: ${parada.orden || '-'}</small>`);

                marcadoresParadasEnfocadas.push(marcador);
            });
        }

        function ajustarVistaBusEnfocada(paradas, latBus, lngBus) {
            const coords = (paradas || [])
                .map(p => [parseFloat(p.latitud), parseFloat(p.longitud)])
                .filter(c => !isNaN(c[0]) && !isNaN(c[1]) && c[0] !== 0 && c[1] !== 0);

            if (!isNaN(latBus) && !isNaN(lngBus)) {
                coords.push([latBus, lngBus]);
            }

            if (coords.length === 0) {
                mapaRealTime.setView([14.6349, -90.5069], 15);
                return;
            }

            if (coords.length === 1) {
                mapaRealTime.setView(coords[0], 16);
                return;
            }

            mapaRealTime.fitBounds(coords, { padding: [50, 50], maxZoom: 16 });
            if (mapaRealTime.getZoom() < 13) {
                mapaRealTime.setZoom(13);
            }
        }

        function crearBusDataEnfocado() {
            const bus = configMapa.bus || {};
            const ruta = configMapa.ruta || {};
            const ubicacion = configMapa.ubicacion;
            const paradas = configMapa.paradas || [];
            const enRecorrido = configMapa.rutaEnRecorrido === true;

            let lat = 14.6349;
            let lng = -90.5069;
            if (paradas.length) {
                lat = parseFloat(paradas[0].latitud);
                lng = parseFloat(paradas[0].longitud);
            }

            let estado = paradas.length ? 'Detenido' : 'SinSeñal';
            let velocidad = 0;
            let ultimaActualizacion = new Date().toISOString();

            if (enRecorrido && ubicacion) {
                lat = parseFloat(ubicacion.latitud);
                lng = parseFloat(ubicacion.longitud);
                velocidad = ubicacion.velocidad ? parseFloat(ubicacion.velocidad) : 0;
                ultimaActualizacion = ubicacion.fechaHora;
                estado = velocidad > 5 ? 'Movimiento' : 'Detenido';
            }

            return {
                idBus: bus.idBus,
                placa: bus.placa || `Bus #${bus.idBus}`,
                rutaId: ruta.idRuta || bus.idBus,
                rutaNombre: ruta.nombre || 'Ruta asignada',
                capacidadTotal: bus.capacidad || 0,
                estudiantesAbordo: 0,
                estado,
                enRecorrido,
                velocidad: Math.round(velocidad),
                latitud: lat,
                longitud: lng,
                ultimaActualizacion
            };
        }

        function actualizarTituloBusEnfocado() {
            const bus = configMapa.bus;
            const ruta = configMapa.ruta;
            if (!bus) return;

            const titulo = document.querySelector('.realtime-header h1');
            if (titulo) {
                titulo.innerHTML = `<i class="bi bi-bus-front-fill me-3"></i>Mapa en Vivo — ${bus.placa}`;
            }

            const subtitulo = document.querySelector('.realtime-header p');
            if (subtitulo && ruta) {
                const badgeRecorrido = configMapa.rutaEnRecorrido
                    ? '<span class="badge bg-light text-success ms-2">En recorrido</span>'
                    : '<span class="badge bg-light text-secondary ms-2">Ruta asignada — sin movimiento en vivo</span>';
                const estadoRuta = ruta.esActiva
                    ? 'Operativa'
                    : 'Inactiva';
                subtitulo.innerHTML = `<i class="bi bi-signpost-split me-2"></i>Ruta asignada: ${ruta.nombre} (${ruta.tipoRuta}) · ${estadoRuta} ${badgeRecorrido}`;
            } else if (subtitulo) {
                subtitulo.innerHTML = `<i class="bi bi-exclamation-triangle me-2"></i>Este bus no tiene rutas asignadas. Calcule rutas o cree paradas primero.`;
