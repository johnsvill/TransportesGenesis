        let ultimaUbicacionAdminTs = null;

        function actualizarBadgeSenalAdmin(estado) {
            const badge = document.getElementById('signal-status-badge');
            const texto = document.getElementById('signal-status-text');
            if (!badge || !texto) return;
            if (estado === 'vivo') {
                badge.classList.add('d-none');
                mostrarIndicadorEnVivo(true);
                return;
            }
            badge.classList.remove('d-none');
            if (estado === 'stale') {
                texto.textContent = 'Última posición conocida';
                badge.style.background = 'rgba(255,193,7,0.45)';
            } else if (estado === 'offline') {
                texto.textContent = 'Sin señal';
                badge.style.background = 'rgba(220,53,69,0.45)';
            }
        }

        setInterval(() => {
            if (!configMapa.modoEnfocado || !ultimaUbicacionAdminTs) return;
            const stale = (Date.now() - ultimaUbicacionAdminTs) > 60000;
            if (stale) actualizarBadgeSenalAdmin('stale');
        }, 5000);

        async function conectarSignalRBusEnfocado() {
            if (!configMapa.modoEnfocado || !configMapa.idBus) return;

            try {
                if (!window.mapaSignalR) {
                    window.mapaSignalR = new NotificacionesCliente();
                    await window.mapaSignalR.conectar();

                    window.mapaSignalR.onUbicacionActualizada((data) => {
                        if (!configMapa.modoEnfocado || !configMapa.enHorario) return;

                        const idBus = Number(data.idBus ?? data.IdBus);
                        if (idBus !== configMapa.idBus) return;
                        if (!configMapa.ruta?.esActiva) return;

                        configMapa.rutaEnRecorrido = true;

                        const lat = parseFloat(data.latitud ?? data.Latitud);
                        const lng = parseFloat(data.longitud ?? data.Longitud);
                        if (isNaN(lat) || isNaN(lng)) return;

                        ultimaUbicacionAdminTs = Date.now();
                        actualizarBadgeSenalAdmin('vivo');

                        const bus = busesData[0];
                        if (bus) {
                            bus.latitud = lat;
                            bus.longitud = lng;
                            bus.enRecorrido = true;
                            bus.estado = 'Movimiento';
                            bus.ultimaActualizacion = new Date().toISOString();
                        }

                        limpiarCapasEnfocadas();
                        dibujarRutaBusEnfocada(configMapa.paradas || []);
                        dibujarParadasBusEnfocada(configMapa.paradas || []);

                        const marcadorId = `bus_${idBus}`;
                        if (marcadores[marcadorId]) {
                            marcadores[marcadorId].setLatLng([lat, lng]);
                        } else {
                            actualizarMarcadores();
                        }

                        actualizarTituloBusEnfocado();
                        cargarListaBuses();
                        actualizarEstadisticas();
                        actualizarEstadisticasPanel(configMapa);

                        const info = document.getElementById('info-bus-seleccionado');
                        if (info) {
                            info.innerHTML = '<span class="text-success"><i class="bi bi-broadcast"></i> Bus en recorrido en vivo</span>';
                        }

                        if (seguimientoActivo) {
                            mapaRealTime.setView([lat, lng], Math.max(mapaRealTime.getZoom(), 15));
                        }
                    });
                }

                const nuevoGrupo = `Bus_${configMapa.idBus}`;
                if (signalRGrupoBus && signalRGrupoBus !== nuevoGrupo) {
                    await window.mapaSignalR.salirDeGrupo(signalRGrupoBus);
                }
                if (signalRGrupoBus !== nuevoGrupo) {
                    await window.mapaSignalR.unirseAGrupo(nuevoGrupo);
                    signalRGrupoBus = nuevoGrupo;
                }
            } catch (e) {
                console.warn('[MapaTiempoReal] SignalR no disponible:', e);
                actualizarBadgeSenalAdmin('offline');
            }
        }

