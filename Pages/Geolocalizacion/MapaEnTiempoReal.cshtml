        // Calcular posición realista del bus en su ruta
        function calcularPosicionEnRuta(busId, waypoints) {
            if (simulacionRutasActiva && rutasCalculadas[busId]) {
                // Si hay simulación activa, usar la ruta calculada
                return calcularPosicionEnRutaReal(busId);
            } else {
                // Movimiento básico entre waypoints
                const tiempoBase = Date.now() / 1000;
                const velocidadRuta = 0.001;
                const progresoBase = (tiempoBase * velocidadRuta + busId * 0.25) % 1;
                const segmentos = waypoints.length - 1;
                const segmentoActual = Math.floor(progresoBase * segmentos);
                const progresoEnSegmento = (progresoBase * segmentos) % 1;
                const indiceInicio = Math.min(segmentoActual, waypoints.length - 2);
                const indiceFin = indiceInicio + 1;
                const inicio = waypoints[indiceInicio];
                const fin = waypoints[indiceFin];
                const lat = inicio[0] + (fin[0] - inicio[0]) * progresoEnSegmento;
                const lng = inicio[1] + (fin[1] - inicio[1]) * progresoEnSegmento;
                return { lat, lng };
            }
        }

        // Activar/desactivar simulación de rutas reales
        function toggleSimulacionRutas() {
            simulacionRutasActiva = !simulacionRutasActiva;
            const btn = document.getElementById('btnSimularRutas');

            if (simulacionRutasActiva) {
                btn.innerHTML = '<i class="bi bi-stop-circle me-1"></i>Detener Rutas';
                btn.classList.remove('btn-outline-warning');
                btn.classList.add('btn-warning');
                calcularRutasReales();
            } else {
                btn.innerHTML = '<i class="bi bi-map me-1"></i>Simular Rutas';
                btn.classList.remove('btn-warning');
                btn.classList.add('btn-outline-warning');
                limpiarRutasCalculadas();
            }
        }

        // Calcular rutas reales usando Leaflet Routing Machine
        function calcularRutasReales() {
            console.log('Calculando rutas reales hacia', COLEGIO_NOMBRE);

            busesData.forEach(bus => {
                if (puntosOrigen[bus.rutaId]) {
                    const origen = puntosOrigen[bus.rutaId];

                    // Crear control de ruta para cada bus
                    const routeControl = L.Routing.control({
                        waypoints: [
                            L.latLng(origen[0], origen[1]),
                            L.latLng(COLEGIO_COORDS[0], COLEGIO_COORDS[1])
                        ],
                        routeWhileDragging: false,
                        addWaypoints: false,
                        createMarker: function() { return null; }, // No mostrar marcadores de ruta
                        lineOptions: {
                            styles: [{
                                color: getBusRouteColor(bus.rutaId),
                                weight: 4,
                                opacity: 0.7
                            }]
                        },
                        show: false, // No mostrar el panel de instrucciones
                        summaryTemplate: '<div style="display:none;"></div>'
                    }).on('routesfound', function(e) {
                        // Guardar la ruta calculada
                        rutasCalculadas[bus.idBus] = {
                            coordinates: e.routes[0].coordinates,
                            distance: e.routes[0].summary.totalDistance,
                            time: e.routes[0].summary.totalTime,
                            currentIndex: 0,
                            startTime: Date.now()
                        };

                        console.log(`Ruta calculada para bus ${bus.placa}: ${e.routes[0].coordinates.length} puntos`);
                    }).addTo(mapaRealTime);

                    routeControls[bus.idBus] = routeControl;
                }
            });
        }

        // Obtener color para la ruta del bus
        function getBusRouteColor(rutaId) {
            const colores = {
                1: '#FF6B6B', // Rojo para Zona 1
                2: '#4ECDC4', // Turquesa para Cayalá
                3: '#45B7D1', // Azul para San Cristóbal
                4: '#96CEB4'  // Verde para Petapa
            };
            return colores[rutaId] || '#666666';
        }

        // Calcular posición en ruta real
        function calcularPosicionEnRutaReal(busId) {
            const rutaInfo = rutasCalculadas[busId];
            if (!rutaInfo || !rutaInfo.coordinates) {
                return busesData.find(b => b.idBus === busId) || { lat: 0, lng: 0 };
            }

            const tiempoTranscurrido = Date.now() - rutaInfo.startTime;
            const velocidadPromedio = 30; // km/h
            const distanciaRecorrida = (velocidadPromedio * 1000 / 3600) * (tiempoTranscurrido / 1000); // metros

            // Calcular índice en la ruta basado en la distancia
            let distanciaAcumulada = 0;
            let indiceActual = 0;

            for (let i = 1; i < rutaInfo.coordinates.length; i++) {
                const punto1 = rutaInfo.coordinates[i - 1];
                const punto2 = rutaInfo.coordinates[i];
                const distSegmento = calcularDistancia(punto1.lat, punto1.lng, punto2.lat, punto2.lng);

                if (distanciaAcumulada + distSegmento > distanciaRecorrida) {
                    // Interpolar entre estos dos puntos
                    const progreso = (distanciaRecorrida - distanciaAcumulada) / distSegmento;
                    return {
                        lat: punto1.lat + (punto2.lat - punto1.lat) * progreso,
                        lng: punto1.lng + (punto2.lng - punto1.lng) * progreso
                    };
                }

                distanciaAcumulada += distSegmento;
                indiceActual = i;
            }

            // Si llegó al final, retornar el destino
            return {
                lat: COLEGIO_COORDS[0],
                lng: COLEGIO_COORDS[1]
            };
        }

        // Calcular distancia entre dos puntos geográficos
        function calcularDistancia(lat1, lon1, lat2, lon2) {
            const R = 6371e3; // Radio de la Tierra en metros
            const φ1 = lat1 * Math.PI / 180;
            const φ2 = lat2 * Math.PI / 180;
            const Δφ = (lat2 - lat1) * Math.PI / 180;
            const Δλ = (lon2 - lon1) * Math.PI / 180;

            const a = Math.sin(Δφ / 2) * Math.sin(Δφ / 2) +
                      Math.cos(φ1) * Math.cos(φ2) *
                      Math.sin(Δλ / 2) * Math.sin(Δλ / 2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));

            return R * c;
        }

        // Limpiar rutas calculadas
        function limpiarRutasCalculadas() {
            // Remover controles de ruta del mapa
            Object.values(routeControls).forEach(control => {
                if (mapaRealTime.hasLayer(control)) {
                    mapaRealTime.removeControl(control);
                }
            });

            routeControls = {};
            rutasCalculadas = {};
            console.log('Rutas calculadas limpiadas');
        }

        // Actualizar marcadores en el mapa
        function actualizarMarcadores() {
            busesData.forEach(bus => {
                const marcadorId = `bus_${bus.idBus}`;
                const icono = crearIconoBus(bus.estado);

                if (marcadores[marcadorId]) {
                    // Actualizar marcador existente con animación suave
                    marcadores[marcadorId].setLatLng([bus.latitud, bus.longitud]);
                    marcadores[marcadorId].setIcon(icono);
                } else {
                    // Crear nuevo marcador
                    const marcador = L.marker([bus.latitud, bus.longitud], { icon: icono })
                        .addTo(mapaRealTime)
                        .bindPopup(crearPopupBus(bus));

                    marcadores[marcadorId] = marcador;
                }

                // Actualizar popup
                marcadores[marcadorId].setPopupContent(crearPopupBus(bus));
            });
        }

        // Crear icono personalizado para el bus
        function crearIconoBus(estado) {
            let color = '#28a745'; // Verde por defecto
            let icono = '🚌';

            switch(estado) {
                case 'Movimiento':
                    color = '#28a745';
                    icono = '🚌';
                    break;
                case 'Detenido':
                    color = '#ffc107';
                    icono = '🚏';
                    break;
                case 'SinSeñal':
                    color = '#dc3545';
                    icono = '📡';
                    break;
            }

            return L.divIcon({
                className: 'custom-bus-marker',
                html: `<div class="bus-icon" style="background-color: ${color}">${icono}</div>`,
                iconSize: [40, 40],
                iconAnchor: [20, 20],
                popupAnchor: [0, -20]
            });
        }

        // Crear contenido del popup
        function crearPopupBus(bus) {
            const porcentajeOcupacion = Math.round((bus.estudiantesAbordo / bus.capacidadTotal) * 100);

            return `
                <div style="min-width: 200px;">
                    <h6 class="mb-2"><strong>🚌 ${bus.placa}</strong></h6>
                    <div class="mb-1"><strong>Ruta:</strong> ${bus.rutaNombre}</div>
                    <div class="mb-1"><strong>Estado:</strong> <span class="badge bg-${getEstadoClass(bus.estado)}">${bus.estado}</span></div>
                    <div class="mb-1"><strong>Velocidad:</strong> ${bus.velocidad} km/h</div>
                    <div class="mb-1"><strong>Estudiantes:</strong> ${bus.estudiantesAbordo}/${bus.capacidadTotal} (${porcentajeOcupacion}%)</div>
                    <div class="mb-1"><strong>Ubicación:</strong> ${bus.latitud.toFixed(4)}, ${bus.longitud.toFixed(4)}</div>
                    <div class="text-muted"><small>🕒 ${new Date(bus.ultimaActualizacion).toLocaleString()}</small></div>
                </div>
            `;
        }

        // Cargar lista de buses en el panel
        function cargarListaBuses() {
            const busesContainer = document.getElementById('busesInfo');

            if (!busesData || busesData.length === 0) {
                busesContainer.innerHTML = `
                    <div class="p-3 text-center">
                        <i class="bi bi-exclamation-circle text-warning fs-1 mb-3"></i>
                        <p class="text-muted">No hay buses disponibles</p>
                    </div>
                `;
                return;
            }

            let html = '';

            busesData.forEach(bus => {
                const estadoClass = getEstadoClass(bus.estado);
                const tiempoActualizacion = calcularTiempoTranscurrido(new Date(bus.ultimaActualizacion));
                const porcentajeOcupacion = Math.round((bus.estudiantesAbordo / bus.capacidadTotal) * 100);

                html += `
                    <div class="bus-item ${busSeleccionado === bus.idBus ? 'active' : ''}" 
                         onclick="seleccionarBus(${bus.idBus})"
                         data-bus-id="${bus.idBus}">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center mb-2">
                                    <span class="bus-status ${estadoClass} me-2"></span>
                                    <strong class="text-primary">${bus.placa}</strong>
                                    <small class="ms-2 badge bg-secondary">${bus.velocidad} km/h</small>
                                </div>
                                <div class="mb-1">
                                    <small class="text-muted">
                                        <i class="bi bi-geo-alt me-1"></i>
                                        ${bus.rutaNombre}
                                    </small>
                                </div>
                                <div class="mb-1">
                                    <small class="text-muted">
                                        <i class="bi bi-people me-1"></i>
                                        ${bus.estudiantesAbordo}/${bus.capacidadTotal} estudiantes (${porcentajeOcupacion}%)
                                    </small>
                                </div>
                                <div>
                                    <small class="text-muted">
                                        <i class="bi bi-clock me-1"></i>
                                        Act. ${tiempoActualizacion}
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });

            busesContainer.innerHTML = html;
        }

        // Actualizar estadísticas
        function actualizarEstadisticas() {
            const totalBuses = busesData.length;
            const busesActivos = busesData.filter(b => b.estado === 'Movimiento').length;
            const velocidadPromedio = busesData.reduce((sum, bus) => sum + bus.velocidad, 0) / totalBuses;
            const estudiantesTotales = busesData.reduce((sum, bus) => sum + bus.estudiantesAbordo, 0);

            document.getElementById('busesActivos').textContent = totalBuses;
            document.getElementById('busesEnRuta').textContent = busesActivos;

            // Actualizar estadísticas adicionales si existen los elementos
            const velPromElement = document.getElementById('velocidadPromedio');
            if (velPromElement) {
                velPromElement.textContent = Math.round(velocidadPromedio);
            }

            const estudiantesElement = document.getElementById('estudiantesTotales');
            if (estudiantesElement) {
                estudiantesElement.textContent = estudiantesTotales;
            }

            // Actualizar timestamp
            const now = new Date();
            const lastUpdateElement = document.getElementById('lastUpdate');
            if (lastUpdateElement) {
                lastUpdateElement.textContent = now.toLocaleTimeString('es-ES', { hour12: false });
            }
        }

        // Seleccionar bus específico
        function seleccionarBus(busId) {
            busSeleccionado = busId;
            const bus = busesData.find(b => b.idBus === busId);

            if (bus) {
                // Centrar mapa en el bus
                mapaRealTime.setView([bus.latitud, bus.longitud], 16);

                // Abrir popup
                if (marcadores[`bus_${busId}`]) {
                    marcadores[`bus_${busId}`].openPopup();
                }

                // Actualizar lista visual
                cargarListaBuses();

                console.log(`Bus ${bus.placa} seleccionado`);
            }
        }

        // Funciones auxiliares
        function getEstadoClass(estado) {
            switch(estado) {
                case 'Movimiento': return 'success';
                case 'Detenido': return 'warning';
                case 'SinSeñal': return 'danger';
                default: return 'secondary';
            }
        }

        function calcularTiempoTranscurrido(fecha) {
            const ahora = new Date();
            const diferencia = Math.floor((ahora - fecha) / 1000);

            if (diferencia < 60) return 'hace ' + diferencia + 's';
            if (diferencia < 3600) return 'hace ' + Math.floor(diferencia / 60) + 'm';
            return 'hace ' + Math.floor(diferencia / 3600) + 'h';
        }

        function verTodosBuses() {
            if (configMapa.modoEnfocado) {
                const bus = busesData[0];
                ajustarVistaBusEnfocada(configMapa.paradas || [], bus?.latitud, bus?.longitud);
                busSeleccionado = configMapa.idBus;
                cargarListaBuses();
                return;
            }

            if (busesData.length > 0) {
                const bounds = busesData.map(bus => [bus.latitud, bus.longitud]);
                mapaRealTime.fitBounds(bounds, { padding: [20, 20] });
            }
            busSeleccionado = null;
            cargarListaBuses();
        }

        function seguirBuses() {
            seguimientoActivo = !seguimientoActivo;
            const btn = event.target.closest('button');

            if (seguimientoActivo) {
                btn.innerHTML = '<i class="bi bi-camera-video-off me-1"></i>Detener';
                btn.classList.remove('btn-outline-success');
                btn.classList.add('btn-success');
            } else {
                btn.innerHTML = '<i class="bi bi-camera-video me-1"></i>Seguimiento';
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-success');
            }

            console.log('Seguimiento automático:', seguimientoActivo ? 'activado' : 'desactivado');
        }

        function alternarVista() {
            vistaSatelite = !vistaSatelite;

            // Remover todas las capas
            mapaRealTime.eachLayer(function(layer) {
                if (layer instanceof L.TileLayer) {
                    mapaRealTime.removeLayer(layer);
                }
            });

            if (vistaSatelite) {
                L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                    attribution: 'Tiles © Esri'
                }).addTo(mapaRealTime);
            } else {
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© OpenStreetMap contributors'
                }).addTo(mapaRealTime);
            }
        }

        // Limpiar al salir de la página
        window.addEventListener('beforeunload', function() {
            if (actualizacionInterval) {
                clearInterval(actualizacionInterval);
            }
            limpiarRutasCalculadas();
        });
    </script>
}