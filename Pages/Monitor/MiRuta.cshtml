                .filter(esAlumnoPrioritarioDemo)
                .map(p => p.idAlumno)
                .filter(id => id != null);
            // Aplicar reglas Mañana/Tarde y puntos fijos Diego/Sofía desde el inicio
            datosSimulacionPiloto.paradas = reordenarParadasPorTurno(
                clonarParadas(paradasOriginalesBD), 'orden_aleatorio'
            );
            console.log('[Monitor] Simulación inicializada desde BD:', datosSimulacionPiloto.paradas.length, 'paradas',
                '| turno:', datosSimulacionPiloto.tipoRuta,
                '| prioritarios:', idsAlumnosDemoPrioritarios);
