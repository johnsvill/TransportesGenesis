        function initDatosSimulacionFromRutaData() {
            const paradas = getParadas(rutaData);
            if (!paradas || !paradas.length) return;

            datosSimulacionPiloto.paradas = paradas.map(p => {
                const nom = (p.nombreAlumno ?? p.NombreAlumno ?? p.direccion ?? p.Direccion ?? '').toLowerCase();
                const idAl = p.idAlumno ?? p.IdAlumno ?? null;
                return {
                    nombre: p.nombreAlumno ?? p.NombreAlumno ?? p.direccion ?? p.Direccion ?? `Parada ${p.orden ?? p.Orden}`,
                    coordenadas: [parseFloat(p.latitud ?? p.Latitud), parseFloat(p.longitud ?? p.Longitud)],
                    orden: p.orden ?? p.Orden,
                    idParada: p.idParada ?? p.IdParada ?? null,
                    idAlumno: idAl,
                    esColegio: idAl == null && (nom.includes('colegio') || nom.includes('yulimay'))
                };
            });
            datosSimulacionPiloto.idRuta = rutaData.idRuta ?? rutaData.IdRuta ?? datosSimulacionPiloto.idRuta;
            datosSimulacionPiloto.tipoRuta = rutaData.tipoRuta ?? rutaData.TipoRuta ?? datosSimulacionPiloto.tipoRuta;
            datosSimulacionPiloto.ruta = rutaData.nombre ?? rutaData.Nombre ?? datosSimulacionPiloto.ruta;
