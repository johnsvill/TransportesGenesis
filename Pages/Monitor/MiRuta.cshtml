        // Publicar ruta demo al padre vía SignalR (orden aleatorio / turno)
        async function broadcastRutaDemoAlPadre() {
            const idBus = @(Model.IdBus.HasValue ? Model.IdBus.Value.ToString() : "null");
            if (idBus === null || !window.monitorNot?.estaConectado) {
                console.warn('[Monitor] SignalR no listo para broadcast de ruta');
                return false;
            }
            const paradas = datosSimulacionPiloto.paradas.map(p => ({
                nombre: p.nombre,
                lat: p.coordenadas[0],
                lng: p.coordenadas[1],
                orden: p.orden,
                idParada: p.idParada ?? null,
                idAlumno: p.idAlumno ?? null,
                esColegio: p.esColegio === true || (p.nombre && p.nombre.toLowerCase().includes('colegio'))
            }));
            const tipoRuta = datosSimulacionPiloto.tipoRuta || '@Model.TipoRuta';
            const paradasJson = JSON.stringify(paradas);
            const descripcion = datosSimulacionPiloto.ruta || '';

            try {
                if (typeof window.monitorNot.notificarRutaDemoActualizada === 'function') {
                    return await window.monitorNot.notificarRutaDemoActualizada(
                        parseInt(idBus), tipoRuta, paradasJson, modoRutaAleatoriaActiva, descripcion
                    );
                }
                // Fallback si el navegador tiene signalr-client.js en caché (versión anterior)
                await window.monitorNot.connection.invoke(
                    'NotificarRutaDemoActualizada',
                    parseInt(idBus), tipoRuta, paradasJson, modoRutaAleatoriaActiva, descripcion
                );
                console.log(`🗺️ [Monitor] Ruta demo enviada (invoke directo) al Bus_${idBus}`);
                return true;
            } catch (e) {
                console.error('[Monitor] Error broadcast ruta demo:', e);
                return false;
            }
        }

        // [EN VIVO] Enviar ubicación al padre vía API → SignalR (+ cola offline)
        function actualizarBadgeColaOffline(n) {
            const badge = document.getElementById('badgeColaOffline');
            const texto = document.getElementById('textoColaOffline');
            if (!badge || !texto) return;
            if (window.UbicacionOfflineQueue?.isFlushing?.()) {
                badge.classList.remove('d-none');
                badge.className = 'badge bg-info text-dark';
                texto.innerHTML = 'Sincronizando…';
                return;
            }
            if (n > 0 || !navigator.onLine) {
                badge.classList.remove('d-none');
                badge.className = 'badge bg-warning text-dark';
                texto.innerHTML = !navigator.onLine
                    ? `Sin conexión – cola (${n})`
                    : `Puntos en cola (${n})`;
            } else {
                badge.classList.add('d-none');
            }
        }

        if (window.UbicacionOfflineQueue) {
            window.UbicacionOfflineQueue.onChange(actualizarBadgeColaOffline);
            actualizarBadgeColaOffline(window.UbicacionOfflineQueue.size());
            window.addEventListener('online', () => {
                actualizarBadgeColaOffline(window.UbicacionOfflineQueue.size());
                window.UbicacionOfflineQueue.flush();
            });
            window.addEventListener('offline', () => actualizarBadgeColaOffline(window.UbicacionOfflineQueue.size()));
        }

        function reportarUbicacionBus(lat, lng) {
            const idBus = @(Model.IdBus.HasValue ? Model.IdBus.Value.ToString() : "null");
            if (idBus === null) return;

            const point = { idBus: parseInt(idBus), latitud: lat, longitud: lng, velocidad: 10.0, direccion: 0 };
            if (window.UbicacionOfflineQueue) {
                window.UbicacionOfflineQueue.enviarUbicacion(point, {
                    onHubFallback: (p) => {
                        try {
                            if (window.monitorNot?.reportarUbicacionBus)
                                window.monitorNot.reportarUbicacionBus(p.idBus, p.latitud, p.longitud);
                        } catch (e) { console.warn('[Monitor] Fallback hub falló:', e); }
                    }
                });
                return;
            }

            fetch('/api/ubicaciones', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(point)
            }).then(r => {
                if (!r.ok) throw new Error('API ' + r.status);
            }).catch(() => {
                try {
                    if (window.monitorNot?.reportarUbicacionBus)
                        window.monitorNot.reportarUbicacionBus(parseInt(idBus), lat, lng);
                } catch (e) { console.warn('[Monitor] Fallback hub falló:', e); }
            });
        }

        // Generar ruta completa usando servicio de routing real (OSRM)
        async function generarRutaCompleta() {
            rutaSimulacionPiloto = [];

            console.log('Generando ruta completa con routing real...');

            // Procesar cada segmento entre paradas
            for (let i = 0; i < datosSimulacionPiloto.paradas.length - 1; i++) {
                const inicio = datosSimulacionPiloto.paradas[i];
                const fin = datosSimulacionPiloto.paradas[i + 1];

                // Agregar punto de parada inicial
                rutaSimulacionPiloto.push({
                    coordenadas: inicio.coordenadas,
                    esParada: true,
                    nombreParada: inicio.nombre,
                    orden: inicio.orden,
                    idParada: inicio.idParada ?? null
                });

                // Obtener ruta real usando OSRM
                try {
                    const rutaReal = await obtenerRutaReal(inicio.coordenadas, fin.coordenadas);

                    // Agregar puntos de la ruta real
                    rutaReal.forEach(punto => {
                        rutaSimulacionPiloto.push({
                            coordenadas: punto,
                            esParada: false
                        });
                    });
                } catch (error) {
                    console.warn('Error obteniendo ruta real, usando interpolación:', error);
                    // Fallback: usar interpolación mejorada si falla el servicio
                    const puntosIntermedios = generarRutaRealista(inicio.coordenadas, fin.coordenadas, 8);
                    puntosIntermedios.forEach(punto => {
                        rutaSimulacionPiloto.push({
                            coordenadas: punto,
                            esParada: false
                        });
                    });
                }
            }

            // Agregar última parada
            const ultimaParada = datosSimulacionPiloto.paradas[datosSimulacionPiloto.paradas.length - 1];
            rutaSimulacionPiloto.push({
                coordenadas: ultimaParada.coordenadas,
                esParada: true,
                nombreParada: ultimaParada.nombre,
                orden: ultimaParada.orden,
                idParada: ultimaParada.idParada ?? null
            });

            console.log(`Ruta generada con ${rutaSimulacionPiloto.length} puntos siguiendo calles reales`);
        }

        // Obtener ruta real usando servicio OSRM
        async function obtenerRutaReal(inicio, fin) {
            // Formato de coordenadas para OSRM: lng,lat (invertido)
            const url = `https://router.project-osrm.org/route/v1/driving/${inicio[1]},${inicio[0]};${fin[1]},${fin[0]}?overview=full&geometries=geojson&steps=true`;

            const response = await fetch(url);
            const data = await response.json();

            if (data.code !== 'Ok' || !data.routes || data.routes.length === 0) {
                throw new Error('No se pudo obtener la ruta');
            }

            // Extraer coordenadas de la geometría (viene como [lng, lat], necesitamos [lat, lng])
            const coordenadas = data.routes[0].geometry.coordinates.map(coord => [coord[1], coord[0]]);

            // Simplificar la ruta para tener puntos manejables (cada 3 puntos)
            const puntosSimplificados = [];
            for (let i = 0; i < coordenadas.length; i += 3) {
                puntosSimplificados.push(coordenadas[i]);
            }

            // Asegurar que el último punto esté incluido
            if (puntosSimplificados[puntosSimplificados.length - 1] !== coordenadas[coordenadas.length - 1]) {
                puntosSimplificados.push(coordenadas[coordenadas.length - 1]);
            }

            return puntosSimplificados;
        }

        // Generar ruta realista que simula seguir calles
        function generarRutaRealista(inicio, fin, numPuntos) {
            const puntos = [];
            const latDiff = fin[0] - inicio[0];
            const lngDiff = fin[1] - inicio[1];

            // Determinar si el movimiento es más horizontal o vertical
            const esHorizontal = Math.abs(lngDiff) > Math.abs(latDiff);

            // Calcular puntos intermedios con patrón de calle
            for (let i = 1; i <= numPuntos; i++) {
                const ratio = i / (numPuntos + 1);

                // Interpolación base
                let lat = inicio[0] + (latDiff * ratio);
                let lng = inicio[1] + (lngDiff * ratio);

                // Añadir variación para simular seguir calles en lugar de línea recta
                // Patrón de "escalera" suave
                if (esHorizontal) {
                    // Movimiento principalmente horizontal
                    // Ajustar latitud en escalones suaves
                    const escalon = Math.floor(ratio * 3) / 3; // Divide en 3 tramos
                    lat = inicio[0] + (latDiff * escalon);

                    // Pequeña variación para suavizar
                    lat += (Math.sin(ratio * Math.PI * 2) * Math.abs(latDiff) * 0.05);
                } else {
                    // Movimiento principalmente vertical
                    // Ajustar longitud en escalones suaves
                    const escalon = Math.floor(ratio * 3) / 3;
                    lng = inicio[1] + (lngDiff * escalon);

                    // Pequeña variación para suavizar
                    lng += (Math.sin(ratio * Math.PI * 2) * Math.abs(lngDiff) * 0.05);
                }

                puntos.push([lat, lng]);
            }

            return puntos;
        }

        // Interpolar puntos entre dos coordenadas (versión mejorada con curva suave)
        function interpolarPuntos(inicio, fin, numPuntos) {
            const puntos = [];
            const latDiff = fin[0] - inicio[0];
            const lngDiff = fin[1] - inicio[1];

            for (let i = 1; i <= numPuntos; i++) {
                const ratio = i / (numPuntos + 1);

                // Usar interpolación suave (ease-in-out)
                const smoothRatio = ratio < 0.5 
                    ? 2 * ratio * ratio 
                    : 1 - Math.pow(-2 * ratio + 2, 2) / 2;

                const lat = inicio[0] + (latDiff * smoothRatio);
                const lng = inicio[1] + (lngDiff * smoothRatio);

                puntos.push([lat, lng]);
            }
            return puntos;
        }

        // Inicializar mapa SIEMPRE
        function inicializarMapa() {
            console.log('Inicializando mapa...');

            // Guatemala City como centro por defecto
            const centroDefecto = [14.6349, -90.5069];

            // Crear mapa centrado en Guatemala City
            mapa = L.map('mapa').setView(centroDefecto, 12);

            // Agregar capa de OpenStreetMap
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors'
            }).addTo(mapa);

            // SIEMPRE intentar obtener ubicación del usuario
