                { nombre: "Terminal Central, 3ra Av., Zona 4", coordenadas: [14.6336, -90.5190], orden: 3, idParada: null, idAlumno: null },
                { nombre: "Mercado El Guarda, Zona 4",         coordenadas: [14.6314, -90.5165], orden: 4, idParada: null, idAlumno: null },
                { nombre: "Av. Bolívar y 8va Calle, Zona 4",   coordenadas: [14.6292, -90.5145], orden: 5, idParada: null, idAlumno: null },
