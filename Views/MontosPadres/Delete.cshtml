@model TransportesGenesis.Models.DB.Negocio.MontoPadre

@{
    ViewData["Title"] = "Eliminar Monto";
}

<div class="container mt-5">
    <h2 class="mb-4 text-center">Eliminar Monto</h2>

    <div class="alert alert-warning">
        ¿Está seguro que desea eliminar el monto asignado a <strong>@ViewBag.Correo</strong>?
    </div>

    <form asp-action="DeleteConfirmed" method="post" class="mt-3">
        <input type="hidden" asp-for="IdMontoPadre" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
