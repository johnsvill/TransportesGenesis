<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Transportes Génesis</title>
    <!-- Font Awesome para íconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- CSS personalizado -->
    <link rel="stylesheet" href="~/css/site.css" />    
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />

</head>
<body>
    <!-- Header -->
    <header class="bg-warning text-dark p-3">
        <div class="container">
            <h1 class="h3">🚍 Transportes Génesis</h1>
        </div>
    </header>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand text-warning" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-house"></i> Inicio
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menuNav">
                <ul class="navbar-nav me-auto">
                    @if (User.IsInRole("Administrador"))
                    {
                        <li class="nav-item">
                            <a class="nav-link nav-hover-icon" asp-page="/Admin/Usuarios/Index">
                                <i class="fa-solid fa-user"></i> Usuarios
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-hover-icon" asp-controller="Pagos" asp-action="Index">
                                <i class="fa-solid fa-credit-card"></i> Pagos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-hover-icon" asp-controller="Rutas" asp-action="Index">
                                <i class="fa-solid fa-map"></i> Rutas
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("PadreDeFamilia"))
                    {
                        <li class="nav-item">
                            <a class="nav-link nav-hover-icon" asp-controller="PagosPadresFamilia" asp-action="Index">
                                <i class="fa-solid fa-credit-card"></i> Pagos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-hover-icon" href="/Padres/DashboardRutaBusAsignado">
                                <i class="fa-solid fa-route"></i> Ruta del Bus
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-hover-icon" href="/Padres/ConfirmarAsistencia">
                                <i class="fa-solid fa-calendar-check"></i> Calendario
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Piloto"))
                    {
                        <li class="nav-item">
                            <a class="nav-link nav-hover-icon" asp-controller="Rutas" asp-action="Asignadas">
                                <i class="fa-solid fa-road"></i> Rutas asignadas
                            </a>
                        </li>
                    }
                </ul>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>

    <!-- Contenido principal -->
    <main role="main" class="container mt-4">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-light text-center p-3 mt-4">
        <p class="text-muted">© 2026 Transportes Génesis - Sistema de Transporte Escolar</p>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
