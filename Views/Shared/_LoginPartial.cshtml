@using Microsoft.AspNetCore.Identity
@using TransportesGenesis.Models.DB.Usuarios
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var roles = await UserManager.GetRolesAsync(currentUser);

    <ul class="navbar-nav">
        @if (roles.Contains("Administrador"))
        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Admin" asp-action="GestionUsuarios">Gestión de Usuarios</a>
            </li>
        }
        else if (roles.Contains("Piloto"))
        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Admin" asp-action="Index">
                    Gestión de Usuarios
                </a>
            </li>
        }
        else if (roles.Contains("Monitor"))
        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Monitoreo" asp-action="Index">Monitoreo</a>
            </li>
        }
        else if (roles.Contains("PadreDeFamilia"))
        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Pagos" asp-action="Index">Pagos</a>
            </li>
        }
        @if (SignInManager.IsSignedIn(User))
        {
            <ul class="navbar-nav">
                <li class="nav-item">
                    <span class="nav-link fw-bold text-dark bg-light rounded px-2">
                        Bienvenido, @User.Identity.Name
                    </span>
                </li>
                <li class="nav-item">
                    <form asp-area="Identity" asp-page="/Account/Logout" method="post" id="logoutForm">
                        <button type="submit" class="btn btn-link nav-link text-light">Cerrar sesión</button>
                    </form>
                </li>
            </ul>
        }


    </ul>
}
else
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Iniciar sesión</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Registrarse</a>
        </li>
    </ul>
}
