@using Microsoft.AspNetCore.Identity
@using TransportesGenesis.Models.DB.Usuarios
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var roles = await UserManager.GetRolesAsync(currentUser);

    <ul class="navbar-nav">
        <!-- Panel específico por rol -->
        @if (roles.Contains("Administrador"))
        {
            <li class="nav-item">
                <a class="nav-link text-white" asp-controller="Admin" asp-action="Index">
                    <i class="fa-solid fa-cog"></i> Panel Admin
                </a>
            </li>
        }
        else if (roles.Contains("PadreDeFamilia"))
        {
            <li class="nav-item">
                <a class="nav-link text-white" asp-controller="PagosPadresFamilia" asp-action="Index">
                    <i class="fa-solid fa-home"></i> Panel Padre
                </a>
            </li>
        }

        <!-- Información del usuario -->
        <li class="nav-item">
            <span class="nav-link fw-bold text-white">
                <i class="fa-solid fa-user"></i> @User.Identity.Name
            </span>
        </li>

        <!-- Botón de logout -->
        <li class="nav-item">
            <a class="nav-link text-white" href="/Auth/Logout">
                <i class="fa-solid fa-sign-out-alt"></i> Cerrar Sesión
            </a>
        </li>
    </ul>
}
else
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link text-white" asp-controller="Auth" asp-action="Login">
                <i class="fa-solid fa-sign-in-alt"></i> Iniciar Sesión
            </a>
        </li>
    </ul>
}
