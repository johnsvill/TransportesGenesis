@* Views/PagosPadresFamilia/Index.cshtml *@
@{
    ViewData["Title"] = "Panel de Pagos";
}

<div class="container text-center mt-5">
    <h2 class="mb-4">Bienvenido, @User.Identity.Name</h2>
    <div class="row justify-content-center">
        <div class="col-md-4 mb-3">
            <a asp-action="Pagos" class="btn btn-primary btn-lg w-100 p-4 shadow">
                <i class="fa-solid fa-credit-card fa-2x mb-2"></i><br />
                Pagos
            </a>
        </div>
        <div class="col-md-4 mb-3">
            <a asp-action="Historial" class="btn btn-secondary btn-lg w-100 p-4 shadow">
                <i class="fa-solid fa-list fa-2x mb-2"></i><br />
                Historial de Pagos
            </a>
        </div>
        <div class="col-md-4 mb-3">
            <a href="/Padres/DashboardRutaBusAsignado" class="btn btn-info btn-lg w-100 p-4 shadow">
                <i class="fa-solid fa-route fa-2x mb-2"></i><br />
                Ruta del Bus
            </a>
        </div>
    </div>

    <!-- Segunda fila con funcionalidades adicionales -->
    <div class="row justify-content-center mt-3">
        <div class="col-md-4 mb-3">
            <a href="/Padres/ConfirmarAsistencia" class="btn btn-success btn-lg w-100 p-4 shadow">
                <i class="fa-solid fa-calendar-check fa-2x mb-2"></i><br />
                Calendario de Asistencia
            </a>
        </div>
        <div class="col-md-4 mb-3">
            <a href="/Padres/Traslados" class="btn btn-warning btn-lg w-100 p-4 shadow">
                <i class="fa-solid fa-arrow-right-arrow-left fa-2x mb-2"></i><br />
                Mis Traslados
            </a>
        </div>
        <div class="col-md-4 mb-3">
            <a href="/Geolocalizacion/MapaEnTiempoReal" class="btn btn-outline-primary btn-lg w-100 p-4 shadow">
                <i class="fa-solid fa-map-location-dot fa-2x mb-2"></i><br />
                Mapa General
            </a>
        </div>
    </div>
</div>
