@{
    ViewData["Title"] = "Panel de Administrador";
}

<div class="container mt-4">
    <h2 class="text-primary">Panel de Administrador</h2>
    <p class="lead">Bienvenido, @User.Identity.Name</p>

    <div class="row mt-4">
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">📍 Mapa en Tiempo Real</h5>
                    <p class="card-text">Monitoreo en vivo de ubicaciones de buses</p>
                    <a href="/Geolocalizacion/MapaEnTiempoReal" class="btn btn-primary">Ver Mapa en Vivo</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">🚌 Gestión de Rutas</h5>
                    <p class="card-text">Calcular y administrar rutas de transporte</p>
                    <a href="/Admin/CalcularRutas" class="btn btn-primary">Ir a Rutas</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">🔄 Gestión de Traslados</h5>
                    <p class="card-text">Administrar solicitudes de traslado</p>
                    <a href="/Admin/GestionarTraslados" class="btn btn-primary">Ir a Traslados</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card border-success h-100">
                <div class="card-body">
                    <h5 class="card-title">📊 Reporte de Rutas</h5>
                    <p class="card-text">Ver listado completo de rutas registradas</p>
                    <a href="/Admin/ReporteRutas" class="btn btn-success">Ver Reporte</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card border-info h-100">
                <div class="card-body">
                    <h5 class="card-title">👥 Asignaciones Personal</h5>
                    <p class="card-text">Ver asignaciones de pilotos y monitores a buses</p>
                    <a href="/Admin/ReporteAsignaciones" class="btn btn-info">Ver Asignaciones</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card border-warning h-100">
                <div class="card-body">
                    <h5 class="card-title">🗺️ Planificador de Rutas</h5>
                    <p class="card-text">Herramienta de planificación avanzada</p>
                    <a href="/Planner" class="btn btn-warning">Abrir Planner</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">📊 Geolocalización</h5>
                    <p class="card-text">Ver buses y ubicaciones en tiempo real</p>
                    <a href="/Geolocalizacion/BusesIndex" class="btn btn-primary">Ir a Buses</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">👨‍💼 Gestión de Usuarios</h5>
                    <p class="card-text">Administrar usuarios del sistema</p>
                    <a href="/Admin/Usuarios" class="btn btn-success">Gestionar Usuarios</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">🔧 Gestionar Asignaciones</h5>
                    <p class="card-text">Asignar pilotos y monitores a buses</p>
                    <a href="/Admin/GestionarAsignaciones" class="btn btn-primary">Gestionar</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card border-primary h-100">
                <div class="card-body">
                    <h5 class="card-title">📍 Gestionar Paradas</h5>
                    <p class="card-text">Editor interactivo de paradas en el mapa</p>
                    <a href="/Admin/GestionarParadas" class="btn btn-primary">Abrir Editor</a>
                </div>
            </div>
        </div>
    </div>

    <hr class="my-4" />

    <div class="row">
        <div class="col-12">
            <h4 class="text-secondary mb-3">💰 Control Financiero y Mensualidades</h4>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">💵 Asignar Montos</h5>
                    <p class="card-text">Configura el monto que cada padre de familia debe pagar mensualmente.</p>
                    <a asp-controller="MontosPadres" asp-action="Index" class="btn btn-primary">Entrar</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card border-success h-100">
                <div class="card-body">
                    <h5 class="card-title">👥 Gestión de Cuentas y Padres</h5>
                    <p class="card-text">Administra padres de familia, cuentas de acceso y roles del sistema.</p>
                    <a asp-controller="Admin" asp-action="GestionUsuarios" class="btn btn-success">Entrar</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card border-danger h-100">
                <div class="card-body">
                    <h5 class="card-title">💳 Validar Pagos</h5>
                    <p class="card-text">Revisa y valida los pagos realizados por los padres de familia.</p>
                    <a asp-controller="Admin" asp-action="DashboardPagos" class="btn btn-danger">Entrar</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card border-info h-100">
                <div class="card-body">
                    <h5 class="card-title">📅 Calendario de Pagos</h5>
                    <p class="card-text">Visualiza los pagos en un calendario interactivo.</p>
                    <a asp-controller="Admin" asp-action="Calendario" class="btn btn-info">Entrar</a>
                </div>
            </div>
        </div>
    </div>

    <hr class="my-4" />

    <div class="row">
        <div class="col-12">
            <h4 class="text-secondary mb-3">🚨 Acciones Rápidas - Sistema de Alertas</h4>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card border-warning h-100">
                <div class="card-body">
                    <h5 class="card-title">🔔 Alertas de Proximidad</h5>
                    <p class="card-text">Monitorear alertas activas cuando buses se acercan a puntos de recogida</p>
                    <a href="/Admin/AlertasHistorial" class="btn btn-warning">Ver Alertas</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card border-danger h-100">
                <div class="card-body">
                    <h5 class="card-title">⏰ Notificaciones de Retrasos</h5>
                    <p class="card-text">Revisar notificaciones de retrasos y eventos en rutas</p>
                    <a href="/Admin/AlertasHistorial" class="btn btn-danger">Ver Retrasos</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card border-info h-100">
                <div class="card-body">
                    <h5 class="card-title">📋 Historial de Alertas</h5>
                    <p class="card-text">Acceder al historial completo de alertas y su gestión</p>
                    <a href="/Admin/AlertasHistorial" class="btn btn-info">Ver Historial Completo</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-md-4 mb-4">
            <a href="/Auth/Logout" class="btn btn-outline-danger w-100">🚪 Cerrar Sesión</a>
        </div>
    </div>
</div>