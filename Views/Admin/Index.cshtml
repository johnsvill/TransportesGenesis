@{
    ViewData["Title"] = "Dashboard Administrador";
}

<div class="container mt-5">
    <h2 class="mb-4 text-center">Panel de Control - Administrador</h2>

    <div class="row g-4">
        <!-- Tarjeta Asignar Montos -->
        <div class="col-md-3">
            <div class="card shadow-lg border-0 h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <img src="https://cdn-icons-png.flaticon.com/512/3135/3135706.png" alt="Montos" width="64" />
                    </div>
                    <h5 class="card-title fw-bold">Asignar Montos</h5>
                    <p class="card-text text-muted">
                        Configura el monto que cada padre de familia debe pagar mensualmente.
                    </p>
                    <a asp-controller="MontosPadres" asp-action="Index" class="btn btn-primary w-100">
                        Entrar
                    </a>
                </div>
            </div>
        </div>

        <!-- Tarjeta Gestión de Usuarios -->
        <div class="col-md-3">
            <div class="card shadow-lg border-0 h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <img src="https://cdn-icons-png.flaticon.com/512/1077/1077114.png" alt="Usuarios" width="64" />
                    </div>
                    <h5 class="card-title fw-bold">Gestión de Usuarios</h5>
                    <p class="card-text text-muted">
                        Administra padres de familia, cuentas de acceso y roles del sistema.
                    </p>
                    <a asp-controller="Admin" asp-action="GestionUsuarios" class="btn btn-success w-100">
                        Entrar
                    </a>
                </div>
            </div>
        </div>

        <!-- Tarjeta Pagos -->
        <div class="col-md-3">
            <div class="card shadow-lg border-0 h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <img src="https://cdn-icons-png.flaticon.com/512/1170/1170576.png" alt="Pagos" width="64" />
                    </div>
                    <h5 class="card-title fw-bold">Pagos</h5>
                    <p class="card-text text-muted">
                        Revisa y valida los pagos realizados por los padres de familia.
                    </p>
                    <a asp-controller="Admin" asp-action="DashboardPagos" class="btn btn-danger w-100">
                        Entrar
                    </a>
                </div>
            </div>
        </div>

        <!-- Tarjeta Calendario -->
        <div class="col-md-3">
            <div class="card shadow-lg border-0 h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="Calendario" width="64" />
                    </div>
                    <h5 class="card-title fw-bold">Calendario</h5>
                    <p class="card-text text-muted">
                        Visualiza los pagos en un calendario interactivo.
                    </p>
                    <a asp-controller="Admin" asp-action="Calendario" class="btn btn-info w-100">
                        Entrar
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
