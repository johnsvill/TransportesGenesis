@model TransportesGenesis.ViewModels.ChangePasswordViewModel

<h2>Primer acceso - Cambio de contraseña</h2>
<p>Por seguridad, debes cambiar tu contraseña antes de continuar.</p>

<form asp-action="ForceChangePassword" method="post">
    <div class="form-group">
        <label asp-for="NewPassword"></label>
        <input asp-for="NewPassword" type="password" class="form-control" />
        <span asp-validation-for="NewPassword" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" type="password" class="form-control" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Guardar nueva contraseña</button>
</form>
