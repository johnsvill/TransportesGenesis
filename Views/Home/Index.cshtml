@{
    ViewData["Title"] = "Inicio";
}

@if (User.Identity.IsAuthenticated)
{
    if (User.IsInRole("PadreDeFamilia"))
    {
        <div class="container text-center mt-5">
            <h2 class="mb-4">Bienvenido Padre de Familia, @User.Identity.Name</h2>
            <div class="row justify-content-center">
                <div class="col-md-4 mb-3">
                    <a asp-controller="PagosPadresFamilia" asp-action="Pagos"
                       class="btn btn-primary btn-lg w-100 p-4 shadow">
                        <i class="fa-solid fa-credit-card fa-2x mb-2"></i><br />
                        Pagos
                    </a>
                </div>
                <div class="col-md-4 mb-3">
                    <a asp-controller="PagosPadresFamilia" asp-action="Historial"
                       class="btn btn-secondary btn-lg w-100 p-4 shadow">
                        <i class="fa-solid fa-list fa-2x mb-2"></i><br />
                        Historial
                    </a>
                </div>
            </div>
        </div>
    }
    else if (User.IsInRole("Administrador"))
    {
        <div class="container text-center mt-5">
            <h2 class="mb-4">Panel del Administrador</h2>
            <p>Sección en construcción.</p>
        </div>
    }
    else if (User.IsInRole("Piloto"))
    {
        <div class="container text-center mt-5">
            <h2 class="mb-4">Panel del Piloto</h2>
            <p>Sección en construcción.</p>
        </div>
    }
    else if (User.IsInRole("Monitor"))
    {
        <div class="container text-center mt-5">
            <h2 class="mb-4">Panel del Monitor</h2>
            <p>Sección en construcción.</p>
        </div>
    }
}
else
{
    <!-- Vista pública -->
    <div class="container mt-5">
        <div class="jumbotron text-center bg-warning p-5 rounded">
            <h1 class="display-4">🚍 Transportes Génesis</h1>
            <p class="lead">Plataforma digital para mejorar la experiencia escolar.</p>
        </div>

        <!-- Carrusel -->
        <div id="carouselExampleIndicators" class="carousel slide mt-4" data-bs-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="https://sistemasdecontrolescolar.com/wp-content/uploads/2024/07/DALL%C2%B7E-2024-07-15-05.36.41-A-professional-image-depicting-the-importance-of-having-an-easy-to-use-school-management-system-with-a-simple-and-efficient-interface-for-all-users.-I.webp"
                         class="d-block w-100 carousel-img" alt="Imagen 1">
                    <div class="carousel-caption d-none d-md-block">
                        <h5>Gestión escolar moderna</h5>
                        <p>Interfaces simples y eficientes para todos los usuarios.</p>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="https://i.ytimg.com/vi/48ciiX7A8JI/maxresdefault.jpg"
                         class="d-block w-100 carousel-img" alt="Imagen 2">
                    <div class="carousel-caption d-none d-md-block">
                        <h5>Experiencia digital</h5>
                        <p>Plataforma pensada para mejorar la comunicación escolar.</p>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="https://tse4.mm.bing.net/th/id/OIP.tUgXdUJfdCVJDs0nTnzizgHaE8?rs=1&pid=ImgDetMain&o=7&rm=3"
                         class="d-block w-100 carousel-img" alt="Imagen 3">
                    <div class="carousel-caption d-none d-md-block">
                        <h5>Confianza y seguridad</h5>
                        <p>Diseñado para brindar tranquilidad a las familias.</p>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>

        <!-- Tarjetas informativas -->
        <div class="row mt-5 text-center">
            <div class="col-md-4">
                <div class="card shadow">
                    <div class="card-body">
                        <i class="fa-solid fa-lightbulb fa-3x mb-3 text-primary"></i>
                        <h5 class="card-title">Innovación</h5>
                        <p class="card-text">Soluciones digitales adaptadas al entorno escolar.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow">
                    <div class="card-body">
                        <i class="fa-solid fa-handshake fa-3x mb-3 text-success"></i>
                        <h5 class="card-title">Colaboración</h5>
                        <p class="card-text">Un sistema pensado para facilitar la comunicación.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow">
                    <div class="card-body">
                        <i class="fa-solid fa-shield-alt fa-3x mb-3 text-warning"></i>
                        <h5 class="card-title">Seguridad</h5>
                        <p class="card-text">Diseñado con estándares modernos de confianza.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- CSS para uniformar tamaño de imágenes del carrusel -->
<style>
    .carousel-img {
        height: 400px; /* altura fija */
        object-fit: cover; /* recorta manteniendo proporción */
    }
</style>
