@{
    ViewData["Title"] = "Dashboard Monitor";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header" style="background: linear-gradient(135deg, #FFA500 0%, #FF8C00 100%); color: white;">
                    <h4 class="mb-0">
                        <i class="bi bi-clipboard-check-fill"></i> Panel del Monitor
                    </h4>
                    <p class="mb-0 mt-2 text-white-50">
                        @DateTime.Now.ToString("dddd, d 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))
                    </p>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle-fill"></i>
                        <strong>Bienvenido/a, @User.Identity?.Name</strong>
                        <p class="mb-0 mt-2">Desde este panel puedes ver la ruta del día y registrar la asistencia de los niños.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6 mb-3">
            <div class="card h-100 shadow-sm hover-card">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="bi bi-geo-alt-fill text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title">Mi Ruta del Día</h5>
                    <p class="card-text text-muted">
                        Visualiza la ruta asignada, paradas y ubicación en tiempo real del bus.
                    </p>
                    <a href="/Monitor/MiRuta" class="btn btn-primary btn-lg w-100">
                        <i class="bi bi-map me-2"></i>Ver Mi Ruta
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card h-100 shadow-sm hover-card">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="bi bi-person-check-fill text-success" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title">Registrar Asistencia</h5>
                    <p class="card-text text-muted">
                        Marca qué niños subieron al bus y cuáles no en el recorrido de hoy.
                    </p>
                    <a href="/Monitor/ListadoNinos" class="btn btn-success btn-lg w-100">
                        <i class="bi bi-clipboard-check me-2"></i>Registrar Niños
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <i class="bi bi-clock-history"></i> Historial de Asistencia (Últimos 7 días)
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-tools"></i> Funcionalidad en desarrollo. Próximamente podrás consultar el historial completo de asistencias.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-card {
        transition: all 0.3s ease;
    }

    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 16px rgba(255,165,0,0.3) !important;
    }
</style>
